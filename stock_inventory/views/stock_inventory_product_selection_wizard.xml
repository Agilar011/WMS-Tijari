<odoo>
    <record id="view_inventory_product_selection_wizard_form" model="ir.ui.view">
        <field name="name">stock.inventory.product.selection.wizard.form</field>
        <field name="model">stock.inventory.product.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Products">
                <field name="inventory_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="product_selection" invisible="1" />
                <field name="state" invisible="1" />
                <field name="product_id"
                    invisible="product_selection not in ('one', 'lot')"
                    readonly="state != 'draft'"/>
                <field name="product_ids" nolabel="1"
                    invisible="product_selection in ('one', 'lot')"
                    readonly="state != 'draft'">
                    <list>
                        <field name="default_code" string="SKU" />
                        <field name="name" string="Product" />
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" invisible="state != 'draft'" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
