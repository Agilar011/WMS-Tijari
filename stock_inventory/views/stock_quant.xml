<odoo>
    <record id="view_stock_quant_search_not_done" model="ir.ui.view">
        <field name="name">stock.quant.search.not.done</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <filter name="to_apply" position="after">
                <filter name='to_do' string="To Do" domain="[('to_do', '=', 'True')]" />
            </filter>
        </field>
    </record>

    <record id="view_stock_quant_tree_inventory_editable_inherit_inventory" model="ir.ui.view">
            <field name="name">stock.quant.inventory.list.editable.inherit.stock.inventory</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
</odoo>
