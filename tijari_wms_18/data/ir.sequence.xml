<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_lot_manufacture" model="ir.sequence">
        <field name="name">Lot Number - Manufacture</field>
        <field name="code">stock.lot.manufacture</field>
        <field name="prefix">MFG/</field>
        <field name="padding">6</field>
    </record>

    <record id="seq_lot_inventory_adjustment" model="ir.sequence">
        <field name="name">Lot Number - Inventory Adjustment</field>
        <field name="code">stock.lot.inventory.adjustment</field>
        <field name="prefix">ADJ/</field>
        <field name="padding">6</field>
    </record>

    <record id="seq_stock_quant_package_box" model="ir.sequence">
        <field name="name">Stock Package Box</field>
        <field name="code">stock.quant.package.box</field>
        <field name="prefix">BOX</field>
        <field name="padding">7</field>
        <field name="number_increment">1</field>
    </record>


    <record id="seq_stock_quant_package_palet" model="ir.sequence">
        <field name="name">Stock Package Palet</field>
        <field name="code">stock.quant.package.palet</field>
        <field name="prefix">PALET</field>
        <field name="padding">7</field>
        <field name="number_increment">1</field>
    </record>

</odoo>
