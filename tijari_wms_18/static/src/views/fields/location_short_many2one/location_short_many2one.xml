<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t
        t-name="tijari_wms_18.LocationShortMany2OneField"
        t-inherit="web.Many2OneField"
        t-inherit-mode="primary"
    >

        <xpath
            expr="//a[@t-if='value']"
            position="replace"
        >
            <span t-if="value">
                <span
                    class="text-truncate"
                    t-att-class="classFromDecoration"
                    t-esc="displayName"
                />
            </span>
        </xpath>

    </t>

</templates>