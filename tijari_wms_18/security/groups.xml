<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <function model="res.groups" name="_tijari_ensure_operator_group_xmlid"/>

    <!-- Role groups used by the WMS menu matrix. They intentionally imply the
         standard Inventory User group only; menu visibility is assigned below
         without granting Administrator-level model access. -->
    <record id="group_warehouse_manager" model="res.groups">
        <field name="name">Warehouse Manager</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_warehouse_head" model="res.groups">
        <field name="name">Warehouse Head</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_warehouse_admin" model="res.groups">
        <field name="name">Warehouse Admin</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_it_staff" model="res.groups">
        <field name="name">IT Staff</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('base.group_system'))]"/>
    </record>

</odoo>
