<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_job_company_rule" model="ir.rule">
        <field name="name">Picking jobs by allowed company</field>
        <field name="model_id" ref="model_stock_picking_job"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="stock_picking_job_attempt_company_rule" model="ir.rule">
        <field name="name">Picking job attempts by allowed company</field>
        <field name="model_id" ref="model_stock_picking_job_attempt"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="domain_force">[('job_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
