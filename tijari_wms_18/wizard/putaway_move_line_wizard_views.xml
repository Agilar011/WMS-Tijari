<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="putaway_move_line_wizard_view_form" model="ir.ui.view">
        <field name="name">putaway.move.line.wizard.view.form</field>
        <field name="model">putaway.move.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Putaway">
                <group>
                    <field name="picking_type_name" invisible="1"/>
                    <field name="move_line_id" invisible="1"/>
                    <field name="adt_dest_location_id" invisible="1"/>
                    <field name="allowed_matching_lot_ids" invisible="1"/>
                    <field name="putaway_status" invisible="1"/>
                    <field name="picking_state" invisible="1"/>
                    <field name="batch_id" invisible="1"/>
                    <field name="product_id"/>
                    <field name="batch_origin" string="No. Dokumen" readonly="1" invisible="not batch_id"/>
                    <field name="lot_id"/>
                    <field
                        name="handheld_location_code"
                        string="Scan Handheld"
                        invisible="picking_type_name in ['Storage', 'Store Finished Product']"
                        readonly="picking_state == 'done'"
                    />
                    <field name="handheld_scan_code"
                        widget="adt_handheld_scan_code"
                        string="Scan Handheld"
                        invisible="picking_type_name not in ['Storage', 'Store Finished Product']"
                        readonly="picking_state == 'done'"/>
                    <field name="confirmation_lot_code"
                        invisible="1"/>
                    <field name="matching_lot_id"
                        invisible="picking_type_name not in ['Storage', 'Store Finished Product']"
                        readonly="putaway_status == 'finished' or picking_state == 'done'"/>
                    <field name="matching" widget="badge"
                        decoration-success="matching == 'match'"
                        decoration-danger="matching == 'not_match'"
                        invisible="picking_type_name not in ['Storage', 'Store Finished Product']"/>

                    <field name="original_location_putaway_id" invisible="1"/>
                    <field name="original_confirmation_location_code" invisible="1"/>
                    <field name="location_putaway_id" context="{'show_location_short_name': True}" readonly="putaway_status == 'finished' or picking_state == 'done'" string="Store To"/>
                    <field name="quantity" string="Qty Diterima"
                        invisible="picking_type_name in ['Storage', 'Store Finished Product']"/>
                    <field name="quantity" string="Qty Dipindah"
                        invisible="picking_type_name not in ['Storage', 'Store Finished Product']"/>
                    <field name="remaining_putaway_quantity" readonly="1"/>
                    <field
                        name="confirmation_quantity"
                        string="Qty Disimpan"
                        readonly="putaway_status == 'finished' or picking_state == 'done'"
                    />
                </group>
                <footer>
                    <button
                        name="action_save_and_finish"
                        string="Save &amp; Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="putaway_status == 'finished' or picking_state == 'done'"
                    />
                    <button
                        name="action_rollback"
                        string="Rollback"
                        type="object"
                        class="btn-danger"
                        invisible="putaway_status != 'finished' or picking_state == 'done'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
