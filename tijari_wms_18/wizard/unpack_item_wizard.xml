<odoo>

    <record id="move_unpack_wizard_view_form" model="ir.ui.view">
        <field name="name">move.unpack.wizard.form</field>
        <field name="model">move.unpack.wizard</field>
        <field name="arch" type="xml">

            <form create="false">
                <field name="move_id" invisible='1' />
                <field name="state" invisible='1' />
                <group>
                    <field 
                        name="status_check"
                        widget="badge"
                        decoration-success="status_check == 'finished'"
                        decoration-danger="status_check == 'unfinished'" 
                    />
                    <field name="product_id"
                        context="{'tijari_stock_picking_product_code_only': True}"/>
                    
                    <label for="product_uom_qty"
                        string="Qty Total"/>
                    <div>
                        <field name="product_uom_qty"
                            readonly="state != 'draft'"
                            nolabel="1"/>
                        <field name="product_uom"
                            groups="uom.group_uom"
                            readonly="state != 'draft'"
                            nolabel="1"
                            options="{'no_open': True}"/>
                    </div>

                    <label for="remaining_package_qty"
                        string="Qty Unpack"/>
                    <div>
                        <field name="remaining_package_qty"
                            readonly="1"/>
                        <field name="product_uom"
                            groups="uom.group_uom"
                            readonly="state != 'draft'"
                            nolabel="1"
                            options="{'no_open': True}"/>
                    </div>

                    <label for="so_confirmation_quantity"
                        string="Qty Dikirim"
                        readonly="state in ('done', 'cancel')"/>
                    <div>
                        <field name="so_confirmation_quantity"/>
                        <field name="product_uom"
                            groups="uom.group_uom"
                            readonly="state != 'draft'"
                            nolabel="1"
                            options="{'no_open': True}"/>
                    </div>
                </group>
               
                <!-- Qty Dikirim -->

                <footer>
                    <button name="action_mark_check_finished"
                            string="Confirm &amp; Save"
                            type="object"
                            class="btn-primary"
                            invisible="status_check != 'unfinished' or state in ['done', 'cancel']"/>

                    <button name="action_mark_check_unfinished"
                            string="Rollback"
                            type="object"
                            class="btn-danger"
                            invisible="status_check != 'finished' or state not in ['confirmed', 'assigned']"/>

                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>

        </field>
    </record>

</odoo>