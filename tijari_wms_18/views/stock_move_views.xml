<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_operations_inherit" model="ir.ui.view">
        <field name="name">stock.move.operations.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">


            <xpath expr="//widget[@name='import_lots']" position="before">
                <div>
                    <field name="picking_type_name" invisible="1"/>
                    <!-- <div invisible="picking_type_name != 'Pick' and transaction_type != 'outbound'">
                        <field name="unfiltered_dest" invisible="picking_type_name != 'Pick' and transaction_type != 'outbound'"/>
                        <span style="margin-right: 4px;" invisible="picking_type_name != 'Pick' and transaction_type != 'outbound'">Pengambilan Item berdasarkan lokasi mapping</span>
                    </div> -->
                        <button name="action_validate_lot_pick"
                            type="object"
                            string="Validate Lot"
                            class="btn-warning"
                            invisible="picking_type_name not in ['Pick', 'Pick Internal']"/>
                </div>
            </xpath>
            
            <xpath expr="//widget[@name='import_lots']" position="after">
                <span class="d-inline-flex gap-1">

                    <button name="action_generate_lot"
                        type="object"
                        string="Generate Lot"
                        class="btn-warning"
                        invisible="not display_assign_serial"/>

                    <button name="action_validate_lot"
                        type="object"
                        string="Validate Lot"
                        class="btn-warning"
                        invisible="not display_assign_serial or picking_type_name in ['Receipts', 'Receipt Internal']"/>
                </span>
            </xpath>

            <xpath expr="//form/group/group/label[@for='product_uom_qty']" position="attributes">
                <attribute name="string">Total Qty</attribute>
            </xpath>

            <xpath expr="//form/group/group/div[@class='o_row']/span/field[@name='product_uom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//form/group/group/div[@class='o_row']" position="after">
                <label for="quantity" string="Qty Disimpan"/>
                <div class="o_row">
                    <field name="quantity" readonly="1" nolabel="1"/>
                </div>
            </xpath>

            <xpath expr="//widget[@name='generate_serials']" position="replace">
                <widget class="btn btn-link btn-group" name="generate_serials" invisible="1"/>
            </xpath>                        
            
            <xpath expr="//widget[@name='import_lots']" position="replace">
                <widget class="btn btn-link btn-group" name="import_lots" invisible="1"/>
            </xpath>                        

        </field>
    </record>

    <record id="stock_picking_form_note_button" model="ir.ui.view">
        <field name="name">stock.picking.form.note.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="after">
                <button
                    name="action_open_note_wizard"
                    type="object"
                    icon="fa-sticky-note"
                    title="Note"
                    />

            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='lot_ids']" position="after" invisible="picking_type_name not in ['Receipts', 'Receipt Internal']">
                    <field name="adt_type" column_invisible="1"/>
                    <field name="owner_id" column_invisible="parent.adt_type != 'Toko Pegang DO'"/>
                    <field name="adt_dest_location_id" string="Final Location"/>
                    <field name="difference_quantity" string="Perbedaan Qty" readonly="1" optional="show" column_invisible="parent.state=='draft'" decoration-danger="difference_quantity > 0"/>
                    <button name="action_print_lot_number_line"
                        type="object"
                        icon="fa-print"
                        invisible="picking_type_name not in ['Receipts', 'Receipt Internal']"
                        title="Print Lot"/>
                    <button name="action_open_move_pick"
                        type="object"
                        icon="fa-hand-lizard-o"
                        title="Open Picker"
                        invisible="picking_type_name not in ['Receipts', 'Receipt Internal'] or state == 'draft'"/>
            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_packaging_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Total Qty</attribute>
            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='quantity']" position="replace">
                <field name="quantity" string="Qty Diterima" readonly="not is_quantity_done_editable" column_invisible="parent.state=='draft' or parent.picking_type_name not in ['Receipts', 'Receipt Internal', 'Pick', 'Pick Internal']" decoration-danger="product_uom_qty and quantity > product_uom_qty and parent.state not in ['done', 'cancel']"/>
                <field name="quantity" string="Quantity" readonly="not is_quantity_done_editable" column_invisible="parent.state=='draft' or parent.picking_type_name in ['Receipts', 'Receipt Internal', 'Pick', 'Pick Internal']" decoration-danger="product_uom_qty and quantity > product_uom_qty and parent.state not in ['done', 'cancel']"/>
                <field name="confirmation_quantity" string="Qty Disimpan" readonly="1" optional="show" column_invisible="parent.picking_type_name not in ['Receipts', 'Receipt Internal']"/>
            </xpath>

        </field>
    </record>

    <record id="stock_move_note_form_view" model="ir.ui.view">
        <field name="name">stock.move.note.popup</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form string="Product Note">
                <group>
                    <field name="product_note" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="stock_move_pick_view" model="ir.ui.view">
        <field name="name">stock.move.pick</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form>
                <field name="adt_type" invisible="1"/>
                <field name="owner_id" invisible="1"/>
                <field name="picking_type_name" invisible="1"/>
                <div class="grid-container">
                    <div style="display: flex !important; flex-direction: column !important; gap: 8px; width: 100%;">
                        
                        <div style="display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: top; gap: 5px; width: 100%;">
                            <label for="product_id" style="margin: 0 !important; white-space: nowrap !important;"/>
                            <field name="product_id" readonly="id or move_line_ids"/>
                        </div>

                    </div>

                    <div style="display: flex !important; flex-direction: column !important; gap: 8px; width: 100%;">
                                            
                        <div style="display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: center; gap: 5px; width: 100%;">
                            <label for="product_uom_qty" style="margin: 0 !important; white-space: nowrap !important;"/>
                            <field name="product_uom_qty" readonly="state != 'draft'" nolabel="1"/>
                            <field name="product_uom" groups="uom.group_uom" readonly="state != 'draft'" nolabel="1" options="{'no_open': True}"/>
                        </div>

                    </div>
                </div>
                <field name="move_line_ids"
                    readonly="state == 'cancel' or (state == 'done' and is_locked) or not product_id"
                    context="{
                        'form_view_ref': 'stock.view_move_line_mobile_form',
                        'default_picking_id': picking_id,
                        'default_move_id': id,
                        'default_product_id': product_id,
                        'default_location_id': location_id,
                        'default_location_dest_id': location_dest_id,
                        'default_company_id': company_id,
                        'active_picking_id': picking_id,
                        'copy_previous_picker_location': True
                    }"
                    widget="sml_x2_many"
                    groups="!tijari_wms_18.group_operator">
                    <list editable="bottom">
                        <field name="company_id" column_invisible="1" force_save="1"/>
                        <field name="picking_id" column_invisible="1" force_save="1"/>
                        <field name="move_id" column_invisible="1" force_save="1"/>
                        <field name="location_id" string="Pick From" widget="location_short_many2one" column_invisible="'Pick' not in (parent.picking_type_name or '') and 'Pack' not in (parent.picking_type_name or '')" force_save="1" context="{'show_location_short_name': True}"/>
                        <field name="adt_dest_location_id" column_invisible="1"/>
                        <field name="allowed_matching_lot_ids" column_invisible="1"/>
                        <field name="product_uom_category_id" column_invisible="1"/>
                        <field name="tracking" column_invisible="1"/>
                        <field name="state" column_invisible="1"/>
                        <field name="is_locked" column_invisible="1"/>
                        <field name="temp_quant_ids" column_invisible="1"/>
                        <field name="temp_lot_ids" column_invisible="1"/>
                        <field name="available_lot_ids" column_invisible="1"/>
                        <field name="available_location_ids" column_invisible="1"/>
                        <field name="quant_id" domain="[('id', 'in', temp_quant_ids)]" column_invisible="1"/>
                        <field name="product_id" readonly="1" force_save="1" column_invisible="'Receipt' in (parent.picking_type_name or '') or 'Pick' in (parent.picking_type_name or '') or 'Pack' in (parent.picking_type_name or '')"/>
                        <field name="lot_id" string="Lot/Serial Number" readonly="1" force_save="1" domain="[('id', 'in', available_lot_ids)]" groups="stock.group_production_lot" column_invisible="'Pick' in (parent.picking_type_name or '')"/>
                        <field name="lot_name" readonly="1" force_save="1" optional="hide"/>
                        <field name="matching_lot_id" string="Confirmed Lot" force_save="1" domain="[('id', 'in', allowed_matching_lot_ids)]" column_invisible="'Pick' not in (parent.picking_type_name or '') and 'Pack' not in (parent.picking_type_name or '')"/>
                        <field name="location_dest_id" string="To" widget="location_short_many2one" column_invisible="'Pick' not in (parent.picking_type_name or '') and 'Pack' not in (parent.picking_type_name or '')" force_save="1" context="{'show_location_short_name': True}"/>
                        <field 
                            name="result_package_id" 
                            domain="[('package_cat', '=', 'box'), ('is_empty', '=', True)]" 
                            readonly="1" force_save="1" 
                            string="Packages" 
                            column_invisible="'Pick' in (parent.picking_type_name or '') or 'Pack' in (parent.picking_type_name or '')"/>
                        <field 
                            name="result_package_id" 
                            string="Destination Package"
                            domain="[('package_cat', '=', 'box'), ('is_empty', '=', True)]" 
                            force_save="1" 
                            column_invisible="'Pick' not in (parent.picking_type_name or '') and 'Pack' not in (parent.picking_type_name or '')"/>

                        <field name="quantity" string="Qty In Pack" readonly="picker_status == 'finished'" column_invisible="'Pick' in (parent.picking_type_name or '') or 'Pack' in (parent.picking_type_name or '')"/>
                        <field name="quantity" string="Quantity" column_invisible="'Pick' not in (parent.picking_type_name or '') and 'Pack' not in (parent.picking_type_name or '')"/>
                        <field name="product_uom_id" string="UoM" readonly="picker_status == 'finished'" column_invisible="'Pick' in (parent.picking_type_name or '') or 'Pack' in (parent.picking_type_name or '')"/>
                        <field name="product_uom_id" string="Unit of Measure" column_invisible="'Pick' not in (parent.picking_type_name or '') and 'Pack' not in (parent.picking_type_name or '')"/>
                        <field name="matching_loc_dest_id" string="Confirm Location" force_save="1" domain="[('id', 'child_of', adt_dest_location_id)]" column_invisible="'Pick' not in (parent.picking_type_name or '')"/>
                        <field name="picker_status" string="Status"
                                decoration-success="picker_status == 'finished'"
                                decoration-danger="picker_status == 'unfinished'"
                                widget="badge"
                                column_invisible="'Pick' in (parent.picking_type_name or '') or 'Pack' in (parent.picking_type_name or '')"/>
                        <field name="matching" string="Status"
                                decoration-success="matching == 'match'"
                                decoration-danger="matching == 'not_match'"
                                widget="badge"
                                column_invisible="'Pick' not in (parent.picking_type_name or '')"/>
                        <field name="confirmation_lot_code"
                                widget="adt_scan_lot_button"
                                string="Scan Lot"
                                readonly="1"
                                invisible="matching == 'match'"
                                column_invisible="'Pick' not in (parent.picking_type_name or '')"/>
                        <field name="confirmation_location_code"
                                widget="adt_scan_location_button"
                                string="Scan Location"
                                readonly="1"
                                invisible="matching == 'match'"
                                column_invisible="'Pick' not in (parent.picking_type_name or '')"/>
                        <button name="action_mark_picker_finished"
                                type="object"
                                icon="fa-check"
                                class="btn-success o_wms_auto_save_before_action"
                                title="Finish Picker"
                                invisible="picker_status == 'finished'"
                                column_invisible="'Pick' in (parent.picking_type_name or '') or 'Pack' in (parent.picking_type_name or '')"/>
                        <button name="action_mark_picker_unfinished"
                                type="object"
                                icon="fa-undo"
                                class="btn-danger"
                                title="Undo Picker"
                                invisible="picker_status == 'unfinished'"
                                column_invisible="'Pick' in (parent.picking_type_name or '') or 'Pack' in (parent.picking_type_name or '')"/>
                    </list>
                </field>
                <field name="move_line_ids"
                    readonly="state == 'cancel' or (state == 'done' and is_locked) or not product_id"
                    context="{
                        'form_view_ref': 'stock.view_move_line_mobile_form',
                        'default_picking_id': picking_id,
                        'default_move_id': id,
                        'default_product_id': product_id,
                        'default_location_id': location_id,
                        'default_location_dest_id': location_dest_id,
                        'default_company_id': company_id,
                        'active_picking_id': picking_id,
                        'copy_previous_picker_location': True
                    }"
                    mode="list"
                    groups="tijari_wms_18.group_operator"
                    invisible="'Receipt' not in (picking_type_name or '')">
                    <list editable="bottom" delete="0">
                        <field name="company_id" column_invisible="1" force_save="1"/>
                        <field name="picking_id" column_invisible="1" force_save="1"/>
                        <field name="move_id" column_invisible="1" force_save="1"/>
                        <field name="product_uom_category_id" column_invisible="1"/>
                        <field name="tracking" column_invisible="1"/>
                        <field name="state" column_invisible="1"/>
                        <field name="is_locked" column_invisible="1"/>
                        <field name="picker_status" column_invisible="1"/>

                        <field name="quantity" string="Qty In Pack" readonly="picker_status == 'finished'"/>
                        <field name="product_uom_id" string="UoM" readonly="picker_status == 'finished'"/>
                        <button name="action_mark_picker_finished"
                                type="object"
                                icon="fa-check"
                                class="btn-success o_wms_auto_save_before_action"
                                title="Finish Picker"
                                invisible="picker_status == 'finished'"/>
                        <button name="action_mark_picker_unfinished"
                                type="object"
                                icon="fa-undo"
                                class="btn-danger"
                                title="Undo Picker"
                                invisible="picker_status == 'unfinished'"/>
                    </list>
                </field>
                <field name="move_line_ids"
                    readonly="state == 'cancel' or (state == 'done' and is_locked) or not product_id"
                    context="{
                        'form_view_ref': 'stock.view_move_line_mobile_form',
                        'default_picking_id': picking_id,
                        'default_move_id': id,
                        'default_product_id': product_id,
                        'default_location_id': location_id,
                        'default_location_dest_id': location_dest_id,
                        'default_company_id': company_id,
                        'active_picking_id': picking_id,
                        'copy_previous_picker_location': True
                    }"
                    mode="list"
                    groups="tijari_wms_18.group_operator"
                    invisible="'Pick' not in (picking_type_name or '')">
                    <list editable="bottom" delete="0">
                        <field name="company_id" column_invisible="1" force_save="1"/>
                        <field name="picking_id" column_invisible="1" force_save="1"/>
                        <field name="move_id" column_invisible="1" force_save="1"/>
                        <field name="adt_dest_location_id" column_invisible="1"/>
                        <field name="allowed_matching_lot_ids" column_invisible="1"/>
                        <field name="product_uom_category_id" column_invisible="1"/>
                        <field name="tracking" column_invisible="1"/>
                        <field name="state" column_invisible="1"/>
                        <field name="is_locked" column_invisible="1"/>
                        <field name="temp_quant_ids" column_invisible="1"/>
                        <field name="temp_lot_ids" column_invisible="1"/>
                        <field name="available_lot_ids" column_invisible="1"/>
                        <field name="available_location_ids" column_invisible="1"/>
                        <field name="quant_id" domain="[('id', 'in', temp_quant_ids)]" column_invisible="1"/>
                        <field name="matching" column_invisible="1"/>

                        <field name="lot_id" string="Lot" force_save="1"/>
                        <field name="location_id" string="Pick From" widget="location_short_many2one" force_save="1" context="{'show_location_short_name': True}"/>
                        <field name="quantity" string="Quantity"/>
                        <field name="product_uom_id" string="Unit of Measure"/>
                        <field name="matching_lot_id" string="Confirmed Lot" force_save="1" domain="[('id', 'in', allowed_matching_lot_ids)]"/>
                        <field name="matching_loc_dest_id" string="Confirm Location" force_save="1" domain="[('id', 'child_of', adt_dest_location_id)]"/>
                        <field name="matching" string="Status"
                                decoration-success="matching == 'match'"
                                decoration-danger="matching == 'not_match'"
                                widget="badge"/>
                        <field name="confirmation_lot_code"
                                widget="adt_scan_lot_button"
                                string="Scan Lot"
                                readonly="1"
                                invisible="matching == 'match'"/>
                        <field name="confirmation_location_code"
                                widget="adt_scan_location_button"
                                string="Scan Location"
                                readonly="1"
                                invisible="matching == 'match'"/>
                    </list>
                </field>
                <field name="move_line_ids"
                    readonly="state == 'cancel' or (state == 'done' and is_locked) or not product_id"
                    context="{
                        'form_view_ref': 'stock.view_move_line_mobile_form',
                        'default_picking_id': picking_id,
                        'default_move_id': id,
                        'default_product_id': product_id,
                        'default_location_id': location_id,
                        'default_location_dest_id': location_dest_id,
                        'default_company_id': company_id,
                        'active_picking_id': picking_id,
                        'copy_previous_picker_location': True
                    }"
                    mode="list"
                    groups="tijari_wms_18.group_operator"
                    invisible="'Pack' not in (picking_type_name or '')">
                    <list editable="bottom" delete="0">
                        <field name="company_id" column_invisible="1" force_save="1"/>
                        <field name="picking_id" column_invisible="1" force_save="1"/>
                        <field name="move_id" column_invisible="1" force_save="1"/>
                        <field name="product_uom_category_id" column_invisible="1"/>
                        <field name="tracking" column_invisible="1"/>
                        <field name="state" column_invisible="1"/>
                        <field name="is_locked" column_invisible="1"/>

                        <field name="lot_id" string="Lot/Serial Number" force_save="1"/>
                        <field name="result_package_id" domain="[('package_cat', '=', 'box'), ('is_empty', '=', True)]" string="Destination Package" force_save="1"/>
                        <field name="quantity" string="Quantity"/>
                        <field name="product_uom_id" string="Unit of Measure"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

</odoo>
