<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_dest_domain" model="ir.ui.view">
        <field name="name">stock.move.generate.lot</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="picking_type_name" invisible="1"/>
            </xpath>

            <xpath expr="//widget[@name='import_lots']" position="after">
                <span class="d-inline-flex gap-1" invisible="picking_type_name != 'Receipts'">

                    <button name="action_generate_lot"
                        type="object"
                        string="Generate Lot"
                        class="btn-warning"
                        invisible="not display_assign_serial"/>

                    <button name="action_validate_lot"
                        type="object"
                        string="Validate Lot"
                        class="btn-warning"
                        invisible="not display_assign_serial"/>

                </span>
            </xpath>

            <xpath expr="//widget[@name='generate_serials']" position="replace">
                <widget class="btn btn-link btn-group" name="generate_serials" invisible="1"/>
            </xpath>                        
            
            <xpath expr="//widget[@name='import_lots']" position="replace">
                <widget class="btn btn-link btn-group" name="import_lots" invisible="1"/>
            </xpath>                        

        </field>
    </record>

    <record id="stock_picking_form_note_button" model="ir.ui.view">
        <field name="name">stock.picking.form.note.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="after">
                <button
                    name="action_open_note_wizard"
                    type="object"
                    icon="fa-sticky-note"
                    title="Note"
                    />

            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='lot_ids']" position="after" invisible="picking_type_name != 'Receipts'">
                <button name="action_print_lot_number_line" type="object" title="Print" icon="fa-print" column_invisible="parent.picking_type_code == 'outgoing'"/>
                <button name="action_open_move_pick"
                    type="object"
                    icon="fa-hand-lizard-o"
                    title="Open Picker"
                    invisible="state == 'draft'"
                    />
            </xpath>

            <xpath expr="//field[@name='quantity']" position="after">
                <field name="difference_quantity" readonly="1" optional="show" column_invisible="parent.state=='draft'" decoration-danger="difference_quantity > 0"/>
            </xpath>

        </field>
    </record>

    <record id="stock_move_note_form_view" model="ir.ui.view">
        <field name="name">stock.move.note.popup</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form string="Product Note">
                <group>
                    <field name="product_note" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="stock_move_pick_view" model="ir.ui.view">
        <field name="name">stock.move.pick</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form>
                <div class="grid-container">
                    <div style="display: flex !important; flex-direction: column !important; gap: 8px; width: 100%;">
                        
                        <div style="display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: top; gap: 5px; width: 100%;">
                            <label for="product_id" style="margin: 0 !important; white-space: nowrap !important;"/>
                            <field name="product_id" readonly="id or move_line_ids"/>
                        </div>

                    </div>

                    <div style="display: flex !important; flex-direction: column !important; gap: 8px; width: 100%;">
                                            
                        <div style="display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: center; gap: 5px; width: 100%;">
                            <label for="product_uom_qty" style="margin: 0 !important; white-space: nowrap !important;"/>
                            <field name="product_uom_qty" readonly="state != 'draft'" nolabel="1"/>
                            <field name="product_uom" groups="uom.group_uom" readonly="state != 'draft'" nolabel="1" options="{'no_open': True}"/>
                        </div>

                    </div>
                </div>
                <field name="move_line_ids"
                    readonly="state == 'cancel' or (state == 'done' and is_locked) or not product_id"
                    context="{
                        'list_view_ref': 'stock.view_stock_move_line_operation_tree',
                        'form_view_ref': 'stock.view_move_line_mobile_form',
                        'default_picking_id': picking_id, 
                        'default_move_id': id, 
                        'default_product_id': product_id, 
                        'default_location_id': location_id, 
                        'default_location_dest_id': location_dest_id,
                        'default_company_id': company_id, 
                        'active_picking_id': picking_id
                    }"
                    widget="sml_x2_many">
                    <list editable="bottom">
                        <field name="company_id" column_invisible="1" force_save="1"/>
                        <field name="picking_id" column_invisible="1" force_save="1"/>
                        <field name="move_id" column_invisible="1" force_save="1"/>
                        <field name="location_id" column_invisible="1" force_save="1"/>
                        <field name="location_dest_id" column_invisible="1" force_save="1"/>
                        <field name="product_uom_category_id" column_invisible="1"/>
                        <field name="tracking" column_invisible="1"/>
                        <field name="state" column_invisible="1"/>
                        <field name="is_locked" column_invisible="1"/>
                        <field name="quant_id" column_invisible="1"/>
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="lot_id" string="Lot/Serial Number" readonly="1" force_save="1" groups="stock.group_production_lot"/>
                        <field name="lot_name" readonly="1" force_save="1" optional="hide"/>
                        <field name="result_package_id" readonly="1" force_save="1" string="Packages"/>

                        <field name="quantity" string="Qty In Pack"/>
                        <field name="product_uom_id" string="Uom"/>

                    </list>
                </field>
            </form>
        </field>
    </record>

</odoo>
