<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Brand new kanban view for internal.transfer.order (tijari_wms_18's
         own custom model): purely additive, nothing existing is changed.
         internal.transfer.order previously had no kanban view at all, so
         its list-only window action fell back to list on mobile. -->
    <record id="view_internal_transfer_order_kanban" model="ir.ui.view">
        <field name="name">internal.transfer.order.kanban</field>
        <field name="model">internal.transfer.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="state"/>
                <field name="transaction_type"/>
                <field name="transfer_type"/>
                <field name="partner_id"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="schedule_date"/>
                <field name="picking_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <field name="state" widget="label_selection"
                                   options="{'classes': {
                                        'draft': 'default',
                                        'ready': 'info',
                                        'done': 'success',
                                        'cancel': 'danger'}}"/>
                        </div>
                        <div class="text-muted">
                            <field name="location_id"/> &#8594; <field name="location_dest_id"/>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <field name="transaction_type" widget="badge"/>
                            <field name="transfer_type" widget="badge"/>
                        </div>
                        <footer class="d-flex justify-content-between align-items-center mt-1">
                            <field name="partner_id"/>
                            <span>
                                <field name="schedule_date"/>
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
