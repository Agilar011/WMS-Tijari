<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_stock_location_acumatica" model="ir.actions.act_window">
      <field name="name">Location Acumatica</field>
      <field name="res_model">stock.location.acumatica</field>
      <field name="view_mode">list</field>
      <field name="context">{'search_default_not_is_error': 1}</field>
      <field name="domain">[]</field>
    </record>

    <record id="server_action_open_stock_location_acumatica" model="ir.actions.server">
      <field name="name">Open Location Acumatica</field>
      <field name="model_id" ref="model_stock_location_acumatica"/>
      <field name="state">code</field>
      <field name="code">action = model.action_open_acumatica_locations()</field>
    </record>

