<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_stock_location_acumatica" model="ir.actions.act_window">
      <field name="name">Location Acumatica</field>
      <field name="res_model">stock.location.acumatica</field>
      <field name="view_mode">list</field>
      <field name="domain">[('is_error', '=', False)]</field>
    </record>

    <record id="action_stock_location_acumatica_error" model="ir.actions.act_window">
      <field name="name">Location Acumatica Error</field>
      <field name="res_model">stock.location.acumatica</field>
      <field name="view_mode">list</field>
      <field name="view_id" ref="view_stock_location_acumatica_list_error"/>
      <field name="domain">[('is_error', '=', True)]</field>
    </record>

</odoo>
