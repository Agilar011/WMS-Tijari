<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_package_level_tree_inherit_wms" model="ir.ui.view">
        <field name="name">stock.package.level.tree.inherit.wms</field>
        <field name="model">stock.package_level</field>
        <field name="inherit_id" ref="stock.package_level_tree_view_picking"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='is_done']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <field name='is_done' position="after">
                <field name="status"
                    decoration-success="status == 'finished'"
                    decoration-danger="status == 'unfinished'" widget="badge" />
                <button name="action_mark_finished"
                    type="object"
                    icon="fa-check"
                    class="btn-success"
                    title="Finish Package"
                    invisible="status == 'finished'"/>

                <button name="action_mark_unfinished"
                    type="object"
                    icon="fa-undo"
                    class="btn-danger"
                    title="Undo Package"
                    invisible="status != 'finished'"/>
            </field>

        </field>
    </record>

    <record id="tijari_stock_package_level_view_form_inherit" model="ir.ui.view">
        <field name="name">tijari.stock.package.level.view.form.inherit</field>
        <field name="model">stock.package_level</field>
        <field name="inherit_id" ref="stock.package_level_form_view"/>
        <field name="arch" type="xml">
            <xpath expr='//form' position='inside'>
                <footer>
                    <button
                        name="action_mark_finished"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                </footer>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_form_package_level_list_only" model="ir.ui.view">
        <field name="name">stock.picking.form.package.level.list.only</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority" eval="2100"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']//field[@name='package_level_ids']" position="attributes">
                <attribute name="mode">list</attribute>
                <attribute name="context">{
                    'default_location_id': location_id,
                    'default_location_dest_id': location_dest_id,
                    'default_company_id': company_id,
                    'tree_view_ref': 'stock.package_level_tree_view_picking'
                }</attribute>
            </xpath>
        </field>
    </record>

</odoo>
