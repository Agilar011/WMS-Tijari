    <record id="view_stock_move_line_putaways" model="ir.ui.view">
        <field name="name">stock.picking.putaways</field>
	        <field name="model">stock.picking</field>
	        <field name="inherit_id" ref="stock.view_picking_form"/>
	        <field name="arch" type="xml">
	            <xpath expr="//page[@name='operations']" position="before">
	                <field name="internal_transfer_order_id" invisible="1"/>
	                <field name="is_ito_internal_transfer" invisible="1"/>
	            </xpath>
	            <xpath expr="//page[@name='operations']" position="after">
                </xpath>

        </field>
    </record>

    <record id="view_move_kanban_inherit_confirmation_qty" model="ir.ui.view">
        <field name="name">stock.move.line.kanban.confirmation.qty</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_kanban"/>
        <field name="arch" type="xml">

            <xpath expr="//kanban" position="attributes">
                <attribute name="class" add="o_wms_putaway_kanban" separator=" "/>
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
                <attribute name="can_open">0</attribute>
            </xpath>

            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card">
                    <field name="quant_id" invisible="1"/>
                    <div class="o_wms_operation_card">
                        <div class="o_wms_operation_product">
                            <field name="product_id" class="fs-3"/>
                        </div>
                        <div>
                            <div>
                                <strong>Qty Total: </strong>
                                <field name="product_uom_qty"
                                    readonly="state != 'draft'"/>
                            </div>

                            <div>
                                <strong>Qty Diterima: </strong>
                                <field name="quantity"/>
                            </div>
                            <div invisible="picking_type_name not in ['Receipts']">
                                <strong>Qty Diambil: </strong>
                                <field name="confirmation_quantity"/>
                            </div>
                        </div>
                        <div class="o_wms_operation_actions">
                            <button name="action_open_putaway_move_line_wizard"
                                type="object"
                                class="btn btn-primary btn-sm"
                                string="View Details">
                            </button>
                            <button name="action_mark_putaway_unfinished"
                                type="object"
                                class="btn btn-danger btn-sm"
                                invisible="putaway_status == 'unfinished' or picking_id.state== 'done'">
                                <i class="fa fa-undo"/>
                            </button>
                            <field name="putaway_status"
                                decoration-success="putaway_status == 'finished'"
                                decoration-danger="putaway_status == 'unfinished'"
                                widget="badge"/>
                        </div>
                    </div>
                </t>
            </xpath>

        </field>
    </record>

    <record id="view_move_kanban_inherit_can_open" model="ir.ui.view">
        <field name="name">stock.move.line.kanban.can.open</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="can_open">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
