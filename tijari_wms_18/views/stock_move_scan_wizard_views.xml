<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="view_stock_move_scan_wizard_form" model="ir.ui.view">
		<field name="name">stock.move.scan.wizard.form</field>
		<field name="model">stock.move.scan.wizard</field>
		<field name="arch" type="xml">
			<form string="Scan Product">
				<sheet>

					<group>
						<field name="picking_id" invisible="1"/>
						<field name="scan_code"
							placeholder="Scan product QR / barcode..."
							default_focus="1"/>
						<field name="lot_product_id"/>
						<field name="allowed_product_ids" invisible="1"/>
						<field name="product_id" force_save="1"/>
					</group>

						<field name="move_line_ids" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}" groups="!tijari_wms_18.group_picker">
							<list editable="bottom" create="0" delete="0" edit="1">

                            <field name="id" string="Line ID"/>
                            <!-- <field name="matching_html" readonly="1" force_save="1"/> -->
                            <field name="adt_dest_location_id" column_invisible="1"/>
                            <field name="allowed_matching_lot_ids" column_invisible="1"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="matching_lot_id" force_save="1" domain="[('id', 'in', allowed_matching_lot_ids)]"/>


                            <field name="location_id" readonly="1"/>
                            <field name="location_dest_id" readonly="1"/>
                            <field name="matching_loc_dest_id" force_save="1" domain="[('id', 'child_of', adt_dest_location_id)]"/>


							<field name="quantity" readonly="1"/>
							<field name="product_uom_id" readonly="1"/>
							<field name="matching"
								decoration-success="matching == 'match'"
								decoration-danger="matching == 'not_match'"/>
							<field name="confirmation_lot_code"
								widget="adt_scan_lot_button"
								string=" "
								readonly="1"
								invisible="matching == 'match'"/>
							<field name="confirmation_location_code"
								widget="adt_scan_location_button"
								string=" "
								readonly="1"
								invisible="matching == 'match'"/>

							</list>
						</field>
						<field name="move_line_ids" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}" groups="tijari_wms_18.group_picker">
							<list editable="bottom" create="0" delete="0" edit="1">
	                            <field name="adt_dest_location_id" column_invisible="1"/>
	                            <field name="allowed_matching_lot_ids" column_invisible="1"/>
	                            <field name="lot_id" string="Lot" readonly="1"/>
	                            <field name="location_id" string="Pick From" readonly="1"/>
								<field name="quantity" string="Quantity" readonly="1"/>
								<field name="product_uom_id" string="Unit of Measure" readonly="1"/>
	                            <field name="matching_lot_id" string="Confirmed Lot" force_save="1" domain="[('id', 'in', allowed_matching_lot_ids)]"/>
	                            <field name="matching_loc_dest_id" string="Confirm Location" force_save="1" domain="[('id', 'child_of', adt_dest_location_id)]"/>
								<field name="matching" string="Status"
									decoration-success="matching == 'match'"
									decoration-danger="matching == 'not_match'"/>
								<field name="confirmation_lot_code"
									widget="adt_scan_lot_button"
									string="Scan Lot"
									readonly="1"
									invisible="matching == 'match'"/>
								<field name="confirmation_location_code"
									widget="adt_scan_location_button"
									string="Scan Location"
									readonly="1"
									invisible="matching == 'match'"/>
							</list>
						</field>
					</sheet>

				<footer>

					<button string="Save"
							special="save"
							class="btn-primary"/>

					<button string="Close"
							special="cancel"
							class="btn-secondary"/>
				</footer>
			</form>
		</field>
	</record>

    <record id="view_stock_move_line_putaways" model="ir.ui.view">
        <field name="name">stock.picking.putaways</field>
	        <field name="model">stock.picking</field>
	        <field name="inherit_id" ref="stock.view_picking_form"/>
	        <field name="arch" type="xml">
	            <xpath expr="//page[@name='operations']" position="after">
	                <page string="Picker" name="page_picker" invisible="picking_type_name not in ['Receipts', 'Receipt Internal']">
	                    <group>
	                        <field name="scan_picker_product_button"
	                            widget="adt_scan_picker_product_button"
	                            nolabel="1"/>
	                        <field name="allowed_picker_product_ids" invisible="1"/>
	                        <field name="picker_product_id" domain="[('id', 'in', allowed_picker_product_ids)]"/>
	                    </group>

		                    <field name="picker_move_ids" groups="!tijari_wms_18.group_picker">
		                        <list decoration-muted="scrapped == True or state == 'cancel' or (state == 'done' and is_locked == True)" string="Stock Moves" create="0" delete="0" edit="0">
		                            <field name="company_id" column_invisible="True"/>
		                            <field name="picking_id" column_invisible="True"/>
	                            <field name="name" column_invisible="True"/>
	                            <field name="state" readonly="0" column_invisible="True"/>
	                            <field name="picking_type_id" column_invisible="True"/>
	                            <field name="move_line_ids" column_invisible="True"/>
	                            <field name="location_id" column_invisible="True"/>
	                            <field name="location_dest_id" column_invisible="True"/>
	                            <field name="partner_id" column_invisible="True" readonly="state == 'done'"/>
	                            <field name="scrapped" column_invisible="True"/>
	                            <field name="picking_code" column_invisible="True"/>
	                            <field name="show_details_visible" column_invisible="True"/>
	                            <field name="additional" column_invisible="True"/>
	                            <field name="move_lines_count" column_invisible="True"/>
	                            <field name="is_locked" column_invisible="True"/>
	                            <field name="product_uom_category_id" column_invisible="True"/>
	                            <field name="is_storable" column_invisible="True"/>
	                            <field name="has_tracking" column_invisible="True"/>
		                            <field name="product_id" string="Product" readonly="1"/>
		                            <field name="location_final_id" column_invisible="True" groups="stock.group_stock_multi_locations"/>
		                            <field name="description_picking" column_invisible="True"/>
		                            <field name="date" column_invisible="True"/>
		                            <field name="date_deadline" column_invisible="True"/>
	                            <field name="is_quantity_done_editable" column_invisible="True"/>
	                            <field name="show_quant" column_invisible="True"/>
	                            <field name="show_lots_text" column_invisible="True"/>
	                            <field name="show_lots_m2o" column_invisible="True"/>
	                            <field name="is_initial_demand_editable" column_invisible="True"/>
	                            <field name="display_import_lot" column_invisible="True"/>
	                            <field name="picking_type_entire_packs" column_invisible="True"/>
		                            <field name="product_packaging_id" string="Packaging" optional="show" groups="product.group_stock_packaging"
		                                context="{'default_product_id': product_id}"
		                                readonly="not product_id"/>
		                            <field name="product_uom_qty" string="Demand" readonly="1"/>
		                            <field name="remaining_package_qty" column_invisible="True"/>
	                            <field name="forecast_expected_date" column_invisible="True"/>
	                            <field name="forecast_availability" column_invisible="True"/>
	                            <field name="product_qty" readonly="1" column_invisible="True"/>
		                            <field name="lot_ids" widget="many2many_tags"
		                                column_invisible="True"
		                                groups="stock.group_production_lot"/>
		                            <field name="adt_type" column_invisible="1"/>
		                            <field name="owner_id" column_invisible="True"/>
		                            <field name="adt_dest_location_id" column_invisible="True"/>
		                            <field name="quantity" string="Picked Qty" readonly="1" column_invisible="parent.state=='draft'" decoration-danger="product_uom_qty and quantity > product_uom_qty and parent.state not in ['done', 'cancel']"/>
		                            <field name="confirmation_quantity" string="Stored Qty" readonly="1" optional="show"/>
		                            <field name="product_uom" readonly="1" options="{'no_open': True, 'no_create': True}" string="Unit" groups="uom.group_uom"/>
		                            <field name="product_uom" groups="!uom.group_uom" column_invisible="True"/>
		                            <field name="difference_quantity" string="Difference Qty" readonly="1" optional="show" column_invisible="parent.state=='draft'" decoration-danger="difference_quantity > 0"/>
		                            <button
		                                name="action_open_note_wizard"
		                                type="object"
		                                icon="fa-sticky-note"
		                                title="Note"/>
		                            <button name="action_open_move_pick"
		                                type="object"
		                                icon="fa-hand-lizard-o"
		                                title="Open Picker"
		                                invisible="state == 'draft'"/>
		                        </list>
		                    </field>
		                    <field name="picker_move_ids" groups="tijari_wms_18.group_picker">
		                        <list decoration-muted="scrapped == True or state == 'cancel' or (state == 'done' and is_locked == True)" string="Stock Moves" create="0" delete="0" edit="0">
		                            <field name="state" column_invisible="True"/>
		                            <field name="is_locked" column_invisible="True"/>
		                            <field name="scrapped" column_invisible="True"/>
		                            <field name="product_id" string="Product" readonly="1"/>
		                            <field name="product_uom_qty" string="Demand" readonly="1"/>
		                            <field name="quantity" string="Picked Qty" readonly="1" column_invisible="parent.state=='draft'" decoration-danger="product_uom_qty and quantity > product_uom_qty and parent.state not in ['done', 'cancel']"/>
		                            <field name="confirmation_quantity" string="Stored Qty" readonly="1"/>
		                            <field name="product_uom" readonly="1" options="{'no_open': True, 'no_create': True}" string="UoM" groups="uom.group_uom"/>
		                            <field name="product_uom" groups="!uom.group_uom" column_invisible="True"/>
		                            <field name="difference_quantity" string="Difference Qty" readonly="1" column_invisible="parent.state=='draft'" decoration-danger="difference_quantity > 0"/>
		                            <button name="action_open_move_pick"
		                                type="object"
		                                icon="fa-hand-lizard-o"
		                                title="Open Picker"
		                                invisible="state == 'draft'"/>
		                        </list>
		                    </field>
		                </page>

	                <page string="Putaway" invisible="picking_type_name not in ['Receipts', 'Receipt Internal', 'Internal Transfers']">
	                    <group>
	                        <field name="scan_product_button"
                            widget="adt_scan_product_button"
                            nolabel="1"/>
                        <field name="allowed_putaway_product_ids" invisible="1"/>
                        <field name="putaway_product_id" domain="[('id', 'in', allowed_putaway_product_ids)]"/>
                        <field name="putaway_lot_id" readonly="1"/>
                        <!-- <button name="action_validate_lot"
                            type="object"
                            string="Validate Lot"
                            class="btn-warning"
                            invisible="not display_assign_serial"/> -->

                    </group>

                    <field name="putaway_move_line_ids" groups="!tijari_wms_18.group_putaway">
                        <list editable="bottom">
                            <field name="product_id" readonly="1"/>
                            <field name="location_dest_id" column_invisible="1"/>
                            <field name="location_putaway_id"
                                string="Store To"
                                readonly="putaway_status == 'finished'"
                                context="{'show_location_short_name': True}"
                                domain="[('id', 'child_of', adt_dest_location_id)]"/>
                            <field name="quantity" string="Qty Diterima" readonly="1"/>
                            <field name="confirmation_quantity" string="Qty Disimpan" readonly="putaway_status == 'finished'" force_save="1"/>
                            <field name="product_uom_id" readonly="1" string="UoM" optional="hide"/>
                            <field name="matching" column_invisible="1" force_save="1"/>
                            <field name="adt_dest_location_id" column_invisible="1"/>
                            <field name="allowed_matching_lot_ids" column_invisible="1"/>

                            <!-- <field name="matching_lot_id" force_save="1" domain="[('id', 'in', allowed_matching_lot_ids)]"/>
                            <field name="matching_loc_dest_id" force_save="1" domain="[('id', 'child_of', adt_dest_location_id)]"/> -->
                            <field name="putaway_status" string="Status"
                                decoration-success="putaway_status == 'finished'"
                                decoration-danger="putaway_status == 'unfinished'" widget="badge"/>
                            <field name="confirmation_location_code"
                                widget="adt_scan_location_button"
                                string=" "
                                readonly="1"
                                invisible="putaway_status == 'finished'"/>

                            <button name="action_mark_putaway_finished"
                                type="object"
                                icon="fa-check"
                                class="btn-success"
                                title="Finish Putaway"
                                invisible="putaway_status == 'finished'"/>

                            <button name="action_mark_putaway_unfinished"
                                type="object"
                                icon="fa-undo"
                                class="btn-danger"
                                title="Undo Putaway"
                                invisible="putaway_status == 'unfinished'"/>

                        </list>
                    </field>
                    <field name="putaway_move_line_ids" groups="tijari_wms_18.group_putaway">
                        <list editable="bottom" create="0" delete="0">
                            <field name="location_dest_id" column_invisible="1"/>
                            <field name="putaway_status" column_invisible="1"/>
                            <field name="adt_dest_location_id" column_invisible="1"/>
                            <field name="location_putaway_id"
                                string="Store To"
                                readonly="putaway_status == 'finished'"
                                context="{'show_location_short_name': True}"
                                domain="[('id', 'child_of', adt_dest_location_id)]"/>
                            <field name="quantity" string="Picked Qty" readonly="1"/>
                            <field name="confirmation_quantity" string="Stored Qty" readonly="putaway_status == 'finished'" force_save="1"/>
                            <field name="product_uom_id" readonly="1" string="UoM"/>
                            <field name="confirmation_location_code"
                                widget="adt_scan_location_button"
                                string=" "
                                readonly="1"
                                invisible="putaway_status == 'finished'"/>

                            <button name="action_mark_putaway_finished"
                                type="object"
                                icon="fa-check"
                                class="btn-success"
                                title="Finish Putaway"
                                invisible="putaway_status == 'finished'"/>

                            <button name="action_mark_putaway_unfinished"
                                type="object"
                                icon="fa-undo"
                                class="btn-danger"
                                title="Undo Putaway"
                                invisible="putaway_status == 'unfinished'"/>

                        </list>
                    </field>
                </page>
            </xpath>
        
        </field>
    </record>

</odoo>
