<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="view_picking_form_inherit_acumatica_header" model="ir.ui.view">
        <field name="name">stock.picking.form.acumatica.header</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="wms_state"
                    widget="statusbar"
                    invisible="picking_type_name != 'Delivery Orders' or transaction_type !='outbound'"/>
            </xpath>

            <xpath expr="//field[@name='state'][1]" position="replace">
                <field name="state"
                    widget="statusbar"
                    invisible="1"/>
            </xpath>

            <xpath expr="//header/field[@name='state'][2]" position="replace">
                <field name="state"
                    widget="statusbar"
                    statusbar_visible="draft,confirmed,assigned,done"
                    invisible="1"/>

            </xpath>            

            <xpath expr="(//button[@name='button_validate'])[1]" position="replace">
                <button name="button_validate"
                        string="Validate"
                        type="object"
                        class="oe_highlight"
                        groups="stock.group_stock_user"
                        invisible="picking_type_name == 'Delivery Orders' and transaction_type =='outbound'"
                        data-hotkey="v"/>
            </xpath>

            <xpath expr="//button[@name='button_validate']" position="after">

                <button name="action_post_loginext"
                string="Sent Response"
                type="object"
                class="btn-primary"
                invisible="picking_type_name != 'Delivery Orders' or transaction_type !='outbound' and state != 'assigned'"/>

                <button name="action_get_loginext"
                string="Get Response"
                type="object"
                class="btn-primary"
                invisible="picking_type_name != 'Delivery Orders' or transaction_type !='outbound' and state != 'assigned'"/>

            </xpath>


        </field>
    </record>

</odoo>