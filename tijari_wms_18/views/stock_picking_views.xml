<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="stock_picking_kanban_show_origin_without_activity" model="ir.ui.view">
        <field name="name">stock.picking.kanban.show.origin.without.activity</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.stock_picking_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='picking_type_id']" position="after">
                <field name="origin"/>
                <field name="user_ids"/>
                <field name="adt_type"/>
                <field name="adt_total_qty"/>
            </xpath>
            <xpath expr="//templates/t[@t-name='card']//field[@name='name']" position="replace">
                <div class="min-w-0 flex-grow-1 ms-1">
                    <field name="origin" class="fw-bold fs-5"/>
                    <div class="text-muted small text-truncate">
                        <field name="partner_id"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//templates/t[@t-name='card']//footer//field[@name='partner_id']" position="replace"/>
            <xpath expr="//templates/t[@t-name='card']//field[@name='picking_properties']" position="after">
                <div class="mt-1 ms-1 text-muted small">
                    <div t-if="record.adt_type.raw_value">
                        <span class="fw-semibold">Type: </span>
                        <field name="adt_type"/>
                    </div>
                    <div>
                        <span class="fw-semibold">Total Qty: </span>
                        <field name="adt_total_qty"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//templates/t[@t-name='card']//field[@name='user_id']" position="replace">
                <field name="user_ids" widget="many2many_avatar_user" readonly="state in ['cancel', 'done']" class="ms-1"/>
            </xpath>
            <xpath expr="//templates/t[@t-name='card']//field[@name='activity_ids'][@widget='kanban_activity']" position="replace"/>
        </field>
    </record>

     <record id="view_picking_form_inherit_acumatica_header" model="ir.ui.view">
        <field name="name">stock.picking.form.acumatica.header</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="wms_state"
                    widget="statusbar"
                    statusbar_visible="draft,assigned,waiting_response,done"
                    invisible="picking_type_name not in ['Delivery Orders'] or adt_type not in ['Sales Order Shipment']"    
                />
            </xpath>

            <xpath expr="//field[@name='state'][1]" position="replace">
                <field name="state"
                    widget="statusbar"
                    invisible="1"/>
            </xpath>

            <xpath expr="//header/field[@name='state'][2]" position="replace">
                <field name="state"
                    widget="statusbar"
                    statusbar_visible="draft,confirmed,assigned,done"
                    invisible="adt_type in ['Sales Order Shipment']"/>

            </xpath>            

            <xpath expr="(//button[@name='button_validate'])[1]" position="replace">
                <button name="button_validate"
                        string="Validate"
                        type="object"
                        class="oe_highlight"
                        groups="stock.group_stock_user"
                        invisible="state in ('draft', 'waiting', 'confirmed', 'waiting_response', 'done', 'cancel')"
                        data-hotkey="v"/>
            </xpath>

            <xpath expr="//button[@name='button_validate']" position="after">

                <button name="button_validate"
                string="Validate"
                type="object"
                class="btn-primary"
                invisible="picking_type_name not in ['Delivery Orders'] or adt_type not in ['Sales Order Shipment'] or wms_state in ('draft', 'waiting', 'confirmed', 'waiting_response', 'done', 'cancel', 'return_shipment')"/>

                
                <button name="action_fetch_actual_qty"
                string="Get Full Shipment Data"
                type="object"
                class="btn-primary"
                invisible="picking_type_name not in ['Delivery Orders'] or adt_type not in ['Sales Order Shipment'] or wms_state in ('draft', 'waiting', 'confirmed', 'assigned', 'done', 'cancel', 'return_shipment')"/>

                <button name="action_fetch_partial_shipment"
                string="Get Partial Shipment Data"
                type="object"
                class="btn-primary"
                invisible="picking_type_name not in ['Delivery Orders'] or adt_type not in ['Sales Order Shipment'] or wms_state in ('draft', 'waiting', 'confirmed', 'assigned', 'done', 'cancel', 'return_shipment')"/>

                <button
                    name="action_confirm_shipment"
                    type="object"
                    string="Confirm Shipment"
                    class="btn-primary"
                    invisible="picking_type_name not in ['Delivery Orders'] or adt_type not in ['Sales Order Shipment'] or wms_state != 'waiting_response'"/>

                <button
                    name="action_mark_as_done"
                    type="object"
                    string="Set to Done"
                    class="btn-primary"
                    invisible="picking_type_name not in ['Delivery Orders'] or adt_type not in ['Sales Order Shipment'] or wms_state != 'return_shipment'"/>

                <button name="action_print_warehouse_receipt"
                    string="Print Receipt"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'done' or picking_type_name not in ['Receipts', 'Receipt Internal']"/>

                <button name="action_send_email_hasil_picking"
                    string="Send Email"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'done' or picking_type_name not in ['Receipts', 'Receipt Internal']"/>

            </xpath>

            <xpath expr="//field[@name='picking_type_id'][1]" position="after">
                <group>

                    <field name="shipment_information" 
                    invisible="picking_type_name not in ['Delivery Orders']"
                            decoration-success="shipment_information == 'full_shipment'"
                            decoration-warning="shipment_information == 'partial'"
                            decoration-danger="shipment_information == 'canceled'"/>

                </group>
            </xpath>

            <xpath expr="//page[@name='extra']//group[@name='other_infos']/field[@name='user_id']" position="replace">
                <field name="user_ids" widget="many2many_avatar_user" domain="[('share', '=', False)]" readonly="state in ['cancel', 'done']"/>
            </xpath>

            <xpath expr="//notebook/page[@name='operations']" position="after">

                <page string="Unpacked Item Details" name="detail_product" invisible="picking_type_name not in ['Delivery Orders', 'Transfer Internal']">
                    <field name="move_ids_without_package" mode="list,kanban"
                        widget="stock_move_one2many"
                        context="{
                            'default_company_id': company_id, 
                            'default_date': scheduled_date, 
                            'default_date_deadline': date_deadline, 
                            'picking_type_code': picking_type_code, 
                            'default_picking_id': id, 
                            'form_view_ref': 'tijari_wms_18.stock_move_pick_view',
                            'address_in_id': partner_id, 
                            'default_picking_type_id': picking_type_id, 
                            'default_location_id': location_id, 
                            'default_location_dest_id': location_dest_id, 
                            'default_partner_id': partner_id}"
                        add-label="Add a Product"
                        >
                        <list decoration-muted="scrapped == True or state == 'cancel' or (state == 'done' and is_locked == True)" string="Stock Moves" editable="bottom">
                            <field name="company_id" column_invisible="True"/>
                            <field name="picking_id" column_invisible="True"/>
                            <field name="name" column_invisible="True"/>
                            <field name="state" readonly="0" column_invisible="True"/>
                            <field name="picking_type_id" column_invisible="True"/>
                            <field name="move_line_ids" column_invisible="True"/>
                            <field name="location_id" column_invisible="True"/>
                            <field name="location_dest_id" column_invisible="True"/>
                            <field name="partner_id" column_invisible="True" readonly="state == 'done'"/>
                            <field name="scrapped" column_invisible="True"/>
                            <field name="picking_code" column_invisible="True"/>
                            <field name="show_details_visible" column_invisible="True"/>
                            <field name="additional" column_invisible="True"/>
                            <field name="move_lines_count" column_invisible="True"/>
                            <field name="is_locked" column_invisible="True"/>
                            <field name="product_uom_category_id" column_invisible="True"/>
                            <field name="is_storable" column_invisible="True"/>
                            <field name="has_tracking" column_invisible="True"/>
                            <field name="product_id" context="{'default_is_storable': True}" required="1" readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0" force_save="1"/>
                            <field name="location_final_id" optional="hide" groups="stock.group_stock_multi_locations"/>
                            <field name="description_picking" string="Description" optional="hide"/>
                            <field name="date" optional="hide"/>
                            <field name="date_deadline" optional="hide"/>
                            <field name="is_quantity_done_editable" column_invisible="True"/>
                            <field name="show_quant" column_invisible="True"/>
                            <field name="show_lots_text" column_invisible="True"/>
                            <field name="show_lots_m2o" column_invisible="True"/>
                            <field name="is_initial_demand_editable" column_invisible="True"/>
                            <field name="display_import_lot" column_invisible="True"/>
                            <field name="picking_type_entire_packs" column_invisible="True"/>
                            <field name="product_packaging_id" string="Packaging" optional="hide" groups="product.group_stock_packaging"
                                context="{'default_product_id': product_id}"
                                readonly="not product_id"/>
                            <field name="product_uom_qty" string="Total Qty" readonly="not is_initial_demand_editable"/>
                            <field name="remaining_package_qty" string="Remaining Product" readonly="1"/>
                            <button type="object" name="action_product_forecast_report" title="Forecast Report" icon="fa-area-chart"
                                invisible="not product_id or product_uom_qty == 0 or quantity == 0 and forecast_availability &lt;= 0 or (parent.picking_type_code == 'outgoing' and state != 'draft')"/>
                            <button type="object" name="action_product_forecast_report" title="Forecast Report" icon="fa-area-chart text-danger"
                                invisible="not product_id or product_uom_qty == 0 or quantity &gt; 0 or forecast_availability &gt; 0 or (parent.picking_type_code == 'outgoing' and state != 'draft')"/>
                            <field name="forecast_expected_date" column_invisible="True"/>
                            <field name="forecast_availability" string="Forecast" optional="hide"
                                column_invisible="parent.state in ('draft', 'done') or parent.picking_type_code != 'outgoing'" widget="forecast_widget"/>
                            <field name="product_qty" readonly="1" column_invisible="True"/>
                            <!-- <field name="temp_float" string="Confirmed Quantity"/> -->
                            <field name="so_confirmation_quantity" string="Confirmed Quantity" column_invisible="parent.picking_type_name not in ['Delivery Orders', 'Transfer Internal']"/>
                            <field name="quantity" string="Qty Diterima" optional="hide" readonly="not is_quantity_done_editable" column_invisible="parent.state=='draft'" decoration-danger="product_uom_qty and quantity > product_uom_qty and parent.state not in ['done', 'cancel']"/>
                            <field name="product_uom" readonly="state != 'draft' and not additional" options="{'no_open': True, 'no_create': True}" string="Unit" groups="uom.group_uom"/>
                            <field name="product_uom" groups="!uom.group_uom" column_invisible="True"/>
                            <field name="picked" optional="hide" column_invisible="parent.state=='draft'"/>
                            <field name="lot_ids" widget="many2many_tags"
                                readonly="has_tracking != 'serial'"
                                column_invisible="parent.state == 'draft'"
                                groups="stock.group_production_lot"
                                invisible="not show_details_visible or has_tracking == 'none'"
                                optional="hide"
                                options="{'create': [('parent.use_create_lots', '=', True)]}"
                                context="{'default_company_id': company_id, 'default_product_id': product_id, 'active_picking_id': parent.id}"
                                domain="[('product_id','=',product_id)]"
                            />
                            <field name="shipped_qty" optional='hide' />
                            <field name="status_check"
                                decoration-success="status_check == 'finished'"
                                decoration-danger="status_check == 'unfinished'" widget="badge" />
                            <button name="action_mark_check_finished"
                                type="object"
                                icon="fa-check"
                                class="btn-success"
                                title="Finish Package"
                                invisible="status_check == 'finished'"/>

                            <button name="action_mark_check_unfinished"
                                type="object"
                                icon="fa-undo"
                                class="btn-danger"
                                title="Undo Package"
                                invisible="status_check != 'finished'"/>
                        </list>
                    </field>
                    <field name="id" invisible="1"/>
                    <!-- <field name="package_level_ids" context="{'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}" invisible="not picking_type_entire_packs" readonly="state == 'done'" /> -->
                    <button class="btn-secondary float-end" name="action_put_in_pack" type="object" string="Put in Pack" invisible="state in ('draft', 'done', 'cancel')" groups="stock.group_tracking_lot" data-hotkey="shift+g"/>
                </page>

                <page string="Packed Item Details"
                    invisible="picking_type_name not in ['Delivery Orders', 'Transfer Internal']">

                    <group>
                        <group>
                            <field name="scan_package_button"
                                widget="adt_scan_package_button"
                                nolabel="1"
                                invisible="picking_type_name not in ['Delivery Orders', 'Transfer Internal']"/>
                            <field name="available_package_ids" invisible='1' />
                            <field name="scanned_package_id"
                                placeholder="Scan a QR code or select a package..."
                                domain="[('id', 'in', available_package_ids)]"
                                options="{'no_create': True, 'no_open': True}"/>
                            <field name="filtered_package_level_id" invisible="1"/>
                        </group>
                    </group>

                    <field name="filtered_package_level_ids"
                        context="{
                            'default_location_id': location_id,
                            'default_location_dest_id': location_dest_id,
                            'default_company_id': company_id
                        }"
                        readonly="state == 'done'"
                        invisible="not picking_type_entire_packs"/>

                    <div class="mt16"/>

                    <button name="action_put_in_pack"
                            type="object"
                            string="Put in Pack"
                            class="btn-secondary"
                            groups="stock.group_tracking_lot"
                            invisible="state in ('draft','done','cancel')"
                            data-hotkey="shift+g"/>

                </page>

            </xpath>

        </field>
    </record>

    <record id="view_picking_form_inherit_location_dest" model="ir.ui.view">
        <field name="name">stock.picking.form.location.dest</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/*[1]" position="before">
                <widget name="web_ribbon"
                    title="Doc. Only"
                    bg_color="text-bg-info"
                    invisible="not adt_is_document_only"/>
            </xpath>

            <xpath expr="//field[@name='picking_type_id']"
                position="after">
                <field name="adt_type" string="Tipe Transaksi" />

            </xpath>

            <xpath expr="//field[@name='location_id'][@groups='stock.group_stock_multi_locations']"
                position="replace">
                <field name="internal_transfer_adt_dest_location_id"
                    string="Final Location"
                    domain="[('is_location_mapping', '=', True)]"
                    invisible="picking_type_name != 'Internal Transfers'"/>
                <field name="location_id"
                    options="{'no_create': True}"
                    groups="stock.group_stock_multi_locations"
                    invisible="picking_type_code == 'incoming' or picking_type_name == 'Internal Transfers'"
                    readonly="state == 'done'"/>
                <field name="location_id"
                    options="{'no_create': True}"
                    groups="stock.group_stock_multi_locations"
                    invisible="picking_type_name != 'Internal Transfers'"
                    readonly="state == 'done'"
                    domain="[('id', 'child_of', internal_transfer_adt_dest_location_id)]"/>
            </xpath>

            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']"
                position="replace">
                <field name="operation_category" invisible="1" />

                <!-- Default domain -->
                <field name="location_dest_id"
                    string="Gudang Tujuan"
                    options="{'no_create': True}"
                    groups="stock.group_stock_multi_locations"
                    invisible="(picking_type_code == 'internal' and operation_category == 'put') or picking_type_name == 'Internal Transfers'"
                    readonly="state == 'done'"/>

                <!-- Custom domain -->
                <field name="location_dest_id"
                    string="Gudang Tujuan"
                    options="{'no_create': True}"
                    groups="stock.group_stock_multi_locations"
                    invisible="picking_type_code != 'internal' or operation_category != 'put' or picking_type_name == 'Internal Transfers'"
                    readonly="state == 'done'"
                    domain="[('id', 'child_of', adt_dest_location_id)]"/>

                <!-- Internal Transfer header domain -->
                <field name="location_dest_id"
                    string="Gudang Tujuan"
                    options="{'no_create': True}"
                    groups="stock.group_stock_multi_locations"
                    invisible="picking_type_name != 'Internal Transfers'"
                    readonly="state == 'done'"
                    domain="[('id', 'child_of', internal_transfer_adt_dest_location_id)]"/>

            </xpath>

            <xpath expr="//field[@name='origin']" position="after">
                <!-- <field name="adt_type" readonly="1"/> -->
                <field name="adt_is_document_only" invisible="1"/>
                <field name="adt_total_qty" string="Total Qty"/>
                <field name="adt_actual_qty" string="Total Penerimaan"/>
                <field name="status_ba"/>
                <field name="adt_dest_location_id" string="Final Location" invisible="adt_type == 'Receipt' or picking_type_name in ['Pick', 'Pick Internal', 'Internal Transfers']"/>
                <field name="all_moves_picked" invisible="1"/>
            </xpath>

            <xpath expr="//label[@for='partner_id'][@invisible=&quot;picking_type_code != 'incoming'&quot;]" position="attributes">
                <attribute name="string">Supplier / Customer</attribute>
            </xpath>

            <xpath expr="//group//field[@name='origin']" position="attributes">
                <attribute name="string">No. Dokumen</attribute>
            </xpath>

            <xpath expr="//group//field[@name='origin']" position="replace">
                <field name="name" readonly="1" string="Seri Dokumen"/>
            </xpath>

        </field>
    </record>

    <record id="view_picking_form_inherit_change_lot_ids_label" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.change.lot.ids.label</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_ids_without_package']//field[@name='lot_ids']" position="attributes">
                <attribute name="string">Lot / Serial Number</attribute>
            </xpath>

        </field>
    </record>

    <record id="stock_picking_form_compact_move_open_view" model="ir.ui.view">
        <field name="name">stock.picking.form.compact.move.open.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority" eval="2000"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package'][@widget='stock_move_one2many']" position="attributes">
                <attribute name="context">{
                    'default_company_id': company_id,
                    'default_date': scheduled_date,
                    'default_date_deadline': date_deadline,
                    'picking_type_code': picking_type_code,
                    'default_picking_id': id,
                    'form_view_ref': 'tijari_wms_18.stock_move_pick_view',
                    'address_in_id': partner_id,
                    'default_picking_type_id': picking_type_id,
                    'default_location_id': location_id,
                    'default_location_dest_id': location_dest_id,
                    'default_partner_id': partner_id
                }</attribute>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_tree_transaction_columns" model="ir.ui.view">
        <field name="name">stock.picking.list.transaction.columns</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="priority" eval="1200"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="Transfers" multi_edit="1" sample="1" js_class="stock_list_view">
                    <header>
                        <button name="do_unreserve" type="object" string="Unreserve"/>
                        <button name="action_assign" type="object" string="Check Availability"/>
                    </header>
                    <field name="adt_type" string="Tipe Transaksi"/>
                    <field name="origin" string="No. Dokumen" decoration-bf="1" readonly="state in ['cancel', 'done']"/>
                    <field name="location_id" optional="hide"
                        options="{'no_create': True}"
                        groups="stock.group_stock_multi_locations"
                        readonly="state == 'done'"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                    <field name="adt_is_document_only" optional="hide"/>
                    <field name="partner_id" readonly="state in ['cancel', 'done']" string="Supplier/Customer"/>
                    <field name="adt_total_qty" string="Total Qty"/>
                    <field name="scheduled_date" widget="remaining_days"
                        readonly="state in ['cancel', 'done']" optional="hide"/>
                    <field name="state" widget="badge"
                        decoration-danger="state == 'cancel'"
                        decoration-info="state == 'assigned'"
                        decoration-muted="state == 'draft'"
                        decoration-success="state == 'done'"
                        decoration-warning="state not in ('draft', 'cancel', 'done', 'assigned')"/>
                    <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
                    <field name="batch_id" string="Batch" optional="hide"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_batch_transaction_tree_columns" model="ir.ui.view">
        <field name="name">stock.picking.batch.transaction.list.columns</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_view_batch_tree_ref"/>
        <field name="mode">primary</field>
        <field name="priority" eval="1200"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="Transactions" default_order="internal_transfer_sequence, batch_sequence">
                    <field name="internal_transfer_sequence" column_invisible="1"/>
                    <field name="batch_sequence" widget="handle"/>
                    <field name="origin" string="No. Dokumen" decoration-bf="1" readonly="state in ['cancel', 'done']"/>
                    <field name="location_id" optional="hide"
                        options="{'no_create': True}"
                        groups="stock.group_stock_multi_locations"
                        readonly="state == 'done'"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                    <field name="adt_type" string="Tipe Transaksi"/>
                    <field name="adt_is_document_only" optional="hide"/>
                    <field name="partner_id" string="Supplier / Customer" readonly="state in ['cancel', 'done']"/>
                    <field name="scheduled_date" widget="remaining_days"
                        readonly="state in ['cancel', 'done']"/>
                    <field name="state" widget="badge"
                        decoration-danger="state == 'cancel'"
                        decoration-info="state == 'assigned'"
                        decoration-muted="state == 'draft'"
                        decoration-success="state == 'done'"
                        decoration-warning="state not in ('draft', 'cancel', 'done', 'assigned')"/>
                    <field name="batch_id" string="Batch"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_for_type_pick" model="ir.ui.view">
        <field name="name">stock.picking.type.pick</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='operations']" position="attributes">
                    <attribute name="invisible">'Pick' in (picking_type_name or '')</attribute>
                </xpath>
                <xpath expr="//page[@name='operations']" position="after">
                    <page string="Operations" name="page_picker_operation" invisible="'Pick' not in (picking_type_name or '')">
                        <group>
                            <field name="scan_picker_product_button"
                                widget="adt_scan_picker_product_button"
                                nolabel="1"/>
                            <field name="allowed_picker_product_ids" invisible="1"/>
                            <field name="picker_product_id" domain="[('id', 'in', allowed_picker_product_ids)]"/>
                        </group>
                        <field name="filtered_move_ids" 
                            mode="list,kanban"
                            context="{
                                'form_view_ref': 'tijari_wms_18.stock_move_pick_view',
                            }"
                        >
                            <list decoration-muted="scrapped == True or state == 'cancel' or (state == 'done' and is_locked == True)" string="Stock Moves">
                                <field name="company_id" column_invisible="True"/>
                                <field name="picking_id" column_invisible="True"/>
                                <field name="name" column_invisible="True"/>
                                <field name="state" readonly="0" column_invisible="True"/>
                                <field name="picking_type_id" column_invisible="True"/>
                                <field name="move_line_ids" column_invisible="True"/>
                                <field name="location_id" column_invisible="True"/>
                                <field name="location_dest_id" column_invisible="True"/>
                                <field name="partner_id" column_invisible="True" readonly="state == 'done'"/>
                                <field name="scrapped" column_invisible="True"/>
                                <field name="picking_code" column_invisible="True"/>
                                <field name="show_details_visible" column_invisible="True"/>
                                <field name="additional" column_invisible="True"/>
                                <field name="move_lines_count" column_invisible="True"/>
                                <field name="is_locked" column_invisible="True"/>
                                <field name="product_uom_category_id" column_invisible="True"/>
                                <field name="is_storable" column_invisible="True"/>
                                <field name="has_tracking" column_invisible="True"/>
                                <field name="product_id" context="{'default_is_storable': True}" required="1" readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0" force_save="1"/>
                                <field name="location_final_id" optional="hide" groups="stock.group_stock_multi_locations"/>
                                <field name="description_picking" string="Description" optional="hide"/>
                                <field name="date" optional="hide"/>
                                <field name="date_deadline" optional="hide"/>
                                <field name="is_quantity_done_editable" column_invisible="True"/>
                                <field name="show_quant" column_invisible="True"/>
                                <field name="show_lots_text" column_invisible="True"/>
                                <field name="show_lots_m2o" column_invisible="True"/>
                                <field name="is_initial_demand_editable" column_invisible="True"/>
                                <field name="display_import_lot" column_invisible="True"/>
                                <field name="picking_type_entire_packs" column_invisible="True"/>
                                <field name="product_packaging_id" groups="product.group_stock_packaging"
                                    context="{'default_product_id': product_id}"
                                    readonly="not product_id"
                                    column_invisible="True"/>
                                <field name="product_uom_qty" string="Total Qty" readonly="not is_initial_demand_editable"/>
                                <button type="object" name="action_product_forecast_report" title="Forecast Report" icon="fa-area-chart"
                                    invisible="not product_id or product_uom_qty == 0 or quantity == 0 and forecast_availability &lt;= 0 or (parent.picking_type_code == 'outgoing' and state != 'draft')"/>
                                <button type="object" name="action_product_forecast_report" title="Forecast Report" icon="fa-area-chart text-danger"
                                    invisible="not product_id or product_uom_qty == 0 or quantity &gt; 0 or forecast_availability &gt; 0 or (parent.picking_type_code == 'outgoing' and state != 'draft')"/>
                                <field name="forecast_expected_date" column_invisible="True"/>
                                <field name="forecast_availability" string="Forecast" optional="hide"
                                    column_invisible="parent.state in ('draft', 'done') or parent.picking_type_code != 'outgoing'" widget="forecast_widget"/>
                                <field name="product_qty" readonly="1" column_invisible="True"/>
                                <field name="quantity" string="Qty Diterima" readonly="not is_quantity_done_editable" column_invisible="parent.state=='draft'" decoration-danger="product_uom_qty and quantity > product_uom_qty and parent.state not in ['done', 'cancel']"/>
                                <field name="confirmation_quantity" string="Qty Diambil" readonly='1' force_save='1' />
                                <field name="product_uom" readonly="state != 'draft' and not additional" options="{'no_open': True, 'no_create': True}" string="Unit" groups="uom.group_uom"/>
                                <field name="product_uom" groups="!uom.group_uom" column_invisible="True"/>
                                <field name="picked" optional="hide" column_invisible="parent.state=='draft'"/>
                                <field name="adt_dest_location_id" string="Final Location" column_invisible="True"/>
                                <field name="difference_quantity" string="Perbedaan Qty" readonly="1" optional="show" column_invisible="parent.state=='draft'" decoration-danger="difference_quantity > 0"/>
                                <field name="lot_ids" widget="many2many_tags"
                                    readonly="has_tracking != 'serial'"
                                    column_invisible="parent.state == 'draft'"
                                    groups="stock.group_production_lot"
                                    invisible="not show_details_visible or has_tracking == 'none'"
                                    optional="show"
                                    options="{'create': [('parent.use_create_lots', '=', True)]}"
                                    context="{'default_company_id': company_id, 'default_product_id': product_id, 'active_picking_id': parent.id}"
                                    domain="[('product_id','=',product_id)]"
                                    string="LOT Number"
                                />
                                <button
                                    name="action_open_move_pick"
                                    type="object"
                                    title="Open Move"
                                    icon="fa-list"
                                    class="btn-link"
                                />
                            </list>
                        </field>
                    </page>
                </xpath>
        
        </field>
    </record>

    <record id="stock_picking_form_origin_title" model="ir.ui.view">
        <field name="name">stock.picking.form.origin.title</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority" eval="1300"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_title')]//field[@name='name']" position="replace">
                <field name="origin" placeholder="No. Dokumen" invisible="not id"/>
            </xpath>
        </field>
    </record>

    <menuitem
        id="custom_logs_menu"
        name="Logs"
        parent="stock.menu_stock_root"
        sequence="101"/>

    <menuitem
        id="menu_stock_picking_acumatica_error"
        name="Picking Import Errors"
        parent="custom_logs_menu"
        action="action_stock_picking_acumatica_error"
        sequence="10"/>

    <record id="view_stock_picking_acumatica_error_search" model="ir.ui.view">
        <field name="name">stock.picking.acumatica.error.search</field>
        <field name="model">stock.picking.acumatica.error</field>
        <field name="arch" type="xml">
            <search string="Search Acumatica Error">
                <field name="origin"/>
            </search>
        </field>
    </record>

    <record id="view_stock_picking_acumatica_error_list" model="ir.ui.view">
        <field name="name">stock.picking.acumatica.error.list</field>
        <field name="model">stock.picking.acumatica.error</field>
        <field name="arch" type="xml">
            <list>
                <field name="api_acumatica"/>
                <field name="partner"/>
                <field name="operation_type"/>
                <field name="origin"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"
                        decoration-success="state == 'resolved'"
                        decoration-warning="state == 'new'"/>
            </list>
        </field>
    </record>

    <record id="view_stock_picking_acumatica_error_form" model="ir.ui.view">
        <field name="name">stock.picking.acumatica.error.form</field>
        <field name="model">stock.picking.acumatica.error</field>
        <field name="arch" type="xml">
            <form string="Picking Import Error">

                <header>
                    <!-- <button name="action_retry"
                            string="Retry Import"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'resolved'"/>
                    <button name="action_resolve"
                            string="Mark as Resolved"
                            type="object"
                            invisible="state == 'resolved'"/> -->
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="new,resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner" readonly="1"/>
                            <field name="operation_type" readonly="1"/>
                            <field name="location" readonly="1"/>
                            <field name="location_dest" readonly="1"/>
                            <field name="api_acumatica" readonly="1"/>
                        </group>

                        <group>
                            <field name="scheduled_date" readonly="1"/>
                            <field name="origin" readonly="1"/>
                            <field name="adt_total_qty" readonly="1"/>
                            <field name="adt_actual_qty" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operations">
                            <field name="line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="inventory_id"/>
                                    <field name="product_name"/>
                                    <field name="qty"/>
                                    <field name="uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="Error">
                            <field name="error_message" readonly="1" nolabel="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_picking_form_inherit_note_ba" model="ir.ui.view">
        <field name="name">stock.picking.form.note.ba</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='note']" position="replace">
                <page name="Notes" string="Notes">
                    <group name="Transaction Notes" string="Transaction Notes">
                        <field name="note" nolabel="1"/>
                    </group>

                    <group name="BA Notes" string="BA Notes">
                        <field name="note_ba" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_quant_package_form_inherit" model="ir.ui.view">
        <field name="name">stock.quant.package.form.inherit</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='unpack']" position="after">
                <button name="action_print_packing_list" string="Print" type="object" class="btn-primary"/>
            </xpath>
            <xpath expr="//field[@name='package_type_id']" position="before">
                <field name="package_cat" />
                <field name="is_empty" invisible='1' />
            </xpath>
            <!-- <xpath expr="//field[@name='pack_date']" position="after">
                <field name="scheduled_date"/>
                <field name="origin"/>
                <field name="note" widget="html"/>
            </xpath> -->
            <xpath expr="//field[@name='quant_ids']" position="replace">
            <notebook>

                <page string="Content">
                    <field name="quant_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="lot_id" groups="stock.group_production_lot"/>
                            <field name="quantity"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                        </list>
                        <!-- <kanban class="o_kanban_mobile">
                            <templates>
                                <t t-name="card">
                                    <field name="product_id" class="fw-bold"/>
                                    <field name="lot_id"/>
                                    <div class="d-flex">
                                        <field name="quantity"/>
                                        <field class="mx-2"
                                               name="product_uom_id"
                                               groups="uom.group_uom"/>
                                    </div>
                                </t>
                            </templates>
                        </kanban> -->
                    </field>
                </page>

                <page string="Notes">
                    <field name="note" widget="html"/>
                </page>

            </notebook>

        </xpath>
        <xpath expr="//sheet/separator" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

        </field>
    </record>

    
    <record id="view_quant_package_tree_inherit" model="ir.ui.view">
        <field name="name">stock.quant.package.tree.inherit</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="%(action_generate_package_wizard)d"
                        string="Generate"
                        type="action"
                        class="btn-primary"
                        display="always"
                    />
                </header>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="after">
                <button
                    name="action_print_packing_list"
                    type="object"
                    icon="fa-print"
                    string="Print"/>
            </xpath>

        </field>
    </record>

    <record id="view_quant_package_kanban_inherit" model="ir.ui.view">
        <field name="name">stock.quant.package.kanban.inherit</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_kanban"/>
        <field name="arch" type="xml">

            <xpath expr="//kanban" position="inside">
                <header>
                    <button
                        name="%(action_generate_package_wizard)d"
                        string="Generate"
                        type="action"
                        class="btn-primary"
                        display="always"
                    />
                </header>
            </xpath>

        </field>
    </record>
</odoo>
