<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Hide Delivery print -->
     <record id="stock.action_report_delivery" model="ir.actions.report">
         <field name="binding_model_id" eval="False"/>
     </record>
  
     <record id="view_picking_form_inherit_acumatica_header" model="ir.ui.view">
        <field name="name">stock.picking.form.acumatica.header</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//button[@name='button_validate']" position="after">

                <button name="action_print_warehouse_receipt"
                string="Print Receipt"
                type="object"
                class="btn-primary"
                invisible="state != 'done' or picking_type_code != 'incoming'"/>

                <button name="action_send_email_hasil_picking"
                    string="Send Email"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'done' or picking_type_code != 'incoming'"/>
                
                <button name="action_open_stock_move_scan_wizard"
                    type="object"
                    string="Scan Product"
                    class="btn-primary"
                    invisible="state != 'assigned'"/>

                <!-- <button name="action_print_lot_number_line" string="Print Lot" type="object" class="oe_highlight" invisible="picking_type_code != 'incoming'"/> -->
            </xpath>
            <xpath expr="//page[@name='extra']//group[@name='other_infos']/field[@name='user_id']"
                position="after">
                <!-- <field name="created_by"/>
                <field name="approved_by"/> -->
                <field name="created_by_id"/>
                <field name="approved_by_id"/>
            </xpath>

            <xpath expr="//button[@name='do_print_picking']" position="attributes">
                <attribute name="invisible">state != 'assigned' or picking_type_code == 'incoming'</attribute>
            </xpath>
            
            <xpath expr="//button[@name='%(stock.action_report_delivery)d']"
                position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- <xpath expr="//button[@name='209']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath> -->

            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="sync_state" readonly="1" decoration-danger="sync_state == 'not_ready'" invisible="sync_state != 'not_ready'"/>
                <field name="sync_message" readonly="1" decoration-danger="sync_state == 'not_ready'" invisible="sync_state != 'not_ready'"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="adt_destination_location_address" invisible="adt_type != 'Sales Order Shipment'"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <!-- <field name="adt_type" readonly="1"/> -->
                <field name="adt_total_qty"/>
                <field name="adt_actual_qty"/>
                <field name="adt_dest_location_id" invisible="adt_type == 'Receipt'"/>
                <field name="all_moves_picked" invisible="1"/>
            </xpath>

            <xpath expr="//button[@name='action_put_in_pack']" position="attributes">
                <attribute name="invisible">
                    not all_moves_picked or state in ('draft', 'done', 'cancel')
                </attribute>
            </xpath>
            <xpath expr="//group[field[@name='origin']]" position="after">
                <group>

                    <field name="shipment_information" 
                    invisible="adt_type not in ('Sales Order Shipment', 'Sales Order Shipment Consignment')"
                            decoration-success="shipment_information == 'full_shipment'"
                            decoration-danger="shipment_information == 'partial'"/>
                                            <!-- decoration-success="matching == 'match'" -->
                <!-- decoration-danger="matching == 'not_match'"/> -->

                </group>
            </xpath>            
        </field>
    </record>

    <record id="view_picking_form_inherit_location_dest" model="ir.ui.view">
        <field name="name">stock.picking.form.location.dest</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='picking_type_id']"
                position="after">
                <field name="adt_type" string="Transaction Type" />

            </xpath>

            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']"
                position="replace">
                <field name="operation_category" invisible="1" />

                <!-- Default domain -->
                <field name="location_dest_id"
                    options="{'no_create': True}"
                    groups="stock.group_stock_multi_locations"
                    invisible="picking_type_code == 'internal' and operation_category == 'put'"
                    readonly="state == 'done'"/>

                <!-- Custom domain -->
                <field name="location_dest_id"
                    options="{'no_create': True}"
                    groups="stock.group_stock_multi_locations"
                    invisible="picking_type_code != 'internal' or operation_category != 'put'"
                    readonly="state == 'done'"
                    domain="[('id', 'child_of', adt_dest_location_id)]"/>

            </xpath>

        </field>
    </record>

    <record id="view_picking_form_inherit_note_ba" model="ir.ui.view">
        <field name="name">stock.picking.form.note.ba</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='note']" position="replace">
                <page name="Notes" string="Notes">
                    <group name="Transaction Notes" string="Transaction Notes">
                        <field name="note" nolabel="1"/>
                    </group>

                    <group name="BA Notes" string="BA Notes">
                        <field name="note_ba" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>


    <record id="view_stock_picking_acumatica_error_search" model="ir.ui.view">
        <field name="name">stock.picking.acumatica.error.search</field>
        <field name="model">stock.picking.acumatica.error</field>
        <field name="arch" type="xml">
            <search string="Search Acumatica Error">
                <field name="origin"/>
            </search>
        </field>
    </record>

    <record id="view_stock_picking_acumatica_error_list" model="ir.ui.view">
        <field name="name">stock.picking.acumatica.error.list</field>
        <field name="model">stock.picking.acumatica.error</field>
        <field name="arch" type="xml">
            <list>
                <field name="api_acumatica"/>
                <field name="partner"/>
                <field name="operation_type"/>
                <field name="origin"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"
                        decoration-success="state == 'resolved'"
                        decoration-warning="state == 'new'"/>
            </list>
        </field>
    </record>

    <record id="view_stock_picking_acumatica_error_form" model="ir.ui.view">
        <field name="name">stock.picking.acumatica.error.form</field>
        <field name="model">stock.picking.acumatica.error</field>
        <field name="arch" type="xml">
            <form string="Picking Import Error">

                <header>
                    <!-- <button name="action_retry"
                            string="Retry Import"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'resolved'"/>
                    <button name="action_resolve"
                            string="Mark as Resolved"
                            type="object"
                            invisible="state == 'resolved'"/> -->
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="new,resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner" readonly="1"/>
                            <field name="operation_type" readonly="1"/>
                            <field name="location" readonly="1"/>
                            <field name="location_dest" readonly="1"/>
                            <field name="api_acumatica" readonly="1"/>
                        </group>

                        <group>
                            <field name="scheduled_date" readonly="1"/>
                            <field name="origin" readonly="1"/>
                            <field name="adt_total_qty" readonly="1"/>
                            <field name="adt_actual_qty" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operations">
                            <field name="line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="inventory_id"/>
                                    <field name="product_name"/>
                                    <field name="qty"/>
                                    <field name="uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="Error">
                            <field name="error_message" readonly="1" nolabel="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem
        id="custom_logs_menu"
        name="Logs"
        parent="stock.menu_stock_root"
        sequence="101"/>

    <menuitem
        id="menu_stock_picking_acumatica_error"
        name="Picking Import Errors"
        parent="custom_logs_menu"
        action="action_stock_picking_acumatica_error"
        sequence="10"/>

    <record id="view_picking_form_inherit_acumatica_receipt" model="ir.ui.view">
        <field name="name">stock.picking.form.acumatica.receipt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Acumatica">
                    <group>
                        <group>
                            <field name="adt_receipt_nbr"/>
                            <field name="adt_vendor_code"/>
                            <field name="adt_partner_ref"/>
                            <field name="adt_branch_warehouse"/>
                            <field name="adt_actual_qty"/>
                            <field name="adt_is_hold"/>
                            <field name="adt_inventory_ref"/>
                            <field name="adt_acumatica_write_date"/>
                        </group>
                        <group>
                            <field name="adt_header_location_code"/>
                            <field name="adt_post_period"/>
                            <field name="adt_status"/>
                            <field name="adt_total_qty"/>
                            <field name="adt_type"/>
                            <field name="adt_warehouse_code"/>
                            <field name="adt_external_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="email_template_stock_picking_custom" model="mail.template">
        <field name="name">Email Picking Custom</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="subject">Lampiran Berita Acara</field>
        <field name="email_to"></field>
        <field name="body_html">
            <![CDATA[
                <p>Yth. Bapak/Ibu,</p>
                <p>Berikut kami lampirkan dokumen Berita Acara untuk dapat ditindaklanjuti sebagaimana mestinya.</p>
                <p>Terima kasih atas perhatian Bapak/Ibu.</p>
            ]]>
        </field>
    </record>

    <record id="stock_picking_view_adt_type_inherit" model="ir.ui.view">
        <field name="name">stock.picking.view.adt.type.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="replace">
                <field name="adt_type" />
                <field name="name" />
                <field name="origin" string="Transaction Type" />
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_inherit_change_lot_ids_label" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.change.lot.ids.label</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_ids_without_package']//field[@name='lot_ids']" position="attributes">
                <attribute name="string">Lot / Serial Number</attribute>
            </xpath>

        </field>
    </record>

</odoo>
