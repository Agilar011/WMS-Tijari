<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="internal_transfer_order_view_list" model="ir.ui.view">
        <field name="name">internal.transfer.order.list</field>
        <field name="model">internal.transfer.order</field>
        <field name="arch" type="xml">
            <list string="Internal Transfer Orders">
                <field name="name"/>
                <field name="external_ref" optional="hide"/>
                <field name="external_ref_in" optional="hide"/>
                <field name="external_ref_out" optional="hide"/>
                <field name="transaction_type"/>
                <field name="transfer_type"/>
                <field name="adt_transaction_type" optional="hide"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="schedule_date"/>
                <field name="validation_policy"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'ready'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="internal_transfer_order_view_form" model="ir.ui.view">
        <field name="name">internal.transfer.order.form</field>
        <field name="model">internal.transfer.order</field>
        <field name="arch" type="xml">
            <form string="Internal Transfer Order">
                <header>
                    <button name="action_ready" string="Mark As To Do" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Validate" type="object"
                        class="btn-primary" invisible="state != 'ready'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                        invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,ready,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object"
                            class="oe_stat_button" icon="fa-truck"
                            invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="transaction_type"/>
                            <field name="transfer_type" invisible="1"/>
                            <field name="adt_transaction_type" string="Tipe Transaksi" readonly="1"
                                invisible="transaction_type == 'intra_warehouse' and intra_transfer_type == 'intra_group_transfer'"/>
                            <field name="partner_id"
                                string="Warehouse Partner"
                                invisible="transaction_type != 'inter_warehouse'"
                                readonly="1"
                                options="{'no_create': True, 'no_open': True}"/>
                            <field name="inter_transfer_type"
                                invisible="transaction_type != 'inter_warehouse'"/>
                            <field name="intra_transfer_type"
                                invisible="transaction_type != 'intra_warehouse'"/>
                            <field name="location_group_id"
                                invisible="transaction_type != 'intra_warehouse' or intra_transfer_type == 'inter_group_transfer'"
                                required="transaction_type == 'intra_warehouse' and intra_transfer_type != 'inter_group_transfer'"
                                readonly="state == 'ready'"
                                options="{'no_create': True}"/>
                            <field name="external_ref" invisible="1"/>
                            <field name="available_source_product_ids" invisible="1"/>
                            <field name="external_ref" string="Source Document"/>
                            <field name="external_ref_in" invisible="1"/>
                            <field name="external_ref_out" invisible="1"/>
                        </group>
                        <group>
                            <field name="location_id"
                                invisible="intra_transfer_type == 'intra_group_transfer'"
                                readonly="state == 'ready'"/>
                            <field name="source_location_scan_code"
                                widget="adt_handheld_scan_code"
                                invisible="transaction_type != 'intra_warehouse' or intra_transfer_type != 'intra_group_transfer'"
                                readonly="state == 'ready'"/>
                            <field name="intra_location_id"
                                invisible="intra_transfer_type != 'intra_group_transfer'"
                                readonly="state == 'ready'"
                                domain="[('id', 'child_of', location_group_id)]"/>
                            <field name="location_dest_id"
                                invisible="intra_transfer_type == 'intra_group_transfer'"
                                readonly="state == 'ready'"/>
                            <field name="destination_location_scan_code"
                                widget="adt_handheld_scan_code"
                                invisible="transaction_type != 'intra_warehouse' or intra_transfer_type != 'intra_group_transfer'"
                                readonly="state == 'ready'"/>
                            <field name="intra_location_dest_id"
                                invisible="intra_transfer_type != 'intra_group_transfer'"
                                readonly="state == 'ready'"
                                domain="[('id', 'child_of', location_group_id)]"/>
                            <field name="transit_location_id"/>
                            <field name="schedule_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transfer" name="page_transfers">
                            <field name="picking_ids" widget="many2many" mode="list,kanban"
                                context="{
                                    'form_view_ref': 'stock_picking_batch.view_picking_form_inherited',
                                    'list_view_ref': 'tijari_wms_18.stock_picking_batch_transaction_tree_columns'
                                }"
                                readonly="1"/>
                        </page>
                        <page string="Operation" name="page_operations">
                            <field name="move_ids"
                                mode="list,kanban"
                                readonly="picking_count != 0"
                                context="{
                                    'form_view_ref': 'tijari_wms_18.internal_transfer_order_move_form',
                                    'default_internal_transfer_order_id': id,
                                    'default_location_id': location_id,
                                    'default_location_dest_id': location_dest_id,
                                    'default_date': schedule_date
                                }">
                                <list editable="bottom">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="name" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="location_id" column_invisible="1"/>
                                    <field name="location_dest_id" column_invisible="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="internal_transfer_order_id" column_invisible="1"/>
                                    <field name="internal_transfer_product_scan_code"
                                        widget="adt_handheld_scan_code"
                                        string="Scan Product"
                                        placeholder="Scan barcode / product code"
                                        groups="tijari_wms_18.group_operator"/>
                                    <field name="product_id"
                                        context="{'tijari_stock_picking_product_code_only': True}"
                                        domain="[('id', 'in', parent.available_source_product_ids)] if parent.transaction_type == 'intra_warehouse' and parent.intra_transfer_type == 'intra_group_transfer' else []"
                                        required="1"/>
                                    <field name="product_uom_qty" string="Demand"/>
                                    <field name="product_uom" string="UoM"
                                        groups="uom.group_uom"
                                        options="{'no_open': True, 'no_create': True}"/>
                                    <field name="lot_ids" widget="many2many_tags"
                                        string="Lot/Serial Number"
                                        groups="stock.group_production_lot"/>
                                </list>
                                <kanban>
                                    <field name="product_id"/>
                                    <field name="internal_transfer_product_scan_code"
                                        groups="tijari_wms_18.group_operator"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom" groups="uom.group_uom"/>
                                    <field name="lot_ids" groups="stock.group_production_lot"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click">
                                                <div class="fw-bold fs-5">
                                                    <field name="product_id"/>
                                                </div>
                                                <div class="mt-2">
                                                    <field name="internal_transfer_product_scan_code"
                                                        widget="adt_handheld_scan_code"
                                                        placeholder="Scan barcode / product code"
                                                        groups="tijari_wms_18.group_operator"/>
                                                </div>
                                                <div class="mt-2">
                                                    <span class="text-muted">Demand: </span>
                                                    <field name="product_uom_qty"/>
                                                    <field name="product_uom" groups="uom.group_uom"/>
                                                </div>
                                                <div class="mt-2" groups="stock.group_production_lot">
                                                    <span class="text-muted">Lot/Serial: </span>
                                                    <field name="lot_ids" widget="many2many_tags"
                                                        groups="stock.group_production_lot"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Notes" name="page_notes">
                            <group name="description" string="Description">
                                <field name="description" nolabel="1"/>
                            </group>
                            <group name="transaction_notes" string="Transaction Notes">
                                <field name="note" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Compact operation editor used only by the ITO move_ids field. -->
    <record id="internal_transfer_order_move_form" model="ir.ui.view">
        <field name="name">internal.transfer.order.move.form</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form string="Operation">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="name" invisible="1"/>
                    <field name="location_id" invisible="1"/>
                    <field name="location_dest_id" invisible="1"/>
                    <field name="product_uom_category_id" invisible="1"/>
                    <field name="internal_transfer_order_id" invisible="1"/>
                    <group>
                        <field name="internal_transfer_product_scan_code"
                            widget="adt_handheld_scan_code"
                            string="Scan Product"
                            placeholder="Scan barcode / product code"
                            groups="tijari_wms_18.group_operator"/>
                        <field name="product_id"
                            context="{'tijari_stock_picking_product_code_only': True}"
                            domain="[('id', 'in', internal_transfer_order_id.available_source_product_ids)] if internal_transfer_order_id.transaction_type == 'intra_warehouse' and internal_transfer_order_id.intra_transfer_type == 'intra_group_transfer' else []"
                            required="1"/>
                        <label for="product_uom_qty" string="Demand"/>
                        <div class="o_row">
                            <field name="product_uom_qty"/>
                            <field name="product_uom" string="UoM"
                                groups="uom.group_uom"
                                options="{'no_open': True, 'no_create': True}"/>
                        </div>
                        <field name="lot_ids" widget="many2many_tags"
                            string="Lot/Serial Number"
                            groups="stock.group_production_lot"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="internal_transfer_order_view_search" model="ir.ui.view">
        <field name="name">internal.transfer.order.search</field>
        <field name="model">internal.transfer.order</field>
        <field name="arch" type="xml">
            <search string="Internal Transfer Orders">
                <field name="name"/>
                <field name="transaction_type"/>
                <field name="transfer_type"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Ready" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Transaction Type" name="group_transaction_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="Transfer Type" name="group_transfer_type" context="{'group_by': 'transfer_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_internal_transfer_order" model="ir.actions.act_window">
        <field name="name">Internal Transfer Orders</field>
        <field name="res_model">internal.transfer.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_ready': 1}</field>
    </record>

</odoo>
