<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_form_note_button" model="ir.ui.view">
        <field name="name">stock.picking.form.note.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="after">

                <button
                    name="action_open_note_wizard"
                    type="object"
                    icon="fa-sticky-note"
                    title="Note"/>

            </xpath>

        </field>
    </record>

</odoo>