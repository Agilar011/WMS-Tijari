<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_nosuggest_form_inherit_tjr_fifo_standard" model="ir.ui.view">
        <field name="name">stock.move.line.list.tjr.fifo</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">

            <!-- First row of detailed stock_move_line outbound - pick -->
            <xpath expr="//field[@name='quant_id']" position="before">
                <field name="picking_type_name" column_invisible="1" />
                <!-- <field name="id" string="Line ID" column_invisible="picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components']"/> -->
                <!-- <field name="id" string="Line ID" optional="hide"/> -->
                <!-- <field name="adt_owner_id" string="Owner" column_invisible="0"/> -->
                <!-- <field name="adt_dest_location" readonly="1" optional="hide" column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components']"/> -->
                <!-- <field name="product_lot_id" string="Lot" column_invisible="parent.picking_type_name not in ['Pack', 'Pick', 'Pick Internal', 'Pick Components']" force_save='1'/> -->
                <field name="adt_dest_location_id" readonly="1" optional="hide" column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components']"/>
                <field 
                    name="lot_id" 
                    string="Lot" 
                    domain="[('id', 'in', available_lot_ids)]" 
                    column_invisible="parent.picking_type_name not in ['Pack', 'Pack Internal', 'Pick', 'Pick Internal', 'Pick Components', 'Internal Transfers', 'Internal Transfer', 'Transfer Internal', 'Manufacturing']"
                    force_save='1'/>
                <!-- <field name="parent_location_id" readonly="1" optional="hide" column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components']"/> -->
                <!-- <field name="quant_id" optional="hide"/> -->
                <!-- <field name="source_location_id" context="{'show_location_short_name': True}" string="Pick From" column_invisible="parent.picking_type_name not in ['Pack','Pick', 'Pick Internal', 'Pick Components']" force_save="1"/> -->
                <field 
                    name="location_id" 
                    domain="[('id', 'in', available_location_ids)]" 
                    context="{'show_location_short_name': True}" 
                    widget="location_short_many2one"
                    string="Pick From" 
                    column_invisible="parent.picking_type_name not in ['Pack','Pick', 'Pick Internal', 'Pick Components', 'Internal Transfers', 'Internal Transfer', 'Transfer Internal', 'Manufacturing']"
                    force_save="1"/>
                <field name="temp_quant_ids" optional="hide" column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components']"/>
                <field name="temp_lot_ids" optional="hide" column_invisible="1"/>
                <!-- <field name="product_lot_id" string="Lot" column_invisible="parent.picking_type_name not in ['Pack', 'Pick', 'Pick Internal', 'Pick Components']"/> -->
                <field name="selected_quant_id" optional="hide" column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components']"/>
                <field name="available_lot_ids" column_invisible='1' />
                <field name="available_location_ids" column_invisible='1' />
            </xpath>

            <!-- Hide From To defaul_odoo for outbound- pick -->
            <xpath expr="//field[@name='quant_id']" position="replace">
                <field name="quant_id" domain="[('id', 'in', temp_quant_ids)]" column_invisible="parent.picking_type_name in ['Pack', 'Pick', 'Pick Internal', 'Pack Internal', 'Receipts', 'Receipt Internal', 'Storage', 'Pick Components', 'Internal Transfers', 'Internal Transfer', 'Transfer Internal', 'Manufacturing']"/>
            </xpath>

            <xpath expr="//field[@name='result_package_id'][not(@column_invisible)]" position="attributes">
                <attribute name="domain">
                    (company_id and [('company_id', 'in', [company_id] + [False])] or [('company_id', '=', False)]) + [
                        '|',
                        ('location_id', '=', False),
                        ('location_id', '=', location_dest_id),
                        ('id', '!=', package_id),
                        ('package_cat', '=', 'box'),
                        ('is_empty', '=', True)
                    ]
                </attribute>
                <attribute name="column_invisible">parent.picking_type_name != "Pack"</attribute>
            </xpath>
            
           <xpath expr="//field[last()]" position="after">

                <field name="picking_id" optional="hide" />
                <field 
                    name="matching_lot_id" 
                    column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components', 'Internal Transfers', 'Internal Transfer', 'Transfer Internal', 'Manufacturing']"
                    force_save="1"/>
                <field 
                    name="matching_loc_dest_id" 
                    column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components', 'Internal Transfers', 'Internal Transfer', 'Transfer Internal']"
                    force_save="1"/>
                <field name="matching" column_invisible="1" force_save="1" />
                <field name="picker_status" column_invisible="1" force_save="1" />
                <field name="putaway_status" column_invisible="1" force_save="1" />

                <field 
                    name="second_matching"
                    decoration-success="second_matching == 'Match'"
                    decoration-danger="second_matching == 'Not Match'" 
                    column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Pick Components', 'Internal Transfers', 'Internal Transfer', 'Transfer Internal', 'Manufacturing']"
                    readonly="1" 
                    force_save="1"/>

            </xpath>

           <xpath expr="//field[last()]" position="after">
                <field name="confirmation_lot_code"
                        string=""
                        widget="adt_scan_lot_button"
                        readonly="1"
                        invisible="matching == 'match'"
                        column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Internal Transfers', 'Internal Transfer', 'Transfer Internal', 'Manufacturing']"/>

                <field name="confirmation_location_code"
                        string=""
                        widget="adt_scan_location_button"
                        readonly="1"
                        invisible="matching == 'match'"
                        column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal', 'Internal Transfers', 'Internal Transfer', 'Transfer Internal']"/>
                <!-- <field name="second_matching" column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal']" /> -->
                <!-- <field name="third_matching" column_invisible="parent.picking_type_name not in ['Pick', 'Pick Internal']" /> -->
            </xpath>

<!-- ============================================================================================================ -->
<!-- please dont use view below, its better to adjust view above -->

            <!-- Lock lot fields -->
            <!-- <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath> -->

            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Tombol custom -->
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="operation_category" column_invisible="1"/>
                <field name="lot_name" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']"
                            position="after">

                <!-- <field name="location_dest_id"
                    domain="[('id', 'child_of', adt_dest_location_id)]" 
                    context="{'show_location_short_name': True}"
                /> -->
                <!-- <field name="allocation_storage" column_invisible="parent.picking_code != 'incoming'" domain="[('id', 'child_of', adt_dest_location_id)]" /> -->
                <!-- <field name="adt_location_id" optional="show" column_invisible="parent.name != 'Pick'" /> -->
                <field name="allowed_matching_lot_ids" column_invisible="1"/>
                <field name="matching_lot_id" column_invisible="1" force_save="1" domain="[('id', 'in', allowed_matching_lot_ids)]"/>
                <field name="matching_loc_dest_id" column_invisible="1" force_save="1" domain="[('id', 'child_of', adt_dest_location_id)]"/>

            </xpath>

            <xpath expr="//field[@name='location_dest_id']" position="replace">

                <field name="location_dest_id" widget="location_short_many2one" column_invisible="1" force_save="1" context="{'show_location_short_name': True}"/>
                <field name="adt_dest_location_id" optional="show" column_invisible="parent.picking_code != 'incoming'" />
                <field name="allowed_matching_lot_ids" column_invisible="1"/>
                <field name="matching_lot_id" column_invisible="1" force_save="1" domain="[('id', 'in', allowed_matching_lot_ids)]"/>
                <field name="matching_loc_dest_id" column_invisible="1" force_save="1" domain="[('id', 'child_of', adt_dest_location_id)]"/>

            </xpath>

        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list/field[1]" position="before">
                <header>
                    <button name="action_generate_selected_lot"
                        type="object"
                        string="Generate Lot"
                        class="btn-warning"/>
                </header>
            </xpath>

            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="adt_dest_location_id" optional="hide" />
            </xpath>

            <xpath expr="//field[@name='quantity']" position="replace">
                <field name="confirmation_quantity"
                    string="Quantity"
                    readonly="state in ('done', 'cancel') and is_locked"
                    force_save="1"
                    column_invisible="context.get('picking_type_name') not in ['Receipts', 'Receipt Internal', 'Storage', 'Store Finished Product']"/>
                <field name="quantity"
                    string="Quantity"
                    readonly="state in ('done', 'cancel') and is_locked"
                    force_save="1"
                    column_invisible="context.get('picking_type_name') in ['Receipts', 'Receipt Internal', 'Storage', 'Store Finished Product']"/>
            </xpath>

        </field>
    </record>

    <record id="view_move_line_form_inherit_tijari" model="ir.ui.view">
        <field name="name">stock.move.line.form.inherit.tijari</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet" position="replace">
                <sheet>

                    <!-- Technical fields -->
                    <field name="company_id" invisible="1"/>
                    <field name="picking_id" invisible="1"/>
                    <field name="location_dest_id" invisible="1"/>
                    <field name="package_id" invisible="1"/>
                    <field name="product_uom_category_id" invisible="1"/>
                    <field name="tracking" invisible="1"/>
                    <field name="available_lot_ids" invisible="1"/>
                    <field name="adt_dest_location_id" invisible="1"/>
                    <field name="allowed_matching_lot_ids" invisible="1"/>
                    <field name="matching" invisible="1"/>
                    <field name="is_manufacturing" invisible="1"/>
                    <field name="picking_type_name" invisible="1"/>


                    <!-- ===================================================== -->
                    <!-- Scan Buttons -->
                    <!-- ===================================================== -->

                    <div class="row mb-3 g-2"
                        invisible="is_manufacturing">

                        <div class="col-6 d-flex justify-content-center">

                            <field name="confirmation_location_code"
                                widget="adt_scan_location_form_button"
                                readonly="1"
                                invisible="matching == 'match' or 'Pick' not in (picking_type_name or '')"/>

                            <field name="confirmation_package_code"
                                widget="adt_scan_package_form_button"
                                readonly="1"
                                invisible="state in ('done', 'cancel') or 'Pack' not in (picking_type_name or '')"/>

                        </div>

                        <div class="col-6 d-flex justify-content-center">

                            <field name="confirmation_lot_code"
                                widget="adt_scan_lot_form_button"
                                readonly="1"
                                invisible="matching == 'match' or 'Pick' not in (picking_type_name or '')"/>

                        </div>

                    </div>


                    <!-- ===================================================== -->
                    <!-- Manufacturing Scan -->
                    <!-- ===================================================== -->

                    <div class="row mb-3 g-2"
                        invisible="not is_manufacturing">

                        <div class="col-6 d-flex justify-content-center">

                            <field name="confirmation_lot_code"
                                widget="adt_scan_lot_form_button"
                                readonly="1"
                                invisible="matching == 'match'"/>

                        </div>

                    </div>


                    <!-- ===================================================== -->
                    <!-- Product -->
                    <!-- ===================================================== -->

                    <group>
                        <label for="product_id" string="Product"/>

                        <field name="product_id"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            class="fw-bold fs-6"/>
                    </group>


                    <!-- ===================================================== -->
                    <!-- LOT Number -->
                    <!-- ===================================================== -->

                    <group groups="stock.group_production_lot"
                        invisible="tracking == 'none' or (not lot_id and not lot_name)">

                        <label for="lot_id" string="LOT Number"/>

                        <field name="lot_id"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            class="fw-bold fs-6"
                            invisible="not lot_id"
                            domain="[('id', 'in', available_lot_ids)]"/>
                        <field name="lot_name"
                            string="LOT Number"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            class="fw-bold fs-6"
                            invisible="lot_id or not lot_name"/>

                    </group>

                    <!-- ===================================================== -->
                    <!-- Pick From -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing or (
                        'Pack' in (picking_type_name or '')
                        or 'Receipts' in (picking_type_name or '')
                    )">

                        <label for="location_id" string="Pick From"/>

                        <field name="location_id"
                            widget="location_short_many2one"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            context="{'show_location_short_name': True}"
                            class="fw-bold fs-6"/>

                    </group>

                    <!-- ===================================================== -->
                    <!-- Handheld Scan - Normal Operation -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing or (
                        'Pick' not in (picking_type_name or '')
                        and 'Pack' not in (picking_type_name or '')
                        and 'Storage' not in (picking_type_name or '')
                        and 'Store Finished Product' not in (picking_type_name or '')
                    )">

                        <label for="handheld_scan_code"
                            string="Scan Handheld"/>

                        <field name="handheld_scan_code"
                            widget="adt_handheld_scan_code"
                            placeholder="Scan handheld: lot, lokasi, atau package"
                            nolabel="1"
                            class="fw-bold fs-6"/>

                    </group>

                    <group invisible="1">

                        <label for="location_dest_id"
                            string="Store To"/>

                        <field name="location_dest_id"
                            nolabel="1"
                            class="fw-bold fs-6"/>

                    </group>


                    <!-- Storage confirmations are shown in the shared form
                         used by both administrators and Group Operation. -->
                    <group invisible="is_manufacturing or picking_type_name not in ('Storage', 'Store Finished Product')">

                        <label for="matching_lot_id" string="Confirmation Lot"/>

                        <field name="matching_lot_id"
                            force_save="1"
                            nolabel="1"
                            domain="[('id', 'in', allowed_matching_lot_ids)]"
                            class="fw-bold fs-6"/>

                    </group>

                    <group invisible="is_manufacturing or picking_type_name not in ('Storage', 'Store Finished Product')">

                        <label for="location_putaway_id" string="Confirmation Location"/>

                        <field name="location_putaway_id"
                            force_save="1"
                            nolabel="1"
                            domain="[('id', 'child_of', adt_dest_location_id)]"
                            context="{'show_location_short_name': True}"
                            class="fw-bold fs-6"/>

                    </group>


                    <!-- ===================================================== -->
                    <!-- Handheld Scan - Manufacturing -->
                    <!-- ===================================================== -->

                    <!-- <group invisible="not is_manufacturing"> -->
                    <group invisible="1">

                        <label for="handheld_scan_code"
                            string="Scan Handheld"/>

                        <field name="handheld_scan_code"
                            widget="adt_handheld_scan_code"
                            placeholder="Scan handheld: lot atau lokasi"
                            nolabel="1"
                            class="fw-bold fs-6"/>

                    </group>


                    <!-- ===================================================== -->
                    <!-- Confirm LOT - Normal Pick -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing or 'Pick' not in (picking_type_name or '')">

                        <label for="matching_lot_id"
                            string="Confirm LOT"/>

                        <field name="matching_lot_id"
                            force_save="1"
                            nolabel="1"
                            domain="[('id', 'in', allowed_matching_lot_ids)]"
                            class="fw-bold fs-6"/>

                    </group>


                    <!-- ===================================================== -->
                    <!-- Confirm LOT - Manufacturing -->
                    <!-- ===================================================== -->

                    <!-- <group invisible="not is_manufacturing"> -->
                    <group invisible="1">

                        <label for="matching_lot_id"
                            string="Confirm LOT"/>

                        <field name="matching_lot_id"
                            force_save="1"
                            nolabel="1"
                            domain="[('id', 'in', allowed_matching_lot_ids)]"
                            class="fw-bold fs-6"/>

                    </group>


                    <!-- ===================================================== -->
                    <!-- Package - Normal Pack -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing or 'Pack' not in (picking_type_name or '')">

                        <label for="result_package_id"
                            string="Destination Packages"/>

                        <field name="result_package_id"
                            force_save="1"
                            nolabel="1"
                            domain="[('package_cat', '=', 'box'), ('is_empty', '=', True)]"/>
                            
                        <label for="product_uom_qty"
                            string="Qty Total"/>

                        <div class="o_row">

                            <field name="product_uom_qty"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                class="fw-bold fs-6"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div>
                    </group>


                    <!-- ===================================================== -->
                    <!-- Manufacturing Pick From -->
                    <!-- ===================================================== -->

                    <group invisible="not is_manufacturing">

                        <label for="location_id" string="Pick From"/>

                        <field name="location_id"
                            widget="location_short_many2one"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            context="{'show_location_short_name': True}"
                            class="fw-bold fs-6"/>

                    </group>


                    <!-- ===================================================== -->
                    <!-- Confirm Location - Normal Pick -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing or 'Pick' not in (picking_type_name or '')">

                        <label for="matching_loc_dest_id"
                            string="Confirm Location"/>

                        <field name="matching_loc_dest_id"
                            force_save="1"
                            nolabel="1"
                            domain="[('id', 'child_of', adt_dest_location_id)]"
                            class="fw-bold fs-6"/>

                    </group>


                    <!-- ===================================================== -->
                    <!-- Qty Total - Normal -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing or 'Pack' in (picking_type_name or '')">

                        <label for="product_uom_qty"
                            string="Total Qty"/>

                        <div class="o_row">

                            <field name="product_uom_qty"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                class="fw-bold fs-6"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div>
                        <label for="quantity"
                            string="Qty Unpack"
                            invisible="'Delivery Orders' not in (picking_type_name or '')"/>

                        <div class="o_row" invisible="'Delivery Orders' not in (picking_type_name or '')">

                            <field name="quantity"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                class="fw-bold fs-6"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div>
                        <label for="so_confirmation_quantity"
                            string="Qty Dikirim"
                            invisible="'Delivery Orders' not in (picking_type_name or '')"/>

                        <div class="o_row" invisible="'Delivery Orders' not in (picking_type_name or '')">

                            <field name="so_confirmation_quantity"
                                nolabel="1"
                                class="fw-bold fs-6"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div>
                    </group>

                    <group invisible="picking_type_name not in ('Receipts', 'Receipt Internal')">
                        <label for="remaining_picker_quantity" string="Sisa Qty Pick"/>
                        <div class="o_row">
                            <field name="remaining_picker_quantity" readonly="1" nolabel="1" class="fw-bold fs-6"/>
                            <field name="product_uom_id" readonly="1" force_save="1" nolabel="1"
                                options="{'no_create': True}" groups="uom.group_uom"/>
                        </div>
                    </group>


                    <!-- ===================================================== -->
                    <!-- Saran Qty / Quantity / Qty Diterima -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing">

                        <label for="quantity"
                            string="Available Qty"
                            invisible="'Pick' not in (picking_type_name or '')"/>

                        <label for="quantity"
                            string="Quantity"
                            invisible="'Pack' not in (picking_type_name or '')"/>

                        <label for="quantity"
                            string="Qty Diterima"
                            invisible="'Receipts' not in (picking_type_name or '')"/>

                        <div class="o_row">

                            <field name="quantity"
                                nolabel="1"
                                force_save="1"
                                class="fw-bold fs-6"
                                readonly="picker_status == 'finished' or state in ('done', 'cancel')"
                                invisible="'Pack' not in (picking_type_name or '') and 'Receipts' not in (picking_type_name or '')"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"
                                invisible="'Pick' not in (picking_type_name or '') and 'Pack' not in (picking_type_name or '') and 'Receipts' not in (picking_type_name or '')"/>

                        </div>

                    </group>


                    <!-- ===================================================== -->
                    <!-- Qty Diambil - Normal -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing or (
                        'Pack' in (picking_type_name or '')
                        or 'Receipts' in (picking_type_name or '')
                        or 'Delivery Orders' in (picking_type_name or '')
                    )">

                        <label for="confirmation_quantity"
                            string="Qty Diambil"/>

                        <div class="o_row">

                            <field name="confirmation_quantity"
                                nolabel="1"
                                class="fw-bold fs-6"/>
                            
                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div>

                    </group>

                    
                    <!-- ===================================================== -->
                    <!-- Qty Dikirim dan Unpack - Normal -->
                    <!-- ===================================================== -->

                    <group invisible="is_manufacturing or (
                        'Delivery Orders' not in (picking_type_name or '')
                    )">

                        <!-- <label for="so_confirmation_quantity"
                            string="Qty Dikirim"/>

                        <div class="o_row">

                            <field name="so_confirmation_quantity"
                                nolabel="1"
                                class="fw-bold fs-6"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div> -->

                    </group>


                    <!-- ===================================================== -->
                    <!-- MANUFACTURING -->
                    <!-- ===================================================== -->

                    <group invisible="not is_manufacturing">

                        <label for="product_uom_qty"
                            string="To Consume"/>

                        <div class="o_row">

                            <field name="product_uom_qty"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                class="fw-bold fs-6"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div>

                    </group>


                    <group invisible="not is_manufacturing">

                        <label for="quantity"
                            string="Qty Target"/>

                        <div class="o_row">

                            <field name="quantity"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                class="fw-bold fs-6"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div>

                    </group>


                    <group invisible="not is_manufacturing">

                        <label for="mo_confirmation_quantity"
                            string="Qty Digunakan"/>

                        <div class="o_row">

                            <field name="mo_confirmation_quantity"
                                nolabel="1"
                                class="fw-bold fs-6"/>

                            <field name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                nolabel="1"
                                options="{'no_create': True}"
                                groups="uom.group_uom"/>

                        </div>

                    </group>

                </sheet>
            </xpath>

        </field>
    </record>

    <record id="view_move_line_mobile_form_picker_save" model="ir.ui.view">
        <field name="name">stock.move.line.mobile.form.picker.save</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_mobile_form"/>
        <field name="priority">1100</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="picking_type_name" invisible="1"/>
                <field name="mo_status" invisible="1"/>
                <field name="picker_status" invisible="1"/>
                <field name="pick_status" invisible="1"/>
                <field name="status_check" invisible="1"/>
                <field name="is_manufacturing" invisible="1"/>
            </xpath>
            <xpath expr="//form" position="inside">
                <footer> 
                    <button 
                        name="action_save_picker_details"
                        type="object"
                        string="Save &amp; Confirm"
                        class="btn-primary"
                        invisible="
                            (picking_type_name == 'Receipts' and picker_status == 'finished')
                            or
                            (picking_type_name in ['Pick', 'Pick Components'] and pick_status == 'finished')
                            or
                            (picking_type_name == 'Delivery Orders' and status_check == 'finished')
                            or
                            (is_manufacturing and mo_status == 'finished')"
                    />
                    <button 
                        name="action_rollback_details"
                        type="object"
                        string="Rollback"
                        class="btn-danger"
                        invisible="
                            (picking_type_name == 'Receipts' and picker_status != 'finished')
                            or
                            (picking_type_name in ['Pick', 'Pick Components'] and pick_status != 'finished')
                            or
                            (picking_type_name == 'Delivery Orders' and status_check != 'finished')
                            or
                            (picking_type_name == 'Pack')
                            or
                            (is_manufacturing and mo_status != 'finished')"
                        />
                    <button 
                        name="action_discard_details"
                        type="object"
                        string="Discard"
                        class="btn-secondary"
                        invisible="(picking_type_name == 'Receipts' and picker_status != 'finished')"
                        />

                    <!-- <button name="action_save_picker_details"
                        type="object"
                        string="Save"
                        class="btn-primary"
                        invisible="picking_type_name != 'Receipts' or  picker_status == 'finished'"/>
                    <button name="action_save_picker_details"
                        type="object"
                        string="Save"
                        class="btn-primary"
                        invisible="picking_type_name == 'Receipts' or mo_status == 'finished' or (picker_status == 'finished' and not is_manufacturing)"/>
                    <button name="action_rollback_details"
                        type="object"
                        string="Rollback"
                        class="btn-danger"
                        invisible="picking_type_name != 'Receipts' or picker_status == 'unfinished'"/>
                    <button name="action_rollback_details"
                        type="object"
                        string="Rollback"
                        class="btn-danger"
                        invisible="picking_type_name == 'Receipts' or mo_status == 'unfinished' or (picker_status == 'unfinished' and not is_manufacturing)"/> -->
                    
                    <button name="action_delete_picker_line"
                        confirm="Apakah Anda yakin ingin menghapus data penerimaan ini? Pastikan penghapusan telah dikonfirmasi terlebih dahulu kepada user Putaway"
                        type="object"
                        string="Delete"
                        invisible="picking_type_name != 'Receipts' or state in ['done', 'cancel']"/>
                    <!-- <button special="cancel"
                        string="Discard"
                        class="btn-secondary"/> -->
                </footer>
            </xpath>
        </field>
    </record>

    <record id="action_generate_selected_lot_server" model="ir.actions.server">
        <field name="name">Generate Lot</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="binding_model_id" ref="stock.model_stock_move_line"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_generate_selected_lot()</field>
    </record>

</odoo>
