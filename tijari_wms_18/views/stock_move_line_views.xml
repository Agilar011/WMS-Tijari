<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_line_inventory_tree" model="ir.ui.view">
        <field name="name">stock.move.line.tree.view.inventory</field>
        <field name="model">stock.move.line</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="quantity"/>
                <field name="company_id" optional="hide"/>
                <field name="reference" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_view_stock_move_line_inventory_tree" model="ir.actions.act_window">
        <field name="name">Stock Move Lines</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_stock_move_line_inventory_tree" />
    </record>

    <record id="view_move_line_nosuggest_form_inherit_tjr_fifo_standard" model="ir.ui.view">
        <field name="name">stock.move.line.list.tjr.fifo</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">

            <!-- First row of detailed stock_move_line -->
            <xpath expr="//field[@name='quant_id']" position="before">
                <field name="id" string="Line ID" />
                <field name="adt_dest_location_id" optional="show"/>

                <!-- <field name="unfiltered_dest"/> -->
                <!-- <field string="Unfiltered To" name="quant_unfiltered_id" domain="[('product_id', '=', product_id)]" column_invisible="parent.unfiltered_dest"/> -->
                <field name="parent_location_id" readonly="1" optional="hide"/>
                <field name="source_location_id"/>
                <field name="temp_quant_ids" optional="hide"/>
                <field name="product_lot_id"/>
                <field name="selected_quant_id" optional="hide"/>
            </xpath>

            <!-- Hide From To defaul_odoo -->
            <xpath expr="//field[@name='quant_id']" position="replace">
                <field name="quant_id" column_invisible="parent.picking_type_name == 'Pick'"/>
            </xpath>
            
           <xpath expr="//field[last()]" position="after">
                <!-- <field name="auto_input_code" widget="auto_input_code"
                    column_invisible="context.get('picking_code') == 'incoming'" readonly="state in ('done', 'cancel') and is_locked"/> -->

                <button name="action_prepare_scan_lot"
                        type="object"
                        icon="fa-barcode"
                        title="Validate Lot"
                        invisible="matching == 'match'"
                        class="btn-secondary"/>

                <button name="action_prepare_scan_location"
                        type="object"
                        icon="fa-map-marker"
                        title="Validate Location"
                        invisible="matching == 'match'"
                        class="btn-secondary"/>

                <field name="confirmation_lot_code" />
                <field name="confirmation_location_code" />

                <field name="matching"
                    decoration-success="matching == 'match'"
                    decoration-danger="matching == 'not_match'"/>

            </xpath>

<!-- ============================================================================================================ -->
<!-- please dont use view below, its better to adjust view above -->

            <!-- Lock lot fields -->
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Tombol custom -->
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="operation_category" column_invisible="1"/>
                <field name="lot_name" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']"
                            position="replace">

                <field name="location_dest_id"
                    domain="[('id', 'child_of', adt_dest_location_id)]" 
                />
                <!-- <field name="allocation_storage" column_invisible="parent.picking_code != 'incoming'" domain="[('id', 'child_of', adt_dest_location_id)]" /> -->
                <field name="adt_dest_location_id" optional="show" column_invisible="parent.picking_code != 'incoming'" />
                <!-- <field name="adt_location_id" optional="show" column_invisible="parent.name != 'Pick'" /> -->
                <field name="matching_lot_id" column_invisible="1" force_save="1"/>
                <field name="matching_loc_dest_id" column_invisible="1" force_save="1"/>

            </xpath>



            <!-- <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" -->
                            <!-- position="replace"> -->

            <xpath expr="//field[@name='location_dest_id']" position="replace">

                <!-- <field name="location_dest_id" domain="[('id', 'child_of', adt_dest_location_id)]"/> -->
                <field name="allocation_storage" column_invisible="parent.picking_code != 'incoming'" domain="[('id', 'child_of', adt_dest_location_id)]" />
                <field name="adt_dest_location_id" optional="show" column_invisible="parent.picking_code != 'incoming'" />
                <field name="matching_lot_id" column_invisible="1" force_save="1"/>
                <field name="matching_loc_dest_id" column_invisible="1" force_save="1"/>

                <!-- <field name="id" string="Line ID" /> -->
                <!-- <field name="matching_html" invisible="not confirmation_location_code and not confirmation_lot_code"/> -->
                <!-- <field name="matching" -->
                    <!-- decoration-success="matching == 'match'" -->
                    <!-- decoration-danger="matching == 'not_match'"/> -->
            </xpath>

        </field>
    </record>

    <record id="view_move_line_dest_domain" model="ir.ui.view">
        <field name="name">stock.move.line.dest.domain</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"/>

        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_put_in_pack']"
                   position="after">

                <button
                    name="action_generate_selected_lot"
                    type="object"
                    string="Generate Lot"
                    class="btn-warning" invisible="picking_code != 'incoming'"/>

            </xpath>        

            <xpath expr="//field[@name='location_dest_id']"
                position="attributes">

                <attribute name="domain">
                    [
                        ('id', 'child_of', adt_dest_location_id),
                        ('usage', '=', 'internal')
                    ]
                </attribute>

            </xpath>

            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" position="replace">
                <field name="location_dest_id" optional="hide" />
                <!-- <field name="allocation_storage" domain="[('id', 'child_of', adt_dest_location_id)]" /> -->
                <field name="adt_dest_location_id" optional="hide" />
            </xpath>


        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='quant_id']" position="before">
            </xpath>

            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="adt_dest_location_id" optional="hide" />
            </xpath>

        </field>
    </record>

    <!-- <record id="view_stock_move_line_allocation_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.allocation.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="allocation_storage" optional="hide" domain="[('id', 'child_of', adt_dest_location_id)]" />
            </xpath>
        
        </field>
    </record> -->

</odoo>
