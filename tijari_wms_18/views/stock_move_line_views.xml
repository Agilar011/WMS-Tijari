<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_line_nosuggest_form_inherit_tjr_fifo_standard" model="ir.ui.view">
        <field name="name">stock.move.line.list.tjr.fifo</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
        





            <!-- test locaton -->
            <!-- <xpath expr="//field[@name='lot_name']" position="after">
                <field name="operation_category" column_invisible="1"/>
                <field name="lot_name" column_invisible="0"/>
                <field name="lot_button" widget="generate_lot_button"
                invisible="operation_category != 'receive'"/>
            </xpath> -->


            <!-- Daftarkan field helper ke list -->
            <xpath expr="//list" position="inside">
                <field name="picking_type_id" column_invisible="1"/>
                <field name="matching" column_invisible="1"/>
                <field name="operation_category" column_invisible="0"/>
                <field name="package_id" column_invisible="0"/>
            </xpath>

            <!-- Lock lot fields -->
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Tombol custom -->
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="operation_category" column_invisible="1"/>
                <field name="lot_name" column_invisible="1"/>
            </xpath>

            <!-- Custom fields -->
            <xpath expr="//field[@name='lot_id']" position="after">

                <field name="confirmation_location_code"
                    password="1"
                    column_invisible="context.get('picking_type_code') not in ['outgoing', 'internal']"/>

                <field name="confirmation_lot_code"
                    password="1"
                    column_invisible="context.get('picking_type_code') not in ['outgoing', 'internal']"/>

                <field name="matching_html"
                    widget="html"
                    readonly="1"
                    column_invisible="context.get('picking_type_code') not in ['outgoing', 'internal']"/>
                    
                <field name="auto_input_code" widget="auto_input_code"
                    invisible="context.get('picking_type_code') not in ['outgoing', 'internal']"/>

            </xpath>

        </field>
    </record>

    <record id="view_move_line_dest_domain" model="ir.ui.view">
        <field name="name">stock.move.line.dest.domain</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"/>

        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_put_in_pack']"
                   position="after">

                <button
                    name="action_generate_selected_lot"
                    type="object"
                    string="Generate Lot"
                    class="btn-warning" invisible="picking_code != 'incoming'"/>

            </xpath>        

            <xpath expr="//field[@name='location_dest_id']"
                position="attributes">

                <attribute name="domain">
                    [
                        ('id', 'child_of', adt_dest_location_id),
                        ('usage', '=', 'internal')
                    ]
                </attribute>

            </xpath>

        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='quant_id']" position="after">

                <field name="confirmation_location_code"
                    password="1"
                    column_invisible="context.get('picking_code') == 'incoming'" readonly="state in ('done', 'cancel') and is_locked"/>

                <field name="confirmation_lot_code"
                    password="1"
                    column_invisible="context.get('picking_code') == 'incoming'" readonly="state in ('done', 'cancel') and is_locked"/>

                <field name="matching_html"
                    widget="html"
                    readonly="1"
                    column_invisible="context.get('picking_code') == 'incoming'"/>

                <field name="auto_input_code" widget="auto_input_code"
                    column_invisible="context.get('picking_code') == 'incoming'" readonly="state in ('done', 'cancel') and is_locked"/>

            </xpath>
        
        </field>
    </record>

</odoo>