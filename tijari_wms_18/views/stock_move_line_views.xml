<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_nosuggest_form_inherit_tjr_fifo_standard" model="ir.ui.view">
        <field name="name">stock.move.line.list.tjr.fifo</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">

            <!-- First row of detailed stock_move_line outbound - pick -->
            <xpath expr="//field[@name='quant_id']" position="before">
                <field name="id" string="Line ID"  column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"/>
                <field name="adt_dest_location" readonly="1" optional="show" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"/>
                <field name="adt_dest_location_id" readonly="1" optional="show" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"/>
                <field name="parent_location_id" readonly="1" optional="hide" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"/>
                <field name="source_location_id" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"/>
                <field name="temp_quant_ids" optional="hide" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"/>
                <field name="product_lot_id" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"/>
                <field name="selected_quant_id" optional="hide" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"/>
            </xpath>

            <!-- Hide From To defaul_odoo for outbound- pick -->
            <xpath expr="//field[@name='quant_id']" position="replace">
                <field name="quant_id" column_invisible="parent.picking_type_name == 'Pick' and parent.transaction_type == 'outbound'"/>
            </xpath>
            
           <xpath expr="//field[last()]" position="after">

                <button name="action_prepare_scan_lot"
                        type="object"
                        icon="fa-barcode"
                        title="Validate Lot"
                        invisible="matching == 'match'"
                        column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"
                        class="btn-secondary"/>

                <button name="action_prepare_scan_location"
                        type="object"
                        icon="fa-map-marker"
                        title="Validate Location"
                        invisible="matching == 'match'"
                        column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'"
                        class="btn-secondary"/>

                <field name="confirmation_lot_code" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'" />
                <field name="confirmation_location_code" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'" />

                <field name="matching"
                    decoration-success="matching == 'match'"
                    decoration-danger="matching == 'not_match'" column_invisible="parent.picking_type_name != 'Pick' and parent.transaction_type != 'outbound'" />

            </xpath>

<!-- ============================================================================================================ -->
<!-- please dont use view below, its better to adjust view above -->

            <!-- Lock lot fields -->
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Tombol custom -->
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="operation_category" column_invisible="1"/>
                <field name="lot_name" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']"
                            position="replace">

                <field name="location_dest_id"
                    domain="[('id', 'child_of', adt_dest_location_id)]" 
                />
                <!-- <field name="allocation_storage" column_invisible="parent.picking_code != 'incoming'" domain="[('id', 'child_of', adt_dest_location_id)]" /> -->
                <field name="adt_dest_location_id" optional="show" column_invisible="parent.picking_code != 'incoming'" />
                <!-- <field name="adt_location_id" optional="show" column_invisible="parent.name != 'Pick'" /> -->
                <field name="matching_lot_id" column_invisible="1" force_save="1"/>
                <field name="matching_loc_dest_id" column_invisible="1" force_save="1"/>

            </xpath>



            <!-- <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" -->
                            <!-- position="replace"> -->

            <xpath expr="//field[@name='location_dest_id']" position="replace">

                <!-- <field name="location_dest_id" domain="[('id', 'child_of', adt_dest_location_id)]"/> -->
                <field name="allocation_storage" column_invisible="parent.picking_code != 'incoming'" domain="[('id', 'child_of', adt_dest_location_id)]" />
                <field name="adt_dest_location_id" optional="show" column_invisible="parent.picking_code != 'incoming'" />
                <field name="matching_lot_id" column_invisible="1" force_save="1"/>
                <field name="matching_loc_dest_id" column_invisible="1" force_save="1"/>

                <!-- <field name="id" string="Line ID" /> -->
                <!-- <field name="matching_html" invisible="not confirmation_location_code and not confirmation_lot_code"/> -->
                <!-- <field name="matching" -->
                    <!-- decoration-success="matching == 'match'" -->
                    <!-- decoration-danger="matching == 'not_match'"/> -->
            </xpath>

        </field>
    </record>

</odoo>