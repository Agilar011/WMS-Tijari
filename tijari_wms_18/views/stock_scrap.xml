<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_list_stock_scrap_inherit_wms" model="ir.ui.view">
        <field name="name">stock.scrap.list.inherit.wms</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="origin" />
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Seri Dokumen</attribute>
            </xpath>
            <xpath expr="//field[@name='date_done']" position="before">
                <field name="scheduled_date" />
            </xpath>
            <xpath expr="//field[@name='date_done']" position="attributes">
                <attribute name="string">Date Done</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_scrap_inherit_wms" model="ir.ui.view">
        <field name="name">stock.scrap.inherit.wms</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_validate']" position="attributes">
                <attribute name="invisible">
                    state != 'ready'
                </attribute>
            </xpath>
            <xpath expr="//button[@name='action_validate']" position="before">
                <button
                    name="action_mark_as_to_do"
                    string="Mark As To Do"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'draft'"
                />
                <button
                    name="action_check_availability"
                    string="Check Availability"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'ready'"
                />
            </xpath>
            <xpath expr="//group//field[@name='origin']" position="replace">
                <field name="name" readonly="1" string="Seri Dokumen"/>
            </xpath>
            <xpath expr="//div[contains(@class, 'oe_title')]//field[@name='name']" position="replace">
                <field name="origin" placeholder="No. Dokumen" invisible="not id"/>
            </xpath>
            
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='scrap_qty']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='scrap_location_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='scrap_reason_tag_ids']" position="after">
                <field 
                    name="location_id" 
                    options="{'no_create': True, 'no_open': True}" 
                    groups="stock.group_stock_multi_locations" 
                    force_save="1" 
                    readonly="state == 'done'"
                />
                <field 
                    name="scrap_location_id" 
                    options="{'no_create': True, 'no_open': True}" 
                    groups="stock.group_stock_multi_locations" 
                    force_save="1" 
                    readonly="state == 'done'"
                />
                <field 
                    name="availability_state"
                    widget="badge"
                    decoration-warning="availability_state == 'waiting'"
                    decoration-success="availability_state == 'available'"
                    decoration-danger="availability_state == 'insufficient'"
                    readonly="1"
                />
                <field name="last_availability_check"
                    readonly="1"
                />
            </xpath>

            <xpath expr="//field[@name='should_replenish']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='package_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='owner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='date_done']" position="before">
                <field name="scheduled_date" />
            </xpath>

            <xpath expr="//field[@name='date_done']" position="attributes">
                <attribute name="string">Date Done</attribute>
                <attribute name="invisible">not date_done</attribute>
            </xpath>
            
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="item_to_scrap" string="Item to Scrap">
                        <group>
                            <field name="allowed_scrap_product_ids" invisible="1"/>
                            <field name="allowed_scrap_lot_ids" invisible="1"/>
                            <field name="filter_scan_code"
                                widget="adt_handheld_scan_code"
                                placeholder="Scan handheld atau ketik kode"
                                help="Bisa barcode, SKU, atau lot."/>
                            <field name="scrap_product_id"
                                domain="[('id', 'in', allowed_scrap_product_ids)]"/>
                            <field name="scrap_lot_id"
                                domain="[('id', 'in', allowed_scrap_lot_ids)]"/>
                        </group>
                        <field name="filtered_scrap_line_ids"
                            mode="list,kanban"
                            readonly="state == 'done'"
                            nolabel="1">

                            <list editable="bottom">

                                <field name="product_id"/>

                                <field name="demand_qty"/>

                                <field name="available_qty" optional="hide"/>

                                <field name="scrapped_qty"/>

                                <field name="availability_state"
                                    widget="badge"
                                    decoration-warning="availability_state == 'waiting'"
                                    decoration-success="availability_state == 'available'"
                                    decoration-danger="availability_state == 'insufficient'"
                                    optional="hide"
                                />

                                <field name="product_uom_id"/>

                                 <field name="lot_ids" widget="many2many_tags"/>

                                <field name="status"
                                    widget="badge"
                                    decoration-success="status == 'finished'"
                                    decoration-danger="status == 'unfinished'"
                                />


                                <field name="location_id" widget="location_short_many2one" force_save="1" context="{'show_location_short_name': True}" optional="hide"/>

                                <field name="receipt_move_id" optional="hide"/>

                                <field name="move_id" optional="hide"/>

                                <field name="scrap_move_id" optional="hide" />

                                <button
                                    name="action_show_details"
                                    type="object"
                                    icon="fa-list"
                                    invisible="not scrap_move_id"
                                />

                            </list>

                            <kanban class="o_kanban_mobile" can_open="0">
                                <templates>
                                    <t t-name="card">
                                        <div class="o_wms_operation_card">
                                            <div class="o_wms_operation_product">
                                                <field name="product_id" class="fs-3" context="{'tijari_stock_picking_product_code_only': True}"/>
                                                <field name="status"
                                                    widget="badge"
                                                    decoration-success="status == 'finished'"
                                                    decoration-danger="status == 'unfinished'" />
                                            </div>
                                            <br/>
                                            <div>
                                                <div>
                                                    <strong>Scrap Demand: </strong>
                                                    <field name="demand_qty"/>
                                                    <field name="product_uom_id" groups="uom.group_uom" class="ms-1"/>
                                                </div>
                                                <div>
                                                    <strong>Scrapped Qty: </strong>
                                                    <field name="scrapped_qty"/>
                                                    <field name="product_uom_id" groups="uom.group_uom" class="ms-1"/>
                                                </div>
                                                
                                            </div>
                                            <br/>
                                            <button name="action_show_details"
                                                type="object"
                                                string="Scrap Detail"
                                                class="btn btn-primary btn-sm o_wms_operation_action"
                                            />
                                        </div>
                                    </t>
                                </templates>
                            </kanban>

                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    
    <record id="picking_view_inherit_stock_scrap" model="ir.ui.view">
        <field name="name">picking.view.inherit.stock.scrap</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_generate_scrap"
                    string="Generate Scrap"
                    type="object"
                    class="oe_highlight"
                    invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="wms_scrap_move_view_form" model="ir.ui.view">
        <field name="name">wms.scrap.move.view.form</field>
        <field name="model">wms.scrap.move</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <field name="receipt_move_id" invisible='1' />
                    <group>
                        <group>
                            <field name="product_id" readonly="id or move_line_ids"/>
                            <label for="demand_qty"/>
                            <div class="o_row">
                                <span><field name="demand_qty" nolabel="1"/></span>
                                <span><field name="product_uom" groups="uom.group_uom" nolabel="1" options="{'no_open': True}"/></span>
                            </div>
                        </group>
                    </group>
                    <field 
                        name="move_line_ids"
                        mode="list,kanban">
                        <list editable="bottom">
                            <field name="state" optional="hide"/>
                            <field name="lot_id" />
                            <field name="handheld_scan_code" />
                            <field name="location_id" widget="location_short_many2one" force_save="1" context="{'show_location_short_name': True}" />
                            <field name="quantity" />
                            <field name="scrapped_qty" />
                            <field name="product_uom_id" />
                            <field name="matching_lot_id" />
                            <field name="status" 
                                widget="badge"
                                decoration-success="status == 'finished'"
                                decoration-danger="status == 'unfinished'"
                            />
                            <field 
                                name="match_status" 
                                widget="badge"
                                decoration-success="match_status == 'match'"
                                decoration-danger="match_status == 'not_match'"
                                optional="hide"
                            />
                            <button name="action_mark_check_finished"
                                type="object"
                                icon="fa-check"
                                class="btn-success o_wms_auto_save_before_action"
                                title="Finish"
                                invisible="status == 'finished'"/>

                            <button name="action_mark_check_unfinished"
                                type="object"
                                icon="fa-undo"
                                class="btn-danger"
                                title="Rollback"
                                invisible="status == 'unfinished' or state == 'done'"/>
                        </list>
                        <kanban class="o_kanban_mobile">
                            <field name="state" invisible="1"/>
                            <templates>
                                <t t-name="card">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <field name="lot_id" force_save="1" class="fw-bold fs-6"/>
                                       
                                        <field name="status"
                                            widget="badge"
                                            decoration-success="status == 'finished'"
                                            decoration-danger="status == 'unfinished'"/>
                                    </div>
                                    <br/>
                                    
                                    <div class="d-flex align-items-center gap-1">
                                        <strong>Pick From: </strong>
                                        <field name="location_id" widget="location_short_many2one" force_save="1" context="{'show_location_short_name': True}"/>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <strong>Saran Qty: </strong>
                                        <field name="quantity"/>
                                        <field name="product_uom_id" class="ms-1"/>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <strong>Scrapped Qty: </strong>
                                        <field name="scrapped_qty"/>
                                        <field name="product_uom_id" class="ms-1"/>
                                    </div>
                                    

                                    <div class="d-flex gap-2 mt-2">
                                        <button name="action_mark_check_finished"
                                            type="object"
                                            string="Finish Picking"
                                            class="btn-success o_wms_auto_save_before_action"
                                            invisible="status == 'finished'"/>
                                        <button name="action_mark_check_unfinished"
                                            type="object"
                                            string="Rollback"
                                            class="btn-danger o_wms_auto_save_before_action"
                                            invisible="status == 'unfinished' or state == 'done'"/>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wms_scrap_move_line_view_form" model="ir.ui.view">
        <field name="name">wms.scrap.move.line.view.form</field>
        <field name="model">wms.scrap.move.line</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>

                    <field name="status" invisible="1" />
                    <field name="state" invisible="1" />

                    <group>
                        <label for="product_id" string="Product"/>

                        <field name="product_id"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            context="{'tijari_stock_picking_product_code_only': True}"
                            class="fw-bold fs-6"/>
                    </group>

                    <group groups="stock.group_production_lot"
                        invisible="not lot_id">

                        <label for="lot_id" string="LOT Number"/>

                        <field name="lot_id"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            class="fw-bold fs-6"/>

                    </group>

                    <group>

                        <label for="handheld_scan_code"
                            string="Scan Handheld"/>

                        <field name="handheld_scan_code"
                            widget="adt_handheld_scan_code"
                            placeholder="Scan handheld: lot"
                            nolabel="1"
                            class="fw-bold fs-6"/>

                    </group>

                    <group>

                        <label for="matching_lot_id" string="Confirmation Lot"/>

                        <field name="matching_lot_id"
                            force_save="1"
                            nolabel="1"
                            domain="[('id', 'in', allowed_matching_lot_ids)]"
                            class="fw-bold fs-6"/>

                    </group>

                    <group>
                        <label for="location_id" string="Pick From"/>

                        <field name="location_id"
                            widget="location_short_many2one"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            context="{'show_location_short_name': True}"
                            class="fw-bold fs-6"/>
                    </group>

                    <group>
                        <label for="quantity" string="Saran Qty"/>

                        <field name="quantity"
                            readonly="1"
                            force_save="1"
                            nolabel="1"
                            class="fw-bold fs-6"/>
                    </group>

                    <group>
                        <label for="scrapped_qty" string="Scrapped Qty"/>

                        <field name="scrapped_qty"
                            nolabel="1"
                            class="fw-bold fs-6"
                            readonly="status == 'finished' or state == 'done'"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_mark_check_finished"
                        type="object"
                        string="Save"
                        class="btn-primary"
                        invisible="status == 'finished'"/>
                    
                    <button special="cancel"
                        string="Close"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
