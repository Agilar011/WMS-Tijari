<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_batch_form_inherit_tijari" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.inherit.tijari</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='picking_type_code']" position="after">
                <field name="picking_type_name" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_detailed_operations"
                    class="oe_stat_button"
                    icon="fa-bars"
                    type="object"
                    help="List view of detailed operations"
                    invisible="state == 'draft'">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Moves</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='page_detailed_operations']" position="before">
                <xpath expr="//page[@name='page_transfers']" position="move"/>
            </xpath>

            <xpath expr="//page[@name='page_detailed_operations']" position="before">
                <xpath expr="//page[@name='page_operations']" position="move"/>
            </xpath>

            <xpath expr="//page[@name='page_transfers']" position="attributes">
                <attribute name="string">Transaksi</attribute>
            </xpath>

            <xpath expr="//field[@name='picking_ids']" position="attributes">
                <attribute name="string">Transaksi</attribute>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='page_operations']" position="after">
                <page string="Putaway" name="page_putaway" invisible="picking_type_name not in ['Receipts', 'Receipt Internal']">
                    <group>
                        <field name="scan_product_button"
                            widget="adt_scan_putaway_product_button"
                            nolabel="1"/>
                        <field name="putaway_scan_code"
                            widget="adt_handheld_scan_code"
                            placeholder="Scan handheld atau ketik kode"
                            help="Bisa barcode, SKU, atau lot."/>
                        <field name="scan_product_by_lot_button"
                            widget="adt_scan_product_by_lot_button"
                            invisible="1"
                            nolabel="1"/>
                        <field name="picking_type_name" invisible="1"/>
                        <field name="allowed_putaway_product_ids" invisible="1"/>
                        <field name="allowed_putaway_move_line_ids" invisible="1"/>
                        <field name="allowed_putaway_lot_ids" invisible="1"/>
                        <field name="putaway_product_id" context="{'tijari_stock_picking_product_code_only': True}" domain="[('id', 'in', allowed_putaway_product_ids)]"/>
                        <field name="putaway_lot_id" domain="[('id', 'in', allowed_putaway_lot_ids)]"/>
                    </group>

                    <field name="putaway_move_line_ids" domain="[('id', 'in', allowed_putaway_move_line_ids)]" groups="!tijari_wms_18.group_operator">
                        <list editable="bottom" create="0" delete="0" link="0">
                            <field name="id" column_invisible="1"/>
                            <field name="product_id" readonly="1" context="{'tijari_stock_picking_product_code_only': True}"/>
                            <field name="location_dest_id"
                                string="Store To"
                                readonly="putaway_status == 'finished'"
                                context="{'show_location_short_name': True}"
                                widget="location_short_many2one"
                                domain="[('id', 'child_of', adt_dest_location_id)]"/>
                            <field name="quantity" string="Qty Diterima" readonly="1"/>
                            <field name="confirmation_quantity" string="Qty Disimpan" readonly="putaway_status == 'finished'" force_save="1"/>
                            <field name="product_uom_id" readonly="1" string="UoM" optional="hide"/>
                            <field name="adt_dest_location_id" column_invisible="1"/>
                            <field name="allowed_matching_lot_ids" column_invisible="1"/>
                            <field name="matching" column_invisible="1" force_save="1"/>
                            <field name="putaway_status" string="Status"
                                decoration-success="putaway_status == 'finished'"
                                decoration-danger="putaway_status == 'unfinished'"
                                widget="badge"/>
                            <field name="confirmation_location_code"
                                widget="adt_scan_location_button"
                                string=" "
                                readonly="1"/>

                            <button name="action_mark_putaway_finished"
                                type="object"
                                icon="fa-check"
                                class="btn-success"
                                title="Finish Putaway"
                                invisible="putaway_status == 'finished'"/>

                            <button name="action_mark_putaway_unfinished"
                                type="object"
                                icon="fa-undo"
                                class="btn-danger"
                                title="Undo Putaway"
                                invisible="putaway_status == 'unfinished'"/>
                        </list>
                    </field>
                    <field name="putaway_move_line_ids" domain="[('id', 'in', allowed_putaway_move_line_ids)]" groups="tijari_wms_18.group_operator">
                        <list editable="bottom" create="0" delete="0" link="0">
                            <field name="id" column_invisible="1"/>
                            <field name="putaway_status" column_invisible="1"/>
                            <field name="adt_dest_location_id" column_invisible="1"/>
                            <field name="location_dest_id"
                                string="Store To"
                                readonly="putaway_status == 'finished'"
                                context="{'show_location_short_name': True}"
                                domain="[('id', 'child_of', adt_dest_location_id)]"/>
                            <field name="quantity" string="Picked Qty" readonly="1"/>
                            <field name="confirmation_quantity" string="Stored Qty" readonly="putaway_status == 'finished'" force_save="1"/>
                            <field name="product_uom_id" readonly="1" string="UoM"/>
                            <field name="confirmation_location_code"
                                widget="adt_scan_location_button"
                                string=" "
                                readonly="1"
                                invisible="putaway_status == 'finished'"/>
                            <button name="action_mark_putaway_finished"
                                type="object"
                                icon="fa-check"
                                class="btn-success"
                                title="Finish Putaway"
                                invisible="putaway_status == 'finished'"/>

                            <button name="action_mark_putaway_unfinished"
                                type="object"
                                icon="fa-undo"
                                class="btn-danger"
                                title="Undo Putaway"
                                invisible="putaway_status == 'unfinished'"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_picking_move_tree_inherited_tijari" model="ir.ui.view">
        <field name="name">stock.picking.batch.picking.move.list.inherit.tijari</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock_picking_batch.view_picking_move_tree_inherited"/>
        <field name="priority" eval="1100"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list decoration-muted="scrapped == True or state == 'cancel' or (state == 'done' and is_locked == True)"
                    string="Stock Moves"
                    editable="bottom"
                    delete="0">
                    <field name="company_id" column_invisible="True"/>
                    <field name="name" column_invisible="True"/>
                    <field name="date" column_invisible="True"/>
                    <field name="state" readonly="0" column_invisible="True"/>
                    <field name="picking_type_id" column_invisible="True"/>
                    <field name="location_id" column_invisible="True"/>
                    <field name="location_dest_id" column_invisible="True"/>
                    <field name="scrapped" column_invisible="True"/>
                    <field name="picking_code" column_invisible="True"/>
                    <field name="show_details_visible" column_invisible="True"/>
                    <field name="additional" column_invisible="True"/>
                    <field name="move_lines_count" column_invisible="True"/>
                    <field name="is_locked" column_invisible="True"/>
                    <field name="product_uom_category_id" column_invisible="True"/>
                    <field name="is_initial_demand_editable" column_invisible="True"/>
                    <field name="is_quantity_done_editable" column_invisible="True"/>
                    <field name="batch_adt_type" string="Tipe Transaksi"/>
                    <field name="batch_origin" string="No. Transaksi"/>
                    <field name="product_id" required="1" context="{'tijari_stock_picking_product_code_only': True}" readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0"/>
                    <field name="product_uom_qty" string="Total Qty" readonly="not is_initial_demand_editable"/>
                    <field name="quantity" string="Qty Diterima" readonly="not is_quantity_done_editable"/>
                    <field name="confirmation_quantity" string="Qty Disimpan"/>
                    <field name="product_uom" readonly="state != 'draft' and id" options="{'no_open': True, 'no_create': True}" string="UoM" groups="uom.group_uom"/>
                    <field name="lot_ids" widget="many2many_tags" string="Lot/Serial Number" groups="stock.group_production_lot"/>
                    <field name="difference_quantity" string="Perbedaan Qty" readonly="1" decoration-danger="difference_quantity &gt; 0"/>
                    <button name="action_print_lot_number_line"
                        type="object"
                        icon="fa-print"
                        invisible="picking_type_name not in ['Receipts', 'Receipt Internal']"
                        title="Print Lot"/>
                    <button
                        name="action_open_note_wizard"
                        type="object"
                        icon="fa-sticky-note"
                        title="Note"
                    />
                    <button name="action_open_move_pick"
                        type="object"
                        string="To Process"
                        title="Open Picker"
                        invisible="picking_type_name not in ['Receipts', 'Receipt Internal'] or state == 'draft'"/>
                    <button name="action_open_move_lines"
                        type="object"
                        icon="fa-list"
                        title="Open Move Lines"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_batch_list_inherit_tijari" model="ir.ui.view">
        <field name="name">stock.picking.batch.list.inherit.tijari</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>


        </field>
    </record>

    <record id="stock_picking_batch_to_form_inherit_tijari" model="ir.ui.view">
        <field name="name">stock.picking.to.batch.form.inherit.tijari</field>
        <field name="model">stock.picking.to.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_to_batch_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="replace">

                <!-- Technical field -->
                <field name="operation_type_name" invisible="1"/>

                <!-- PICKER
                    Receipt + Pick -->
                <field name="pick_responsible_ids"
                    widget="many2many_avatar_user"/>

                <!-- PACKER
                    Pick only -->
                <field name="pack_responsible_ids"
                    widget="many2many_avatar_user"
                    invisible="operation_type_name not in ('Pick', 'Pick Internal', 'Pack', 'Delivery Orders')"/>

                <!-- LOADER
                    Pick only -->
                <field name="do_responsible_ids"
                    widget="many2many_avatar_user"
                    invisible="operation_type_name not in ('Pick', 'Pick Internal', 'Pack', 'Delivery Orders')"/>

                <!-- PUTAWAY
                    Receipt only -->
                <field name="putaway_responsible_ids"
                    widget="many2many_avatar_user"
                    invisible="operation_type_name not in ['Receipts', 'Receipt Internal']"/>

            </xpath>

        </field>
    </record>

</odoo>
