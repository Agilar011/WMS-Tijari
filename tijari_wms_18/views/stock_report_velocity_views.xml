<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_stock_report_velocity_generate" model="ir.actions.act_window">
        <field name="name">Generate Stock Velocity</field>
        <field name="res_model">stock.report.velocity.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_stock_report_velocity_line_list" model="ir.ui.view">
        <field name="name">stock.report.velocity.line.list</field>
        <field name="model">stock.report.velocity.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <header>
                    <button
                        name="%(action_stock_report_velocity_generate)d"
                        string="Generate"
                        type="action"
                        class="btn-primary"
                        display="always"
                    />
                </header>
                <field name="product_id"/>
                <field name="product_name"/>
                <field name="qty_out"/>
                <field name="move_frequency"/>
                <field name="last_movement_date"/>
                <field name="movement_category"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="view_stock_report_velocity_line_form" model="ir.ui.view">
        <field name="name">stock.report.velocity.line.form</field>
        <field name="model">stock.report.velocity.line</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_name"/>
                            <field name="movement_category"/>
                        </group>
                        <group>
                            <field name="qty_out"/>
                            <field name="move_frequency"/>
                            <field name="last_movement_date"/>
                            <field name="generated_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_report_velocity_generate_form" model="ir.ui.view">
        <field name="name">stock.report.velocity.generate.form</field>
        <field name="model">stock.report.velocity.generate</field>
        <field name="arch" type="xml">
            <form string="Generate Stock Velocity Report">
                <sheet>
                    <group>
                        <field name="analysis_days"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_report_velocity_lines" model="ir.actions.act_window">
        <field name="name">Stock Velocity</field>
        <field name="res_model">stock.report.velocity.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
