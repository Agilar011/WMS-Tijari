    <!-- View untuk Operations normal -->
    <record id="view_move_line_nosuggest_form_inherit_tjr_fifo_standard" model="ir.ui.view">
        <field name="name">stock.move.line.list.tjr.fifo</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">



            <!-- test locaton -->
            <!-- <xpath expr="//field[@name='lot_name']" position="after">
                <field name="operation_category" column_invisible="1"/>
                <field name="lot_name" column_invisible="0"/>
                <field name="lot_button" widget="generate_lot_button"
                invisible="operation_category != 'receive'"/>
            </xpath> -->


            <!-- Daftarkan field helper ke list -->
            <xpath expr="//list" position="inside">
                <field name="picking_type_id" column_invisible="1"/>
                <field name="matching" column_invisible="1"/>
                <field name="operation_category" column_invisible="0"/>
                <field name="package_id" column_invisible="0"/>
            </xpath>

            <!-- Lock lot fields -->
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Tombol custom -->
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="operation_category" column_invisible="1"/>
                <field name="lot_name" column_invisible="1"/>
                <!-- <field name="lot_button" widget="generate_lot_button" -->
                <!-- invisible="operation_category != 'receive'"/> -->
            </xpath>

            <!-- Custom fields -->
            <xpath expr="//field[@name='lot_id']" position="after">

                <field name="confirmation_location_code"
                    password="1"
                    column_invisible="context.get('picking_type_code') not in ['outgoing', 'internal']"/>

                <field name="confirmation_lot_code"
                    password="1"
                    column_invisible="context.get('picking_type_code') not in ['outgoing', 'internal']"/>

                <field name="matching_html"
                    widget="html"
                    readonly="1"
                    column_invisible="context.get('picking_type_code') not in ['outgoing', 'internal']"/>
                    
                <field name="auto_input_code" widget="auto_input_code"
                    invisible="context.get('picking_type_code') not in ['outgoing', 'internal']"/>

            </xpath>

        </field>
    </record>

    <!-- Location Form -->
    <record id="view_location_form_wms_matching_v18" model="ir.ui.view">
        <field name="name">stock.location.form.wms.unique.code</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='usage']" position="before">
                <label for="unique_code" string="Location Unique Code"/>
                <div class="o_row">
                    <field name="unique_code" readonly="1" force_save="1" />
                    <button name="generate_unique_code" type="object" string="Generate" 
                            class="btn-link" icon="fa-barcode" invisible="unique_code"/>
                </div>
                <field name="is_location_mapping" />
                <field name="sequence" />
            </xpath>
        </field>
    </record>

    <!-- Picking Type Form -->
    <record id="view_picking_type_form_wms_category_v18" model="ir.ui.view">
        <field name="name">stock.picking.type.form.wms.operation.category</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="operation_category" required="1"/>
            </xpath>
        </field>
    </record>
    

    <record id="view_picking_form_inherit_acumatica_receipt" model="ir.ui.view">
        <field name="name">stock.picking.form.acumatica.receipt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Acumatica">
                    <group>
                        <group>
                            <field name="adt_receipt_nbr"/>
                            <field name="adt_vendor_code"/>
                            <field name="adt_partner_ref"/>
                            <field name="adt_branch_warehouse"/>
                            <field name="adt_actual_qty"/>
                            <field name="adt_is_hold"/>
                            <field name="adt_inventory_ref"/>
                            <field name="adt_acumatica_write_date"/>
                        </group>
                        <group>
                            <field name="adt_header_location_code"/>
                            <field name="adt_post_period"/>
                            <field name="adt_status"/>
                            <field name="adt_total_qty"/>
                            <field name="adt_type"/>
                            <field name="adt_warehouse_code"/>
                            <field name="adt_external_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_inherit_acumatica_header" model="ir.ui.view">
        <field name="name">stock.picking.form.acumatica.header</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="sync_state" readonly="1" decoration-danger="sync_state == 'not_ready'" invisible="sync_state != 'not_ready'"/>
                <field name="sync_message" readonly="1" decoration-danger="sync_state == 'not_ready'" invisible="sync_state != 'not_ready'"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <!-- <field name="adt_type" readonly="1"/> -->
                <field name="adt_total_qty"/>
                <field name="adt_actual_qty"/>
                <field name="adt_dest_location_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_dest_domain" model="ir.ui.view">
        <field name="name">stock.picking.dest.domain</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" position="attributes">

                <attribute name="domain">
                    [
                        ('id', 'child_of', adt_dest_location_id),
                        '|',
                        ('company_id', '=', company_id),
                        ('usage', '=', 'internal')
                    ]
                </attribute>

            </xpath>

        </field>
    </record>

    <record id="view_move_dest_domain" model="ir.ui.view">
        <field name="name">stock.move.dest.domain</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='location_dest_id']"
                position="attributes">

                <attribute name="domain">
                    [
                        ('id', 'child_of', adt_dest_location_id),
                        ('usage', '=', 'internal')
                    ]
                </attribute>

            </xpath>

        </field>
    </record>


    <!-- Hide odoo default generate lot -->
    <record id="view_move_dest_domain" model="ir.ui.view">
        <field name="name">stock.move.generate.lot</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">

            <xpath expr="//widget[@name='import_lots']" position="after">
                <button name="action_generate_lot"
                        type="object"
                        string="Generate Lot"
                        class="btn-primary"
                        invisible="not display_assign_serial"/>
            </xpath>

            <xpath expr="//widget[@name='generate_serials']" position="replace">
                <widget class="btn btn-link btn-group" name="generate_serials" invisible="1"/>
            </xpath>                        
            
            <xpath expr="//widget[@name='import_lots']" position="replace">
                <widget class="btn btn-link btn-group" name="import_lots" invisible="1"/>
            </xpath>                        

        </field>
    </record>

    <record id="view_move_line_dest_domain" model="ir.ui.view">
        <field name="name">stock.move.line.dest.domain</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='location_dest_id']"
                position="attributes">

                <attribute name="domain">
                    [
                        ('id', 'child_of', adt_dest_location_id),
                        ('usage', '=', 'internal')
                    ]
                </attribute>

            </xpath>

        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='quant_id']" position="after">

                <field name="confirmation_location_code"
                    password="1"
                    column_invisible="context.get('picking_code') == 'incoming'" readonly="state in ('done', 'cancel') and is_locked"/>

                <field name="confirmation_lot_code"
                    password="1"
                    column_invisible="context.get('picking_code') == 'incoming'" readonly="state in ('done', 'cancel') and is_locked"/>

                <field name="matching_html"
                    widget="html"
                    readonly="1"
                    column_invisible="context.get('picking_code') == 'incoming'"/>

                <field name="auto_input_code" widget="auto_input_code"
                    column_invisible="context.get('picking_code') == 'incoming'" readonly="state in ('done', 'cancel') and is_locked"/>

            </xpath>
        
        </field>
    </record>

