<odoo>

    <!-- =========================
         MOVE LINE - DETAILED OPERATIONS
         ========================= -->
    <record id="view_move_line_detailed_tjr_fifo" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.tjr.fifo.clean</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">

            <!-- Inject field konfirmasi setelah lot_id -->
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="confirmation_location_code"
                       string="Confirm Location Code"
                       invisible="operation_category not in ['put', 'delivery']"
                       password="True"/>

                <field name="confirmation_lot_code"
                       string="Confirm Lot Code"
                       invisible="operation_category not in ['put', 'delivery']"
                       password="True"/>
            </xpath>

            <!-- Status matching ditaruh dekat qty biar lebih masuk akal -->
            <xpath expr="//field[@name='qty_done']" position="after">
                <field name="matching_html"
                       widget="html"
                       string="Status"
                       readonly="1"
                       invisible="not matching"/>
            </xpath>

            <!-- Field teknikal disembunyikan -->
            <xpath expr="//tree" position="inside">
                <field name="operation_category" invisible="1"/>
                <field name="matching" invisible="1"/>
            </xpath>

        </field>
    </record>


    <!-- =========================
         MOVE LINE - OPERATIONS NORMAL
         ========================= -->
    <record id="view_move_line_operation_tjr_fifo" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tjr.fifo.clean</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">

            <!-- Lock lot fields -->
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- IMPORTANT:
                 TIDAK menambahkan lot_button lagi karena sudah ada di core -->
            <xpath expr="//field[@name='lot_button']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>

        </field>
    </record>


    <!-- =========================
         LOCATION FORM
         ========================= -->
    <record id="view_location_form_wms_matching_v18" model="ir.ui.view">
        <field name="name">stock.location.form.wms.unique.code.clean</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='usage']" position="before">
                <label for="unique_code" string="Location Unique Code"/>
                <div class="o_row">
                    <field name="unique_code" readonly="1" force_save="1"/>
                    <button name="generate_unique_code"
                            type="object"
                            string="Generate"
                            class="btn-link"
                            icon="fa-barcode"
                            invisible="unique_code"/>
                </div>
                <field name="sequence"/>
            </xpath>

        </field>
    </record>


    <!-- =========================
         PICKING TYPE FORM
         ========================= -->
    <record id="view_picking_type_form_wms_category_v18" model="ir.ui.view">
        <field name="name">stock.picking.type.form.wms.operation.category.clean</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='code']" position="after">
                <field name="operation_category" required="1"/>
            </xpath>

        </field>
    </record>


    <!-- =========================
         PICKING FORM - ACUMATICA TAB
         ========================= -->
    <record id="view_picking_form_acumatica_tab" model="ir.ui.view">
        <field name="name">stock.picking.form.acumatica.tab.clean</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Acumatica">
                    <group>
                        <group>
                            <field name="adt_receipt_nbr"/>
                            <field name="adt_vendor_code"/>
                            <field name="adt_partner_ref"/>
                            <field name="adt_branch_warehouse"/>
                            <field name="adt_actual_qty"/>
                            <field name="adt_is_hold"/>
                            <field name="adt_inventory_ref"/>
                            <field name="adt_acumatica_write_date"/>
                        </group>
                        <group>
                            <field name="adt_header_location_code"/>
                            <field name="adt_post_period"/>
                            <field name="adt_status"/>
                            <field name="adt_total_qty"/>
                            <field name="adt_type"/>
                            <field name="adt_warehouse_code"/>
                            <field name="adt_external_id"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>


    <!-- =========================
         PICKING FORM - HEADER INFO
         ========================= -->
    <record id="view_picking_form_acumatica_header" model="ir.ui.view">
        <field name="name">stock.picking.form.acumatica.header.clean</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='origin']" position="after">
                <field name="adt_type"/>
                <field name="adt_total_qty"/>
                <field name="adt_actual_qty"/>
            </xpath>

        </field>
    </record>

</odoo>