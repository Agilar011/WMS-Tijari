<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Data-only overrides on actions owned by other modules (stock,
         mrp): re-declaring a <record> with an id that already exists
         updates that record's listed fields, it does not touch the
         Odoo core file that originally defined it. No source edit, no
         new duplicate action either. -->

    <!-- Picking-type dashboard drill-down: Receipts / Pick / Pack /
         Delivery Orders / Internal Transfers / Manufacturing all reuse
         this ONE action (dynamic domain per operation type clicked on
         the Inventory Overview dashboard). It had no kanban view
         registered, so mobile users fell back to list despite
         mobile_view_mode defaulting to 'kanban'. stock.picking already
         has a kanban view in core (and tijari_wms_18 already customizes
         it further), so just listing 'kanban' here is enough. -->
    <record id="stock.stock_picking_action_picking_type" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- Work Orders tab inside a specific Manufacturing Order. The
         generic "My Work Orders" action already includes kanban; this
         production-specific variant did not, even though mrp.workorder
         already has a core kanban view. -->
    <record id="mrp.action_mrp_workorder_production_specific" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
    </record>

</odoo>
