<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_internal_document_shipments" model="ir.ui.view">
        <field name="name">stock.warehouse.form.internal.document.shipments</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_steps']" position="after">
                <label for="adt_internal_transfer_enabled"/>
                <div class="o_row">
                    <field name="adt_internal_transfer_enabled" nolabel="1"/>
                    <span>Pick, Pack, Transfer, then Receipt (3 steps)</span>
                </div>
                <label for="adt_document_only_enabled"/>
                <div class="o_row">
                    <field name="adt_document_only_enabled" nolabel="1"/>
                    <span>Direct Receipt and Direct Delivery Order</span>
                </div>
            </xpath>
            <xpath expr="//field[@name='xdock_type_id']" position="after">
                <field name="adt_pick_internal_type_id" readonly="1"/>
                <field name="adt_pack_internal_type_id" readonly="1"/>
                <field name="adt_transfer_internal_type_id" readonly="1"/>
                <field name="adt_receipt_internal_type_id" readonly="1"/>
                <field name="adt_direct_receipt_type_id" readonly="1"/>
                <field name="adt_direct_delivery_type_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
