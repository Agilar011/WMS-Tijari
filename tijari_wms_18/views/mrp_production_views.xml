<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tijari_wms_inherit_mrp_production_list_views" model="ir.ui.view">
        <field name="name">tijari.wms.inherit.mrp.production.list.views</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="origin" />
            </xpath>
        </field>
    </record>

    <record id="tijari_wms_inherit_mrp_production_kanban_views" model="ir.ui.view">
        <field name="name">tijari.wms.inherit.mrp.production.kanban.views</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="origin" class="fw-bolder fs-6 ms-1"/>
                <span t-attf-class="ms-auto badge #{['cancel'].indexOf(record.state.raw_value) &gt; -1 ? 'text-bg-danger' : ['draft'].indexOf(record.state.raw_value) &gt; -1 ? 'bg-200' : ['progress'].indexOf(record.state.raw_value) &gt; -1 ? 'text-bg-warning' : ['done', 'to_close'].indexOf(record.state.raw_value) &gt; -1 ? 'text-bg-success' : 'text-bg-primary'}"><field name="state"/></span>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//footer" position="before">
                <div class="d-flex mb-1">
                    <field name="product_id" context="{'tijari_stock_picking_product_code_only': True}" />
                </div>
            </xpath>
            <xpath expr="//footer/span" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="tijari_wms_inherit_mrp_prodction_views" model="ir.ui.view">
        <field name="name">tijari.wms.inherit.mrp.prodction.views</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div/h1/field[@name='name']" position="replace">
                <field name="origin" placeholder="No. Dokumen" invisible="not id"/>
            </xpath>

            <xpath expr="//label[@name='bom_label']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div[@name='bom_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_generate_serial']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="picking_type_name" invisible='1' />
            </xpath>    

            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='picked']" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="context">{'default_is_storable': True, 'tijari_stock_picking_product_code_only': True}</attribute>
            </xpath> -->

            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']" position="after">
                <field name="description_picking" string="Description" optional="show"/>
            </xpath>

            <xpath expr="//page[@name='components']" position="after">
                <page name="raw_material" string="Raw Material">
                    <group>
                        <field name="raw_material_scan_button"
                            widget="adt_scan_picker_product_button"
                            nolabel="1"/>
                        <field name="raw_material_scan_code"
                            widget="adt_handheld_scan_code"
                            placeholder="Scan barcode, SKU, atau lot"
                            help="Bisa diisi dari scanner handheld atau diketik manual."/>
                        <field name="raw_material_product_ids" invisible="1"/>
                        <field name="raw_material_lot_ids" invisible="1"/>
                        <field name="raw_material_product_id"
                            domain="[('id', 'in', raw_material_product_ids)]"/>
                        <field name="raw_material_lot_id"
                            domain="[('id', 'in', raw_material_lot_ids)]"/>
                    </group>
                    <field name="filtered_raw_material_move_ids"
                        
                        mode="list,kanban"
                        readonly="state == 'cancel' or (state == 'done' and is_locked)"
                        context="{
                            'default_date': date_start,
                            'default_date_deadline': date_start,
                            'default_location_id': location_src_id,
                            'default_location_dest_id': production_location_id,
                            'default_warehouse_id': warehouse_id,
                            'default_state': 'draft',
                            'default_raw_material_production_id': id,
                            'default_picking_type_id': picking_type_id,
                            'default_company_id': company_id,
                            'form_view_ref': 'tijari_wms_18.stock_move_mo_view',
                            'active_mo_id': id
                        }">
                        <list default_order="is_done, manual_consumption desc, sequence" editable="bottom">
                            <control>
                                <create string="Add a line"/>
                                <button name="action_add_from_catalog_raw" string="Catalog" type="object" class="px-4 btn-link" context="{'order_id': parent.id}"/>
                            </control>
                            <field name="product_id" force_save="1" context="{'default_is_storable': True, 'tijari_stock_picking_product_code_only': True}" required="1" readonly="move_lines_count &gt; 0 or state == 'cancel' or (state != 'draft' and not additional)" domain="['&amp;', ('type', '=', 'consu'), ('id', '!=', parent.product_id)]"/>
                            <field name="description_picking" string="Description" optional="show"/>
                            <field name="location_id" string="From" readonly="1" force_save="1" groups="stock.group_stock_multi_locations" optional="show"/>
                            <field name="product_uom" column_invisible="True"/>
                            <field name="propagate_cancel" column_invisible="True"/>
                            <field name="price_unit" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="name" column_invisible="True"/>
                            <field name="allowed_operation_ids" column_invisible="True"/>
                            <field name="unit_factor" column_invisible="True"/>
                            <field name="date_deadline" column_invisible="True" force_save="1"/>
                            <field name="date" column_invisible="True"/>
                            <field name="additional" column_invisible="True"/>
                            <field name="picking_type_id" column_invisible="True"/>
                            <field name="is_storable" column_invisible="True"/>
                            <field name="operation_id" column_invisible="True"/>
                            <field name="state" column_invisible="True" force_save="1"/>
                            <field name="is_done" column_invisible="True"/>
                            <field name="bom_line_id" column_invisible="True"/>
                            <field name="sequence" column_invisible="True"/>
                            <field name="warehouse_id" column_invisible="True"/>
                            <field name="is_locked" column_invisible="True"/>
                            <field name="move_lines_count" column_invisible="True"/>
                            <field name="has_tracking" column_invisible="True"/>
                            <field name="location_dest_id" domain="[('id', 'child_of', parent.location_dest_id)]" column_invisible="True"/>
                            <field name="should_consume_qty" column_invisible="True"/>
                            <field name="manual_consumption" column_invisible="True" force_save="1"/>
                            <field name="show_details_visible" column_invisible="True"/>
                            <field name="product_qty" readonly="1" column_invisible="True"/>
                            <field name="forecast_expected_date" column_invisible="True"/>
                            <button type="object" name="action_product_forecast_report" title="Forecast Report" icon="fa-area-chart" column_invisible="parent.state != 'draft'" invisible="forecast_availability &lt; 0"/>
                            <button type="object" name="action_product_forecast_report" title="Forecast Report" icon="fa-area-chart text-danger" column_invisible="parent.state != 'draft'" invisible="forecast_availability &gt;= 0"/>
                            <field name="forecast_availability" column_invisible="parent.state in ['done', 'cancel']" string="Forecast" widget="forecast_widget" optional="hide"/>
                            <field name="product_uom_qty" force_save="1" string="To Consume" column_invisible="not parent.show_produce_all" readonly="parent.state != 'draft' and ((parent.state not in ('confirmed', 'progress', 'to_close') and not parent.is_planned) or (parent.is_locked and state != 'draft'))"/>
                            <field name="product_uom_qty" widget="mrp_should_consume" force_save="1" string="To Consume" column_invisible="parent.show_produce_all" readonly="parent.state != 'draft' and ((parent.state not in ('confirmed', 'progress', 'to_close') and not parent.is_planned) or (parent.is_locked and state != 'draft'))"/>
                            <field name="quantity" string="Qty Target" decoration-success="not is_done and (quantity - (should_consume_qty if parent.qty_producing else product_uom_qty) == 0)" decoration-warning="not is_done and (quantity - (should_consume_qty if parent.qty_producing else product_uom_qty) &gt; 0.0001)" column_invisible="parent.state == 'draft'" decoration-info="manual_consumption" decoration-bf="manual_consumption" readonly="has_tracking != 'none'" force_save="1"/>
                            <field name="mo_confirmation_quantity" string="Qty Digunakan" optional="show"/>
                            <field name="product_uom" readonly="state != 'draft' and id" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom"/>
                            <field name="picked" string="Consumed" column_invisible="parent.state == 'draft'" optional="show"/>
                            <field name="lot_ids" widget="many2many_tags" optional="hide" string="Lot/Serial Numbers" groups="stock.group_production_lot" readonly="1" column_invisible="not parent.show_lot_ids or parent.state == 'draft'" invisible="not show_details_visible" options="{'create': [('parent.use_create_components_lots', '!=', False)]}" context="{'default_product_id': product_id}" domain="[('product_id', '=', product_id)]"/>
                            <field name="group_id" column_invisible="True"/>
                            <field name="difference_quantity" string="Difference Qty" optional="hide" readonly="1"/>
                            <field name="status_mo_check" widget="badge" decoration-success="status_mo_check == 'finished'" decoration-danger="status_mo_check == 'unfinished'"/>
                            <button name="action_open_move_mo"
                                type="object"
                                icon="fa-list"
                                title="Open Detail"/> 
                        </list>
                        <kanban class="o_kanban_mobile">
                            <templates>
                                <t t-name="card">
                                    <div class="o_wms_operation_card">
                                        <div class="o_wms_operation_product d-flex justify-content-between align-items-center">
                                            <field name="product_id" class="fs-3" context="{'tijari_stock_picking_product_code_only': True}"/>
                                            <field name="status_mo_check"
                                                    widget="badge"
                                                    decoration-success="status_mo_check == 'finished'"
                                                    decoration-danger="status_mo_check == 'unfinished'" />
                                        </div>
                                        <br/>
                                        <div>
                                            <div>
                                                <strong>To Consume: </strong>
                                                <field name="product_uom_qty"/>
                                                <field name="product_uom" groups="uom.group_uom" class="ms-1"/>
                                            </div>
                                            <div>
                                                <strong>Qty Target: </strong>
                                                <field name="quantity"/>
                                                <field name="product_uom" groups="uom.group_uom" class="ms-1"/>
                                            </div>
                                            <div>
                                                <strong>Qty Digunakan: </strong>
                                                <field name="mo_confirmation_quantity"/>
                                                <field name="product_uom" groups="uom.group_uom" class="ms-1"/>
                                            </div>
                                        </div>
                                        <br/>
                                        <button
                                            name="action_open_note_wizard"
                                            type="object"
                                            icon="fa-sticky-note"
                                            title="Note"/>
                                        <button name="action_open_move_mo"
                                            type="object"
                                            string="Open Detail"
                                            class="btn-primary"
                                        />
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>

            <xpath expr="//header" position="inside">
                <button
                    name="action_print_hasil_manufacturing"
                    string="Print"
                    type="object"
                    class="btn-primary"
                />
                <button
                    name="action_send_email_hasil_manufacturing"
                    string="Send Email"
                    type="object"
                    class="btn-secondary"
                />
            </xpath>

            <xpath expr="//field[@name='user_id']" position="before">
                <field name="name" string="Seri Dokumen" readonly="1" force_save="1" />
            </xpath>

            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page name="note" string="Notes">
                    <group name="transaction_note" string="Transaction Note">
                        <field name="catatan" nolabel="1"/>
                    </group>

                    <group name="desc_note" string="Description">
                        <field name="desc_note" nolabel="1"/>
                    </group>
                </page>
            </xpath>

            <xpath expr="//page[@name='miscellaneous']/group/group/field[@name='origin']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']" position="attributes">
                <attribute name="context">{
                    'default_date': date_start, 
                    'default_date_deadline': date_start, 
                    'default_location_id': location_src_id, 
                    'default_location_dest_id': production_location_id, 
                    'default_warehouse_id': warehouse_id, 
                    'default_state': 'draft', 
                    'default_raw_material_production_id': id, 
                    'default_picking_type_id': picking_type_id, 
                    'default_company_id': company_id, 
                    'form_view_ref': 'tijari_wms_18.stock_move_mo_view',
                    'active_mo_id': id
                }</attribute>
                <attribute name="widget"/>
                <attribute name="mode">list,kanban</attribute>
                <attribute name="readonly">state == 'cancel' or (state == 'done' and is_locked)</attribute>
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']/list" position="inside">
                <button name="action_open_move_mo"
                type="object"
                icon="fa-list"
                title="Open Detail"/> 
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']/list" position="after">
                <kanban class="o_kanban_mobile">
                    <control>
                        <create string="Add"/>
                    </control>
                    <templates>
                        <t t-name="card">
                            <div class="o_wms_operation_card">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <field name="product_id" class="fs-3" context="{'tijari_stock_picking_product_code_only': True}"/>
                                    <field name="status_mo_check"
                                        widget="badge"
                                        decoration-success="status_mo_check == 'finished'"
                                        decoration-danger="status_mo_check == 'unfinished'" />
                                </div>
                                <br/>
                                <div>
                                    <div>
                                        <strong>To Consume: </strong>
                                        <field name="product_uom_qty"/>
                                        <field name="product_uom" groups="uom.group_uom" class="ms-1"/>
                                    </div>
                                    <div>
                                        <strong>Qty Target: </strong>
                                        <field name="quantity"/>
                                        <field name="product_uom" groups="uom.group_uom" class="ms-1"/>
                                    </div>
                                    <div>
                                        <strong>Qty Digunakan: </strong>
                                        <field name="mo_confirmation_quantity"/>
                                        <field name="product_uom" groups="uom.group_uom" class="ms-1"/>
                                    </div>
                                </div>
                                <br/>
                                <button
                                    name="action_open_note_wizard"
                                    type="object"
                                    icon="fa-sticky-note"
                                    title="Note"/>
                                <button name="action_open_move_mo"
                                    type="object"
                                    string="Open Detail"
                                    class="btn btn-primary btn-sm o_wms_operation_action"
                                />
                            </div>
                        </t>
                    </templates>
                </kanban>
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="string">Qty Target</attribute>
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='quantity']" position="after">
                <field name="quantity_shadow" string="Qty Target" optional="hide" />
                <field name="mo_confirmation_quantity"/>
                <field name="difference_quantity"/>
            </xpath>
            
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='group_id']" position="after">
                <field name="status_mo_check"
                    decoration-success="status_mo_check == 'finished'"
                    decoration-danger="status_mo_check == 'unfinished'" widget="badge" 
                    force_save="1"/>
                
                <button
                    name="action_open_note_wizard"
                    type="object"
                    icon="fa-sticky-note"
                    title="Note"/>
            </xpath>
        </field>
    </record>

</odoo>
