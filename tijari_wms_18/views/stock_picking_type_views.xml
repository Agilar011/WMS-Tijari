<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_picking_type_form_wms_category_v18" model="ir.ui.view">
        <field name="name">stock.picking.type.form.wms.operation.category</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="operation_category" required="1"/>
                <field name="is_default_api" />
            </xpath>
        </field>
    </record>

    <record id="view_lot_form_inherit_custom" model="ir.ui.view">
    <field name="name">stock.lot.form.inherit.custom</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
        <xpath expr="//sheet" position="before">
            <div class="mb-2">
                <button name="action_print_lot_number" string="Print Lot" type="object" class="btn btn-primary btn-sm"/>
            </div>
        </xpath>
    </field>
</record>

</odoo>