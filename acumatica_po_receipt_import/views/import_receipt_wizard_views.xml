<odoo>
    <record id="view_import_receipt_wizard_form" model="ir.ui.view">
        <field name="name">import.receipt.wizard.form</field>
        <field name="model">import.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Inventory Receipt dari Acumatica">
                <sheet>

                    <!-- ========================= -->
                    <!-- STEP 1: INPUT -->
                    <!-- ========================= -->
                    <div invisible="state != 'draft'">
                        <div class="alert alert-info" role="alert">
                            <strong>Langkah 1:</strong>
                            Pilih konfigurasi API, atur batch &amp; filter, lalu klik
                            <b>Proses Data</b>.
                        </div>

                        <group string="Pengaturan API">
                            <group>
                                <field name="config_id" options="{'no_create': True}"/>
                                <field name="receipt_nbr"/>
                                <field name="last_modified_from"/>
                            </group>
                            <group>
                                <field name="odata_filter"/>
                            </group>
                        </group>

                        <group string="Pengaturan Batch">
                            <group>
                                <field name="batch_size"/>
                                <field name="total_limit"/>
                            </group>
                            <group>
                                <field name="direct_import"/>
                            </group>
                        </group>

                        <div class="alert alert-warning" role="alert">
                            Sistem akan mengambil data secara bertahap (batch) untuk menghindari timeout dan overload.
                        </div>
                    </div>

                    <!-- ========================= -->
                    <!-- STEP 2: HASIL -->
                    <!-- ========================= -->
                    <div invisible="state == 'draft'">

                        <div class="alert alert-success" role="alert" invisible="state != 'fetched'">
                            <strong>Data berhasil ditarik (staging).</strong>
                            Silakan review sebelum import.
                        </div>

                        <div class="alert alert-success" role="alert" invisible="state != 'done'">
                            <strong>Import selesai.</strong>
                            Semua batch telah diproses.
                        </div>

                        <group>
                            <group string="Progress">
                                <field name="processed" readonly="1"/>
                                <field name="total_fetched" readonly="1"/>
                            </group>

                            <group string="Ringkasan Data">
                                <field name="total_new" readonly="1"/>
                                <field name="total_existing" readonly="1"/>
                            </group>
                        </group>

                        <group string="Konfigurasi">
                            <group>
                                <field name="config_id" readonly="1"/>
                                <field name="batch_size" readonly="1"/>
                                <field name="total_limit" readonly="1"/>
                            </group>
                            <group>
                                <field name="receipt_nbr" readonly="1"/>
                                <field name="last_modified_from" readonly="1"/>
                            </group>
                        </group>

                    </div>

                </sheet>

                <!-- ========================= -->
                <!-- FOOTER BUTTON -->
                <!-- ========================= -->
                <footer>

                    <!-- Start Process -->
                    <button name="action_fetch_data"
                            string="Proses Data"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- Import manual (jika staging mode) -->
                    <button name="action_import_all_pending"
                            string="Import Sekarang"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'fetched'"/>

                    <!-- View staging -->
                    <button name="action_view_staging"
                            string="Lihat Data"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'fetched'"/>

                    <button string="Tutup"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_receipt_wizard" model="ir.actions.act_window">
        <field name="name">Import Inventory Receipt dari Acumatica</field>
        <field name="res_model">import.receipt.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>