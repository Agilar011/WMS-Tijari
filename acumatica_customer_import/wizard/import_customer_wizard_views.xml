<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_customer_wizard_form" model="ir.ui.view">
        <field name="name">import.customer.wizard.form</field>
        <field name="model">import.customer.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Customer dari Acumatica">
                <sheet>

                    <!-- STEP 1: Draft -->
                    <div invisible="state != 'draft'">
                        <div class="alert alert-info" role="alert">
                            <strong>📡 Langkah 1:</strong>
                            Pilih konfigurasi API, atur jumlah data, lalu klik
                            <b>Tarik Data dari Acumatica</b> untuk preview sebelum diimport.
                        </div>
                        <group string="Pengaturan">
                            <group>
                                <field name="config_id"
                                       options="{'no_create': True}"
                                       placeholder="Pilih konfigurasi API..."/>
                                <field name="fetch_limit"
                                       help="Default 50 sesuai spesifikasi"/>
                                <!-- Menampilkan field skip pada saat draft -->
                                <field name="fetch_skip"/>
                            </group>
                        </group>
                    </div>

                    <!-- STEP 2: Fetched -->
                    <div invisible="state == 'draft'">
                        <div class="alert alert-success" role="alert"
                             invisible="state != 'fetched'">
                            <strong>✅ Data Berhasil Ditarik!</strong>
                            Klik <b>Import Sekarang</b> untuk import semua,
                            atau <b>Lihat &amp; Pilih Data</b> untuk seleksi manual.
                        </div>
                        <group>
                            <group string="📊 Ringkasan Data">
                                <field name="total_fetched"  readonly="1"/>
                                <field name="total_new"      readonly="1"
                                       decoration-success="total_new > 0"/>
                                <field name="total_existing" readonly="1"
                                       decoration-warning="total_existing > 0"/>
                            </group>
                            <group string="⚙️ Konfigurasi">
                                <field name="config_id" readonly="1"/>
                                <field name="fetch_limit" readonly="1"/>
                                <!-- Menampilkan field skip pada saat ringkasan -->
                                <field name="fetch_skip" readonly="1"/>
                            </group>
                        </group>

                        <div class="alert alert-warning" role="alert"
                             invisible="total_existing == 0">
                            <strong>⚠️ Perhatian:</strong>
                            Ada <field name="total_existing" readonly="1" nolabel="1"/> customer
                            yang sudah ada di Odoo dan akan <b>diupdate</b> datanya.
                        </div>
                    </div>

                </sheet>

                <footer>
                    <button name="action_fetch_data"
                            string="📥 Tarik Data dari Acumatica"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_import_all_pending"
                            string="⬆️ Import Sekarang (Semua)"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'fetched'"/>

                    <button name="action_view_staging"
                            string="🔍 Lihat &amp; Pilih Data"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'fetched'"/>

                    <button string="Tutup"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ─── Action: Buka Wizard ─── -->
    <record id="action_import_customer_wizard" model="ir.actions.act_window">
        <field name="name">Import Customer dari Acumatica</field>
        <field name="res_model">import.customer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
