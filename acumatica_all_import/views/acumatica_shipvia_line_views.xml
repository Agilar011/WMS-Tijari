<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_import_selected_shipvia"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_shipvia_line"/>
        <field name="binding_model_id" ref="model_acumatica_shipvia_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <!-- ─── Search View ─── -->
    <record id="view_acumatica_shipvia_line_search" model="ir.ui.view">
        <field name="name">acumatica.shipvia.line.search</field>
        <field name="model">acumatica.shipvia.line</field>
        <field name="arch" type="xml">
            <search string="Cari Shipping Carrier">
                <field name="carrier_id"  string="Carrier ID"/>
                <field name="description" string="Description"/>
                <field name="city"        string="City"/>
                <field name="address"     string="Address"/>
                <field name="phone"       string="Phone"/>

                <filter string="Belum Diimport" name="pending"
                        domain="[('import_state','=','pending')]"/>
                <filter string="Sudah Dibuat"   name="imported"
                        domain="[('import_state','=','imported')]"/>
                <filter string="Diupdate"       name="updated"
                        domain="[('import_state','=','updated')]"/>
                <filter string="Error"          name="error"
                        domain="[('import_state','=','error')]"/>
                <separator/>

                <group expand="0" string="Group By">
                    <filter string="Status Import"    name="group_state"
                            context="{'group_by': 'import_state'}"/>
                    <filter string="Carrier ID"       name="group_carrier"
                            context="{'group_by': 'carrier_id'}"/>
                    <filter string="City"             name="group_city"
                            context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── List View ─── -->
    <record id="view_acumatica_shipvia_line_list" model="ir.ui.view">
        <field name="name">acumatica.shipvia.line.list</field>
        <field name="model">acumatica.shipvia.line</field>
        <field name="arch" type="xml">
            <list string="Data Shipping Carrier" multi_edit="1">
                <field name="carrier_id"    string="Carrier ID"   optional="show"/>
                <field name="description"   string="Description"  optional="show"/>
                <field name="city"          string="City"         optional="show"/>
                <field name="address"       string="Address"      optional="show"/>
                <field name="phone"         string="Phone"        optional="show"/>
                <field name="import_state"   string="Status Import" widget="badge"
                       decoration-success="import_state == 'imported'"
                       decoration-info="import_state == 'updated'"
                       decoration-warning="import_state == 'skipped'"
                       decoration-danger="import_state == 'error'"
                       decoration-muted="import_state == 'pending'"/>
                <field name="odoo_partner_id" string="Partner di Odoo" optional="show"/>
                <field name="import_message"  string="Keterangan"      optional="show"/>
                <button name="action_import_this"
                        string="Import"
                        type="object"
                        icon="fa-download"
                        invisible="import_state != 'pending'"/>
                <button name="action_open_partner"
                        string="Lihat"
                        type="object"
                        icon="fa-external-link"
                        invisible="not odoo_partner_id"/>
            </list>
        </field>
    </record>

    <!-- ─── Form View ─── -->
    <record id="view_acumatica_shipvia_line_form" model="ir.ui.view">
        <field name="name">acumatica.shipvia.line.form</field>
        <field name="model">acumatica.shipvia.line</field>
        <field name="arch" type="xml">
            <form string="Detail Shipping Carrier">
                <header>
                    <button name="action_import_this"
                            string="Import ke Odoo"
                            type="object" class="btn-primary"
                            invisible="import_state != 'pending'"/>
                    <button name="action_open_partner"
                            string="Lihat Partner di Odoo"
                            type="object" class="btn-secondary"
                            invisible="not odoo_partner_id"/>
                    <button name="action_reset_pending"
                            string="Reset ke Pending"
                            type="object"
                            invisible="import_state == 'pending'"/>
                    <field name="import_state" widget="statusbar"
                           statusbar_visible="pending,imported,updated,error"/>
                </header>
                <sheet>
                    <!-- Mandatory Fields -->
                    <group string="Field Acumatica">
                        <group>
                            <field name="external_id" string="UUID Acumatica"/>
                            <field name="description" string="Description"/>
                            <field name="carrier_id" string="Carrier ID"/>
                        </group>
                        <group>
op                            <field name="phone" string="Phone"/>
                            <field name="note_id" string="Note ID"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>

                    <!-- Hasil Import -->
                    <group string="Hasil di Odoo">
                        <field name="odoo_partner_id"/>
                        <field name="import_message"/>
                        <field name="sync_date"/>
                        <field name="config_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <chatter/>
                </div>
            </form>
        </field>
    </record>

    <!-- ─── Action ─── -->
    <record id="action_acumatica_shipvia_line" model="ir.actions.act_window">
        <field name="name">Data Shipping Carrier</field>
        <field name="res_model">acumatica.shipvia.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_shipvia_line_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data. Gunakan menu "Import ShipVia" untuk menarik data dari Acumatica.
            </p>
        </field>
    </record>

</odoo>
