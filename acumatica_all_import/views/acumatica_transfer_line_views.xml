<odoo>

    <record id="action_import_selected_transfer"
            model="ir.actions.server">
        <field name="name">Sellect All &amp; Generate</field>
        <field name="model_id" ref="model_acumatica_transfer_line"/>
        <field name="binding_model_id" ref="model_acumatica_transfer_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_transfer_line_search" model="ir.ui.view">
        <field name="name">acumatica.transfer.line.search</field>
        <field name="model">acumatica.transfer.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="receipt_nbr"/>
                <!-- <field name="transfer_order_nbr"/> -->
                <field name="inventory_id"/>
                <field name="description"/>
                <!-- <field name="warehouse"/> -->
                <field name="import_state"/>

                <filter string="Pending" name="pending" domain="[('import_state','=','pending')]"/>
                <filter string="Done" name="done" domain="[('import_state','=','done')]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>

                <group expand="0" string="Group By">
                    <filter string="Receipt" name="group_receipt" context="{'group_by': 'receipt_nbr'}"/>
                    <!-- <filter string="Transfer Order" name="group_transfer_order" context="{'group_by': 'transfer_order_nbr'}"/> -->
                    <!-- <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse'}"/> -->
                    <filter string="Status" name="group_state" context="{'group_by': 'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_transfer_line_list" model="ir.ui.view">
        <field name="name">acumatica.transfer.line.list</field>
        <field name="model">acumatica.transfer.line</field>
        <field name="arch" type="xml">
            <list string="Data Internal Transfer" multi_edit="1">
                <field name="selected" widget="boolean_toggle"/>
                <!-- <field name="transfer_order_number"/> -->
                <field name="receipt_nbr"/>
                <field name="line_nbr"/>
                <!-- <field name="inventory_id"/> -->
                <!-- <field name="transaction_description"/> -->
                <field name="product_uom_qty"/>
                <field name="uom_code"/>
                <field name="warehouse_dest_code"/>
                <field name="location_dest_code"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state in ('imported','updated')"
                       decoration-warning="import_state == 'pending'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Receipt" type="object" icon="fa-external-link" invisible="not odoo_picking_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_transfer_line_form" model="ir.ui.view">
        <field name="name">acumatica.transfer.line.form</field>
        <field name="model">acumatica.transfer.line</field>
        <field name="arch" type="xml">
            <form string="Data Internal Transfer">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'pending'"/>
                    <button name="action_open_picking" type="object" string="Open Picking" class="btn-secondary" invisible="not odoo_picking_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Pending" class="btn-secondary" invisible="import_state != 'error'"/>
                </header>
                <sheet>
                    <group string="Header">
                        <group>
                            <field name="transfer_order_number" readonly="1"/>
                            <field name="receipt_nbr" readonly="1"/>
                            <field name="receipt_type" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="warehouse_code" readonly="1"/>
                            <field name="warehouse_dest_code" readonly="1"/>
                            <field name="header_location_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="scheduled_date" readonly="1"/>
                            <field name="actual_qty" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="post_period" readonly="1"/>
                            <field name="acumatica_write_date" readonly="1"/>
                            <field name="branch_warehouse" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Details" string="Details">
                            <field name="product_line_ids">
                                <list>
                                    <field name="inventory_id"/>
                                    <field name="transaction_description"/>
                                    <field name="warehouse_dest_code"/>
                                    <field name="order_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message" readonly="1" widget="text"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>


                    <!-- <group string="Line">
                        <group>
                            <field name="line_nbr" readonly="1"/>
                            <field name="inventory_id" readonly="1"/>
                            <field name="description" readonly="1"/>
                            <field name="transaction_description" readonly="1"/>
                            <field name="line_type" readonly="1"/>
                            <field name="product_uom_qty" readonly="1"/>
                            <field name="uom_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="warehouse_dest_code" readonly="1"/>
                            <field name="location_dest_code" readonly="1"/>
                            <field name="transfer_order_line_number" readonly="1"/>
                            <field name="transfer_order_type" readonly="1"/>
                            <field name="transfer_shipment_number" readonly="1"/>
                            <field name="import_state" readonly="1"/>
                            <field name="import_message" readonly="1"/>
                        </group>
                    </group> -->
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_transfer_line" model="ir.actions.act_window">
        <field name="name">Data Internal Transfer</field>
        <field name="res_model">acumatica.transfer.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_transfer_line_search"/>
    </record>

</odoo>
