<odoo>

    <record id="action_import_selected_transfer"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_transfer_line"/>
        <field name="binding_model_id" ref="model_acumatica_transfer_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_transfer_line_search" model="ir.ui.view">
        <field name="name">acumatica.transfer.line.search</field>
        <field name="model">acumatica.transfer.line</field>
        <field name="arch" type="xml">
            <search string="Cari Data Transfer (In/SOTR)">
                <field name="receipt_nbr"/>
                <field name="document_only"/>
                <!-- <field name="transfer_order_nbr"/> -->
                <field name="inventory_id"/>
                <field name="description"/>
                <!-- <field name="warehouse"/> -->
                <field name="import_state"/>

                <filter string="Staged" name="staged" domain="[('import_state','=','staged')]"/>
                <filter string="Done" name="done" domain="[('import_state','=','done')]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>

                <group expand="0" string="Group By">
                    <filter string="Receipt" name="group_receipt" context="{'group_by': 'receipt_nbr'}"/>
                    <!-- <filter string="Transfer Order" name="group_transfer_order" context="{'group_by': 'transfer_order_nbr'}"/> -->
                    <!-- <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse'}"/> -->
                    <filter string="Status" name="group_state" context="{'group_by': 'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_transfer_line_list" model="ir.ui.view">
        <field name="name">acumatica.transfer.line.list</field>
        <field name="model">acumatica.transfer.line</field>
        <field name="arch" type="xml">
            <list string="Data Transfer (In/SOTR)" multi_edit="1">
                <!-- <field name="transfer_order_number"/> -->
                <field name="receipt_nbr"/>
                <field name="receipt_type"/>
                <field name="vendor_code"/>
                <field name="vendor_name"/>
                <field name="building_code"/>
                <!-- <field name="line_nbr"/> -->
                <!-- <field name="inventory_id"/> -->
                <!-- <field name="transaction_description"/> -->
                <field name="warehouse_code"/>
                <field name="warehouse_dest_code"/>
                <field name="total_qty"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state == 'created'" decoration-info="import_state == 'updated'" decoration-warning="import_state == 'rejected'"
                       decoration-muted="import_state == 'staged'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Document" type="object" icon="fa-external-link" invisible="not odoo_picking_id and not odoo_internal_transfer_order_id"/>
                <field name="odoo_picking_id" column_invisible="1"/>
                <field name="odoo_internal_transfer_order_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_transfer_line_form" model="ir.ui.view">
        <field name="name">acumatica.transfer.line.form</field>
        <field name="model">acumatica.transfer.line</field>
        <field name="arch" type="xml">
            <form string="Transfer (In/SOTR)">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'staged'"/>
                    <button name="action_open_picking" type="object" string="Open Document" class="btn-secondary" invisible="not odoo_picking_id and not odoo_internal_transfer_order_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Staged" class="btn-secondary" invisible="import_state != 'error'"/>
                </header>
                <sheet>
                    <group string="Header">
                        <group>
                            <field name="external_id"/>
                            <field name="row_number"/>
                            <field name="transfer_order_number"/>
                            <field name="transfer_shipment_number"/>
                            <field name="receipt_nbr"/>
                            <field name="receipt_type"/>
                            <field name="status" readonly="1"/>
                            <field name="vendor_code"/>
                            <field name="vendor_name"/>
                            <field name="partner_ref"/>
                            <field name="building_code"/>
                            <field name="warehouse_code"/>
                            <field name="warehouse_dest_code"/>
                            <field name="header_location_code"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="actual_qty"/>
                            <field name="total_qty"/>
                            <field name="post_period"/>
                            <field name="acumatica_write_date"/>
                            <field name="branch_warehouse"/>
                            <field name="note_header_id"/>
                            <field name="inventory_ref"/>
                            <field name="is_hold"/>
                            <field name="document_only"/>
                            <field name="picking_type_id" readonly="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Details" string="Details">
                            <field name="product_line_ids">
                                <list>
                                    <field name="line_external_id"/>
                                    <field name="line_nbr"/>
                                    <field name="line_branch"/>
                                    <field name="inventory_id"/>
                                    <field name="description"/>
                                    <field name="transaction_description"/>
                                    <field name="line_type"/>
                                    <field name="location_dest_code"/>
                                    <field name="warehouse_dest_code"/>
                                    <field name="open_qty"/>
                                    <field name="order_qty"/>
                                    <field name="product_uom_qty"/>
                                    <field name="uom_code"/>
                                    <field name="po_line_number"/>
                                    <field name="po_number"/>
                                    <field name="po_type"/>
                                    <field name="po_receipt_line_number"/>
                                    <field name="po_receipt_number"/>
                                    <field name="transfer_order_line_number"/>
                                    <field name="transfer_order_number"/>
                                    <field name="transfer_order_type"/>
                                    <field name="transfer_shipment_number"/>
                                    <field name="line_note_id"/>
                                    <field name="line_note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message" readonly="1" widget="text"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="odoo_internal_transfer_order_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>


                    <!-- <group string="Line">
                        <group>
                            <field name="line_nbr"/>
                            <field name="inventory_id"/>
                            <field name="description"/>
                            <field name="transaction_description"/>
                            <field name="line_type"/>
                            <field name="product_uom_qty"/>
                            <field name="uom_code"/>
                        </group>
                        <group>
                            <field name="warehouse_dest_code"/>
                            <field name="location_dest_code"/>
                            <field name="transfer_order_line_number"/>
                            <field name="transfer_order_type"/>
                            <field name="transfer_shipment_number"/>
                            <field name="import_state" readonly="1"/>
                            <field name="import_message" readonly="1"/>
                        </group>
                    </group> -->
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_transfer_line" model="ir.actions.act_window">
        <field name="name">Data Transfer (In/SOTR)</field>
        <field name="res_model">acumatica.transfer.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_transfer_line_search"/>
    </record>

</odoo>
