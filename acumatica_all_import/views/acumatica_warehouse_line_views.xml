<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_import_selected_warehouse"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_warehouse_line"/>
        <field name="binding_model_id" ref="model_acumatica_warehouse_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- HEADER: acumatica.warehouse.line                   -->
    <!-- ══════════════════════════════════════════════════ -->

    <!-- ─── Search View ─── -->
    <record id="view_acumatica_warehouse_line_search" model="ir.ui.view">
        <field name="name">acumatica.warehouse.line.search</field>
        <field name="model">acumatica.warehouse.line</field>
        <field name="arch" type="xml">
            <search string="Cari Warehouse &amp; Location">
                <field name="warehouse_id"  string="WarehouseID"/>
                <field name="description"   string="Description"/>
                <filter string="Staged" name="staged"
                        domain="[('import_state','=','staged')]"/>
                <filter string="Sudah Dibuat"   name="created"
                        domain="[('import_state','=','created')]"/>
                <filter string="Updated"       name="updated"
                        domain="[('import_state','=','updated')]"/>
                <filter string="Error"          name="error"
                        domain="[('import_state','=','error')]"/>
                <separator/>
                <filter string="Active saja"    name="active_only"
                        domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status Import" name="group_state"
                            context="{'group_by': 'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── List View: Header ─── -->
    <record id="view_acumatica_warehouse_line_list" model="ir.ui.view">
        <field name="name">acumatica.warehouse.line.list</field>
        <field name="model">acumatica.warehouse.line</field>
        <field name="arch" type="xml">
            <list string="Data Warehouse &amp; Location" multi_edit="1">
                <field name="warehouse_id" string="WarehouseID"/>
                <field name="building_id" string="BuildingID"/>
                <field name="description"    string="Description → name"/>
                <field name="active"         string="Active"         widget="boolean"
                       optional="show"/>
                <field name="rma_location_id"       string="RMA Loc"        optional="show"/>
                <field name="receiving_location_id" string="Receiving Loc"  optional="show"/>
                <field name="shipping_location_id"  string="Shipping Loc"   optional="show"/>
                <field name="last_modified_dt"      string="Last Modified"  optional="show"/>
                <field name="import_state"   string="Status" widget="badge"
                       decoration-success="import_state == 'created'"
                       decoration-info="import_state == 'updated'"
                       decoration-danger="import_state == 'error'"
                       decoration-muted="import_state == 'staged'"/>
                <field name="odoo_warehouse_id" string="Document Reference" optional="show"/>
                <field name="import_message"    string="Generation Message"        optional="show"/>
                <button name="action_import_this"
                        string="Import"
                        type="object"
                        icon="fa-download"
                        invisible="import_state != 'staged'"/>
                <button name="action_open_warehouse"
                        string="Lihat"
                        type="object"
                        icon="fa-external-link"
                        invisible="not odoo_warehouse_id"/>
            </list>
        </field>
    </record>

    <!-- ─── Form View: Header ─── -->
    <record id="view_acumatica_warehouse_line_form" model="ir.ui.view">
        <field name="name">acumatica.warehouse.line.form</field>
        <field name="model">acumatica.warehouse.line</field>
        <field name="arch" type="xml">
            <form string="Data Warehouse &amp; Location">
                <header>
                    <button name="action_import_this"
                            string="Import ke Odoo"
                            type="object" class="btn-primary"
                            invisible="import_state != 'staged'"/>
                    <button name="action_open_warehouse"
                            string="Lihat Document Reference"
                            type="object" class="btn-secondary"
                            invisible="not odoo_warehouse_id"/>
                    <button name="action_reset_pending"
                            string="Reset ke Pending"
                            type="object"
                            invisible="import_state != 'error'"/>
                    <field name="import_state" widget="statusbar"
                           statusbar_visible="staged,created,updated,rejected,error"/>
                </header>
                <style>
                    div.o-mail-ChatterContainer.o-mail-Form-chatter div.o-mail-Message-richBody.overflow-x-auto {
                        overflow: visible !important;
                    }
                </style>
                <sheet>
                    <!-- ── Field Sudah Ada di Odoo ── -->
                    <group string="Data Warehouse &amp; Location">
                        <group>
                            <field name="warehouse_id"  string="WarehouseID.warehouse.code"/>
                            <field name="building_id"   string="BuildingID.warehouse.building"/>
                        </group>
                        <group>
                            <field name="description"   string="Description.warehouse.name"/>
                            <field name="active"        string="Active"/>
                        </group>
                    </group>

                    <!-- ── Field to be ── -->
                    <group string="Optional Data">
                        <group>
                            <field name="drop_ship_location_id"  string="DropShipLocationID"/>
                            <field name="receiving_location_id"  string="ReceivingLocationID"/>
                            <field name="rma_location_id"        string="RMALocationID"/>
                            <field name="shipping_location_id"   string="ShippingLocationID"/>
                        </group>
                        <group>
                            <field name="last_modified_dt"       string="LastModifiedDateTime"/>
                            <field name="external_id"            string="UUID"/>
                            <field name="sync_date"/>
                            <field name="config_id"/>
                        </group>
                    </group>

                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>

                    <!-- ── Hasil Import ── -->
                    <group string="Hasil di Odoo">
                        <field name="odoo_warehouse_id"/>
                        <field name="import_message"/>
                    </group>

                    <!-- ── Detail Locations ── -->
                    <!-- <notebook>
                        <page string="📍 Locations" name="locations">
                            <list string="Locations" editable="bottom">
                                <field name="row_number"    string="No"/>
                                <field name="warehouse_id"  string="LocationID → name"/>
                                <field name="description"   string="Description → adt_description"/>
                                <field name="active"        string="Active" widget="boolean"/>
                                <field name="import_state"  string="Status" widget="badge"
                                       decoration-success="import_state == 'created'"
                                       decoration-info="import_state == 'updated'"
                                       decoration-danger="import_state == 'error'"
                                       decoration-muted="import_state == 'staged'"/>
                                <field name="odoo_warehouse_id" string="Location di Odoo"/>
                                <field name="import_message"   string="Generation Message"/>
                                <button name="action_open_warehouse"
                                        string="Lihat"
                                        type="object"
                                        icon="fa-external-link"
                                        invisible="not odoo_warehouse_id"/>
                            </list>
                        </page>
                    </notebook> -->
                </sheet>
                <div class="oe_chatter">
                    <chatter/>
                </div>
            </form>
        </field>
    </record>

    <!-- ─── Action: List Staging Header ─── -->
    <record id="action_acumatica_warehouse_line" model="ir.actions.act_window">
        <field name="name">Data Warehouse Acumatica</field>
        <field name="res_model">acumatica.warehouse.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_warehouse_line_search"/>
        <field name="context">{'search_default_staged': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data. Gunakan menu "Import Warehouse" untuk menarik data dari Acumatica.
            </p>
        </field>
    </record>

</odoo>
