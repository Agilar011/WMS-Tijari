<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_customer_location_wizard_form" model="ir.ui.view">
        <field name="name">import.customer.location.wizard.form</field>
        <field name="model">import.customer.location.wizard</field>
        <field name="arch" type="xml">

            <form string="Import Customer Location">

                <sheet>

                    <!-- STEP 1 -->
                    <group string="Pengaturan Import" invisible="state != 'draft'">

                        <field name="config_id"/>

                        <field name="fetch_limit"/>

                        <field name="fetch_skip"/>

                        <field name="total_target"
                               placeholder="Kosongkan untuk ambil semua data"/>

                    </group>

                    <!-- STEP 2 -->
                    <group string="Hasil Fetch" invisible="state == 'draft'">

                        <field name="total_fetched" readonly="1"/>
                        <field name="total_new" readonly="1"/>
                        <field name="total_existing" readonly="1"/>
                        <field name="total_no_customer" readonly="1"/>

                    </group>

                </sheet>

                <footer>

                    <button name="action_fetch_data"
                            string="Fetch Data"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_import_all_pending"
                            string="Import Semua"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'fetched'"/>

                    <button string="Tutup"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="action_import_customer_location_wizard" model="ir.actions.act_window">
        <field name="name">Import Customer Location</field>
        <field name="res_model">import.customer.location.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>