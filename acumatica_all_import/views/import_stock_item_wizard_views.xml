<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_stock_item_wizard_form" model="ir.ui.view">
        <field name="name">import.stock.item.wizard.form</field>
        <field name="model">import.stock.item.wizard</field>
        <field name="arch" type="xml">

            <form string="Import Stock Item dari Acumatica">

                <sheet>

                    <!-- STEP 1: DRAFT -->
                    <div invisible="state != 'draft'">

                        <div class="alert alert-info" role="alert">
                            <strong>Langkah 1:</strong>
                            Pilih API, tentukan batch size, total data, dan titik awal.
                            Klik <b>Tarik Data dari Acumatica</b>.
                        </div>

                        <group string="Pengaturan">
                            <group>
                                <field name="config_id"
                                       options="{'no_create': True}"
                                       placeholder="Pilih konfigurasi API..."/>

                                <field name="fetch_limit"
                                       string="Batch Size"/>

                                <field name="fetch_skip"
                                       string="Mulai dari Data ke-"/>

                                <field name="total_target"
                                       placeholder="Kosongkan untuk ambil semua data"/>
                            </group>
                        </group>

                    </div>

                    <!-- STEP 2: FETCHED -->
                    <div invisible="state == 'draft'">

                        <div class="alert alert-success"
                             role="alert"
                             invisible="state != 'fetched'">
                            <strong>Data Berhasil Ditarik!</strong>
                            Klik <b>Import Sekarang</b> atau <b>Lihat &amp; Pilih Data</b>.
                        </div>

                        <group>

                            <group string="Ringkasan Data">
                                <field name="total_fetched" readonly="1"/>
                                <field name="total_new" readonly="1"/>
                                <field name="total_existing" readonly="1"/>
                            </group>

                            <group string="Konfigurasi">
                                <field name="config_id" readonly="1"/>
                                <field name="fetch_limit" readonly="1"/>
                                <field name="fetch_skip" readonly="1"/>
                                <field name="total_target" readonly="1"/>
                            </group>

                        </group>

                        <div class="alert alert-warning"
                             role="alert"
                             invisible="total_existing == 0">
                            <strong>Perhatian:</strong>
                            Ada <field name="total_existing" readonly="1" nolabel="1"/> item
                            yang sudah ada dan akan <b>diupdate</b>.
                        </div>

                    </div>

                </sheet>

                <footer>

                    <button name="action_fetch_data"
                            string="Tarik Data dari Acumatica"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- ✅ TAMBAHAN -->
                    <button name="action_import_batch"
                            string="Import 1000 Data (Batch)"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'fetched'"/>

                    <button name="action_import_all_pending"
                            string="Import Sekarang (Semua)"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'fetched'"/>

                    <button name="action_view_staging"
                            string="Lihat &amp; Pilih Data"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'fetched'"/>

                    <button string="Tutup"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="action_import_stock_item_wizard" model="ir.actions.act_window">
        <field name="name">Import Stock Item dari Acumatica</field>
        <field name="res_model">import.stock.item.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>