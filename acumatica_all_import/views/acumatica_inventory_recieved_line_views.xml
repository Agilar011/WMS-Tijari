<odoo>
    <record id="view_acumatica_inventory_recieved_line_list" model="ir.ui.view">
        <field name="name">acumatica.inventory.recieved.line.list</field>
        <field name="model">acumatica.inventory.recieved.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="selected" widget="boolean_toggle"/>
                <field name="reference_nbr"/>
                <field name="line_nbr"/>
                <field name="inventory_id"/>
                <field name="description"/>
                <field name="product_uom_qty"/>
                <field name="uom_code"/>
                <field name="location_code"/>
                <field name="detail_warehouse_code"/>
                <field name="import_state"/>
                <field name="import_message"/>
                <button name="action_import_this" type="object" string="Import" class="btn-primary" invisible="import_state != 'pending'"/>
                <button name="action_open_picking" type="object" string="Open Picking" invisible="not odoo_picking_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_inventory_recieved_line_form" model="ir.ui.view">
        <field name="name">acumatica.inventory.recieved.line.form</field>
        <field name="model">acumatica.inventory.recieved.line</field>
        <field name="arch" type="xml">
            <form string="Data Inventory Recieved Acumatica">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'pending'"/>
                    <button name="action_open_picking" type="object" string="Open Picking" invisible="not odoo_picking_id"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="pending,imported,updated,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Header">
                            <field name="reference_nbr"/>
                            <field name="scheduled_date"/>
                            <field name="header_description"/>
                            <field name="actual_qty"/>
                            <field name="is_hold"/>
                            <field name="acumatica_write_date"/>
                            <field name="post_period"/>
                            <field name="status"/>
                            <field name="total_qty"/>
                            <field name="warehouse_code"/>
                            <field name="transfer_type"/>
                            <field name="note"/>
                        </group>
                        <group string="Detail">
                            <field name="line_nbr"/>
                            <field name="inventory_id"/>
                            <field name="description"/>
                            <field name="location_code"/>
                            <field name="product_uom_qty"/>
                            <field name="uom_code"/>
                            <field name="detail_warehouse_code"/>
                            <field name="line_note"/>
                            <field name="import_message"/>
                            <field name="odoo_picking_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_inventory_recieved_line" model="ir.actions.act_window">
        <field name="name">Data Inventory Recieved</field>
        <field name="res_model">acumatica.inventory.recieved.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
