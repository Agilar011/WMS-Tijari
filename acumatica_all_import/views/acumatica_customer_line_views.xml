<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Search View ─── -->
    <record id="view_acumatica_customer_line_search" model="ir.ui.view">
        <field name="name">acumatica.customer.line.search</field>
        <field name="model">acumatica.customer.line</field>
        <field name="arch" type="xml">
            <search string="Cari Customer">
                <field name="customer_id"   string="CustomerID"/>
                <field name="customer_name" string="CustomerName"/>
                <field name="customer_class" string="CustomerClass"/>
                <field name="status"        string="Status"/>
                <field name="warehouse_id"  string="WarehouseID"/>

                <filter string="Belum Diimport" name="pending"
                        domain="[('import_state','=','pending')]"/>
                <filter string="Sudah Dibuat"   name="imported"
                        domain="[('import_state','=','imported')]"/>
                <filter string="Diupdate"       name="updated"
                        domain="[('import_state','=','updated')]"/>
                <filter string="Error"          name="error"
                        domain="[('import_state','=','error')]"/>
                <separator/>
                <filter string="Dipilih"        name="selected"
                        domain="[('selected','=',True)]"/>
                <filter string="Status Active"  name="active_only"
                        domain="[('status','=ilike','active')]"/>

                <group expand="0" string="Group By">
                    <filter string="Status Import"  name="group_state"
                            context="{'group_by': 'import_state'}"/>
                    <filter string="Status Acumatica" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Customer Class" name="group_class"
                            context="{'group_by': 'customer_class'}"/>
                    <filter string="Warehouse"      name="group_warehouse"
                            context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── List View: Data Staging ─── -->
    <record id="view_acumatica_customer_line_list" model="ir.ui.view">
        <field name="name">acumatica.customer.line.list</field>
        <field name="model">acumatica.customer.line</field>
        <field name="arch" type="xml">
            <list string="Data Customer dari Acumatica" multi_edit="1">
                <field name="selected" optional="show"/>
                <field name="row_number"    string="No"           optional="show"/>
                <field name="customer_id"   string="CustomerID"   />
                <field name="b_account_id"  string="BAccountID"   optional="show"/>
                <field name="customer_name" string="CustomerName" />
                <field name="customer_class" string="CustomerClass" optional="show"/>
                <field name="status"        string="Status"
                       decoration-success="status == 'Active'"
                       decoration-muted="status == 'Inactive'"
                       decoration-warning="status == 'Hold'"/>
                <field name="currency_id"   string="CurrencyID"   optional="show"/>
                <field name="warehouse_id"  string="WarehouseID"  optional="show"/>
                <field name="shipping_zone_id" string="ShippingZone" optional="show"/>
                <field name="fob_point"     string="FOBPoint"     optional="show"/>
                <field name="location_name" string="LocationName" optional="show"/>
                <field name="import_state"  string="Status Import" widget="badge"
                       decoration-success="import_state == 'imported'"
                       decoration-info="import_state == 'updated'"
                       decoration-warning="import_state == 'skipped'"
                       decoration-danger="import_state == 'error'"
                       decoration-muted="import_state == 'pending'"/>
                <field name="odoo_partner_id" string="Partner di Odoo" optional="show"/>
                <field name="import_message"  string="Keterangan"      optional="show"/>
                <button name="action_import_this"
                        string="Import"
                        type="object"
                        icon="fa-download"
                        invisible="import_state != 'pending'"/>
                <button name="action_open_partner"
                        string="Lihat Partner"
                        type="object"
                        icon="fa-external-link"
                        invisible="not odoo_partner_id"/>
            </list>
        </field>
    </record>

    <!-- ─── Form View: Detail Baris ─── -->
    <record id="view_acumatica_customer_line_form" model="ir.ui.view">
        <field name="name">acumatica.customer.line.form</field>
        <field name="model">acumatica.customer.line</field>
        <field name="arch" type="xml">
            <form string="Detail Data Customer">
                <header>
                    <button name="action_import_this"
                            string="Import ke Odoo"
                            type="object"
                            class="btn-primary"
                            invisible="import_state != 'pending'"/>
                    <button name="action_open_partner"
                            string="Lihat Partner di Odoo"
                            type="object"
                            class="btn-secondary"
                            invisible="not odoo_partner_id"/>
                    <button name="action_reset_pending"
                            string="Reset ke Pending"
                            type="object"
                            invisible="import_state == 'pending'"/>
                    <field name="import_state" widget="statusbar"
                           statusbar_visible="pending,imported,updated,skipped,error"/>
                </header>
                <sheet>
                    <!-- ── Mandatory Fields ── -->
                    <group string="📋 Field Mandatory">
                        <group>
                            <field name="customer_id"   string="CustomerID → company_registry"/>
                            <field name="b_account_id"  string="BAccountID → property_b_account_id (to be)"/>
                            <field name="customer_name" string="CustomerName → name"/>
                            <field name="status"        string="Status → property_state_acumatica (to be)"/>
                        </group>
                        <group>
                            <field name="warehouse_id"    string="WarehouseID → property_stock_supplier (to be)"/>
                            <field name="shipping_zone_id" string="ShippingZoneID → property_shipping_zone_id (to be)"/>
                            <field name="fob_point"        string="FOBPoint → property_fob_point (to be)"/>
                        </group>
                    </group>

                    <!-- ── Optional Fields ── -->
                    <group string="📝 Field Optional">
                        <group>
                            <field name="customer_class"   string="CustomerClass → property_class (to be)"/>
                            <field name="currency_id"      string="CurrencyID → property_currency_acumatica (to be)"/>
                            <field name="location_name"    string="LocationName → name (contact)"/>
                        </group>
                        <group>
                            <field name="created_datetime"        string="CreatedDateTime → property_created_datetime (to be)"/>
                            <field name="last_modified_datetime"   string="LastModifiedDateTime → property_last_modified_datetime (to be)"/>
                            <field name="note_id"                  string="NoteID → acumatica_note_id (to be)"/>
                        </group>
                    </group>

                    <group string="📝 Note">
                        <field name="note" string="Note → acumatica_note (to be)" nolabel="1"/>
                    </group>

                    <!-- ── Hasil Import ── -->
                    <group string="🔗 Hasil di Odoo">
                        <group>
                            <field name="odoo_partner_id"/>
                            <field name="import_message"/>
                        </group>
                        <group>
                            <field name="sync_date"/>
                            <field name="config_id"/>
                            <field name="external_id"/>
                            <field name="row_number"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── Action: List Staging ─── -->
    <record id="action_acumatica_customer_line" model="ir.actions.act_window">
        <field name="name">Data Customer Acumatica</field>
        <field name="res_model">acumatica.customer.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_customer_line_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data. Gunakan menu "Import Customer" untuk menarik data dari Acumatica.
            </p>
        </field>
    </record>

</odoo>
