<odoo>
    <record id="action_import_selected_issue_po_return"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_issue_po_return_line"/>
        <field name="binding_model_id" ref="model_acumatica_issue_po_return_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_issue_po_return_line_list" model="ir.ui.view">
        <field name="name">acumatica.issue.po.return.line.list</field>
        <field name="model">acumatica.issue.po.return.line</field>
        <field name="arch" type="xml">
            <list string="Data PO Return">
                <field name="selected" widget="boolean_toggle"/>
                <field name="receipt_nbr"/>
                <field name="building_code" optional="show"/>
                <field name="customer_id" optional="show"/>
                <field name="customer_name" optional="show"/>
                <field name="shipment_nbr" optional="show"/>
                <field name="transfer_nbr" optional="show"/>
                <field name="receipt_type"/>
                <field name="document_only"/>
                <field name="vendor_code"/>
                <field name="warehouse_code"/>
                <field name="total_qty"/>
                <field name="acumatica_write_date" string="Last Modified"/>
                <!-- <field name="inventory_id"/> -->
                <!-- <field name="transaction_description"/> -->
                <!-- <field name="product_uom_qty"/> -->
                <!-- <field name="uom_code"/> -->
                <!-- <field name="location_dest_code"/> -->
                <field name="import_state" widget="badge"
                       decoration-success="import_state == 'created'" decoration-info="import_state == 'updated'" decoration-warning="import_state == 'rejected'"
                       decoration-muted="import_state == 'staged'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Document" type="object" icon="fa-external-link" invisible="not odoo_picking_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_issue_po_return_line_form" model="ir.ui.view">
        <field name="name">acumatica.issue.po.return.line.form</field>
        <field name="model">acumatica.issue.po.return.line</field>
        <field name="arch" type="xml">
            <form string="Data PO Return">
                <header>
                    <button name="action_reset_pending" type="object" string="Reset Staged" class="btn-secondary" invisible="import_state != 'error'"/>
                    <button name="action_import_this" string="Import Baris Ini" type="object" class="btn-primary" invisible="import_state != 'staged'"/>
                    <button name="action_open_picking" string="Open Document" type="object" invisible="not odoo_picking_id"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="staged,created,updated,rejected,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Header Receipt">
                            <field name="receipt_nbr"/>
                            <field name="building_code"/>
                            <field name="change_item_ref_nbr"/>
                            <field name="customer_id"/>
                            <field name="customer_location_id"/>
                            <field name="customer_location_name"/>
                            <field name="customer_name"/>
                            <field name="doc_type"/>
                            <field name="external_ref"/>
                            <field name="note_header_id"/>
                            <field name="shipment_nbr"/>
                            <field name="transfer_nbr"/>
                            <field name="trans_type"/>
                            <field name="vendor_code"/>
                            <field name="partner_ref"/>
                            <field name="scheduled_date"/>
                            <field name="warehouse_code"/>
                            <field name="header_location_code"/>
                            <field name="status"/>
                            <field name="receipt_type"/>
                            <field name="actual_qty"/>
                            <field name="total_qty"/>
                            <field name="is_hold"/>
                            <field name="inventory_ref"/>
                            <field name="post_period"/>
                            <field name="acumatica_write_date"/>
                            <field name="branch_warehouse"/>
                            <field name="note"/>
                        </group>
                        <group string="Detail Line">
                            <field name="line_nbr"/>
                            <field name="line_inventory_name"/>
                            <field name="line_location_name"/>
                            <field name="line_note_id"/>
                            <field name="line_warehouse"/>
                            <field name="line_warehouse_name"/>
                            <field name="inventory_id"/>
                            <field name="transaction_description"/>
                            <field name="description"/>
                            <field name="line_type"/>
                            <field name="location_dest_code"/>
                            <field name="open_qty"/>
                            <field name="order_qty"/>
                            <field name="po_line_number"/>
                            <field name="po_number"/>
                            <field name="po_type"/>
                            <field name="po_receipt_line_number"/>
                            <field name="po_receipt_number"/>
                            <field name="product_uom_qty"/>
                            <field name="uom_code"/>
                            <field name="warehouse_dest_code"/>
                            <field name="transfer_order_line_number"/>
                            <field name="transfer_order_number"/>
                            <field name="transfer_order_type"/>
                            <field name="transfer_shipment_number"/>
                            <field name="line_note"/>
                        </group>
                    </group>
                    <notebook name="Details">
                        <page string="All Shipment Lines" name="all_shipment_lines">
                            <field name="product_line_ids">
                                <list>
                                    <field name="inventory_id"/>
                                    <field name="line_note"/>
                                    <field name="warehouse_code"/>
                                    <field name="product_uom_qty"/>
                                    <field name="order_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message"/>
                        <field name="odoo_picking_id"/>
                        <field name="exists_in_odoo"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_issue_po_return_line" model="ir.actions.act_window">
        <field name="name">Data PO Return</field>
        <field name="res_model">acumatica.issue.po.return.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
