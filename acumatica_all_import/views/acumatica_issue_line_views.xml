<odoo>
    <record id="action_import_selected_issue"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_issue_line"/>
        <field name="binding_model_id" ref="model_acumatica_issue_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_issue_line_search" model="ir.ui.view">
        <field name="name">acumatica.issue.line.search</field>
        <field name="model">acumatica.issue.line</field>
        <field name="arch" type="xml">
            <search string="Cari Data Issue : Change Item">
                <field name="reference_nbr"/>
                <field name="document_only"/>
                <field name="inventory_id"/>
                <field name="line_description"/>
                <field name="import_state"/>
                <filter string="Staged" name="staged" domain="[('import_state','=','staged')]"/>
                <filter string="Generated" name="generated" domain="[('import_state','in',('created','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>
            </search>
        </field>
    </record>

    <record id="view_acumatica_issue_line_list" model="ir.ui.view">
        <field name="name">acumatica.issue.line.list</field>
        <field name="model">acumatica.issue.line</field>
        <field name="arch" type="xml">
            <list string="Data Issue : Change Item" multi_edit="1">
                <field name="selected" widget="boolean_toggle"/>
                <field name="reference_nbr"/>
                <field name="trans_type"/>
                <field name="warehouse_code"/>
                <field name="total_qty"/>
                <!-- <field name="line_description"/> -->
                <!-- <field name="product_uom_qty"/> -->
                <!-- <field name="uom_code"/> -->
                <!-- <field name="warehouse_code"/> -->
                <!-- <field name="location_code"/> -->
                <!-- <field name="import_state"/> -->
                <!-- <field name="import_message"/> -->

                <field name="import_state" widget="badge"
                       decoration-success="import_state in ('created','updated')"
                       decoration-warning="import_state == 'staged'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Document" type="object" icon="fa-external-link" invisible="not odoo_picking_id"/>

            </list>
        </field>
    </record>

    <record id="view_acumatica_issue_line_form" model="ir.ui.view">
        <field name="name">acumatica.issue.line.form</field>
        <field name="model">acumatica.issue.line</field>
        <field name="arch" type="xml">
            <form string="Data Issue : Change Item">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'staged'"/>
                    <button name="action_open_picking" type="object" string="Open Document" class="btn-secondary" invisible="not odoo_picking_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Staged" class="btn-secondary" invisible="import_state != 'error'"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="staged,created,updated,rejected,error"/>
                </header>
                <sheet>
                    <!-- Group Header Utama -->
                    <group string="Header">
                        <group>
                            <field name="reference_nbr"/>
                            <field name="scheduled_date"/>
                            <field name="status"/>
                            <field name="trans_type"/>
                            <field name="actual_qty"/>
                            <field name="total_qty"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="external_ref"/>
                            <field name="post_period"/>
                            <field name="acumatica_write_date"/>
                            <field name="note"/>
                        </group>
                    </group>

                    <!-- PERBAIKAN: Notebook dikeluarkan dari tag <group> -->
                    <notebook>
                        <page name="Details" string="Details">
                            <field name="product_line_ids">
                                <!-- CATATAN: Gunakan <tree> jika Odoo versi 16 ke bawah, gunakan <list> jika Odoo 17/18 -->
                                <list edit="0">
                                    <field name="inventory_id"/>
                                    <field name="description"/>
                                    <field name="warehouse_code"/>
                                    <field name="product_uom_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message"/>
                        <field name="odoo_picking_id"/>
                        <field name="exists_in_odoo"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_acumatica_issue_line" model="ir.actions.act_window">
        <field name="name">Data Issue : Change Item</field>
        <field name="res_model">acumatica.issue.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_issue_line_search"/>
    </record>

</odoo>
