<odoo>
    <record id="action_import_selected_transfer_shipment"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_transfer_shipment_line"/>
        <field name="binding_model_id" ref="model_acumatica_transfer_shipment_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_transfer_shipment_line_search" model="ir.ui.view">
        <field name="name">acumatica.transfer.shipment.line.search</field>
        <field name="model">acumatica.transfer.shipment.line</field>
        <field name="arch" type="xml">
            <search string="Cari Data Transfer - Inter Warehouse : OUT">
                <field name="shipment_nbr"/>
                <!-- <field name="order_number"/> -->
                <!-- <field name="inventory_id"/> -->
                <field name="warehouse_code"/>
                <filter string="Pending" name="pending" domain="[('import_state','=','pending')]"/>
                <filter string="Imported" name="imported" domain="[('import_state','in',('imported','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Shipment" name="group_shipment" context="{'group_by':'shipment_nbr'}"/>
                    <filter string="Warehouse" name="group_wh" context="{'group_by':'warehouse_code'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_transfer_shipment_line_list" model="ir.ui.view">
        <field name="name">acumatica.transfer.shipment.line.list</field>
        <field name="model">acumatica.transfer.shipment.line</field>
        <field name="arch" type="xml">
            <list string="Data Transfer - Inter Warehouse : OUT" multi_edit="1">
                <field name="selected"/>
                <field name="shipment_nbr"/>
                <field name="picking_type_id"/>
                <!-- <field name="order_number"/>
                <field name="inventory_id"/> -->
                <!-- <field name="line_description"/>
                <field name="product_uom_qty"/>
                <field name="uom_code"/>
                <field name="warehouse_code"/>
                <field name="warehouse_dest_code"/>
                <field name="location_dest_code"/>
                <field name="scheduled_date"/> -->
                <field name="import_state"/>
                <field name="import_message"/>
                <button name="action_import_this" type="object" string="Import" class="btn-primary" invisible="import_state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_transfer_shipment_line_form" model="ir.ui.view">
        <field name="name">acumatica.transfer.shipment.line.form</field>
        <field name="model">acumatica.transfer.shipment.line</field>
        <field name="arch" type="xml">
            <form string="Data Transfer - Inter Warehouse : OUT">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'pending'"/>
                    <button name="action_reset_pending" type="object" string="Reset Pending" class="btn-secondary" invisible="import_state != 'error'"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="pending,imported,updated,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="selected"/>
                            <field name="shipment_nbr" readonly="1"/>
                            <field name="picking_type_id"/>
                            <!-- <field name="order_number" readonly="1"/>
                            <field name="order_type" readonly="1"/>
                            <field name="inventory_id" readonly="1"/>
                            <field name="line_description" readonly="1"/>
                            <field name="product_uom_qty" readonly="1"/>
                            <field name="uom_code" readonly="1"/>
                            <field name="warehouse_code" readonly="1"/>
                            <field name="warehouse_dest_code" readonly="1"/>
                            <field name="location_dest_code" readonly="1"/>
                            <field name="scheduled_date" readonly="1"/> -->
                            <field name="partner_code" readonly="1"/>
                            <field name="odoo_picking_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="operation" readonly="1"/>
                            <field name="shipment_type" readonly="1"/>
                            <field name="actual_qty" readonly="1"/>
                            <field name="shipped_qty" readonly="1"/>
                            <field name="shipped_volume" readonly="1"/>
                            <field name="shipped_weight" readonly="1"/>
                            <field name="package_count" readonly="1"/>
                            <field name="package_weight" readonly="1"/>
                            <field name="ship_via" readonly="1"/>
                            <field name="shipping_zone" readonly="1"/>
                            <field name="import_message" readonly="1"/>
                            <field name="note" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_transfer_shipment_line" model="ir.actions.act_window">
        <field name="name">Data Transfer - Inter Warehouse : OUT</field>
        <field name="res_model">acumatica.transfer.shipment.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_transfer_shipment_line_search"/>
    </record>
</odoo>
