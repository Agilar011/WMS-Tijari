<odoo>
    <record id="action_import_selected_transfer_shipment"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_transfer_shipment_line"/>
        <field name="binding_model_id" ref="model_acumatica_transfer_shipment_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_transfer_shipment_line_search" model="ir.ui.view">
        <field name="name">acumatica.transfer.shipment.line.search</field>
        <field name="model">acumatica.transfer.shipment.line</field>
        <field name="arch" type="xml">
            <search string="Cari Data SO Transfer - Inter WH OUT">
                <field name="shipment_nbr"/>
                <field name="document_only"/>
                <!-- <field name="order_number"/> -->
                <!-- <field name="inventory_id"/> -->
                <field name="warehouse_code"/>
                <filter string="Staged" name="staged" domain="[('import_state','=','staged')]"/>
                <filter string="Created" name="created" domain="[('import_state','in',('created','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Shipment" name="group_shipment" context="{'group_by':'shipment_nbr'}"/>
                    <filter string="Warehouse" name="group_wh" context="{'group_by':'warehouse_code'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_transfer_shipment_line_list" model="ir.ui.view">
        <field name="name">acumatica.transfer.shipment.line.list</field>
        <field name="model">acumatica.transfer.shipment.line</field>
        <field name="arch" type="xml">
            <list string="Data SO Transfer - Inter WH OUT" multi_edit="1">
                <field name="selected"/>
                <field name="shipment_nbr"/>
                <field name="shipment_type"/>
                <field name="document_only"/>
                <!-- <field name="partner_code"/> -->
                <field name="warehouse_code"/>
                <field name="actual_qty"/>
                <field name="acumatica_write_date" string="Last Modified"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state == 'created'" decoration-info="import_state == 'updated'" decoration-warning="import_state == 'rejected'"
                       decoration-muted="import_state == 'staged'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Document" type="object" icon="fa-external-link" invisible="not odoo_picking_id and not odoo_internal_transfer_order_id"/>
                <field name="odoo_internal_transfer_order_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_transfer_shipment_line_form" model="ir.ui.view">
        <field name="name">acumatica.transfer.shipment.line.form</field>
        <field name="model">acumatica.transfer.shipment.line</field>
        <field name="arch" type="xml">
            <form string="Data SO Transfer - Inter WH OUT">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'staged'"/>
                    <button name="action_open_picking" type="object" string="Open Document" icon="fa-external-link" invisible="not odoo_picking_id and not odoo_internal_transfer_order_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Staged" class="btn-secondary" invisible="import_state != 'error'"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="staged,created,updated,rejected,error"/>
                </header>
                <sheet>
                    <group string="Data Header" >
                        <group >
                            <!-- <field name="selected"/> -->
                            <field name="shipment_nbr"/>
                            <field name="document_only"/>
                            <field name="picking_type_id"/>
                            <field name="odoo_picking_id" readonly="1"/>
                            <field name="odoo_internal_transfer_order_id" readonly="1"/>
                            <field name="partner_code"/>
                            <field name="shipment_type"/>
                            <field name="warehouse_code"/>
                            <field name="warehouse_dest_code"/>
                            <field name="header_location_code"/>
                            <field name="scheduled_date"/>
                            <field name="acumatica_write_date" string="Last Modified" readonly="1"/>
                            <!-- <field name="order_number"/>
                            <field name="warehouse_code"/>
                            <field name="warehouse_dest_code"/>
                            <field name="location_dest_code"/>
                            <field name="scheduled_date"/> -->
                        </group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="operation"/>
                            <field name="shipment_type"/>
                            <field name="actual_qty"/>
                            <field name="shipped_qty"/>
                            <field name="shipped_volume"/>
                            <field name="shipped_weight"/>
                            <field name="package_count"/>
                            <field name="package_weight"/>
                            <field name="ship_via"/>
                            <field name="shipping_zone"/>
                            <field name="import_message" readonly="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="details" string="Details/Lines">
                            <!-- Field relasi One2many ditaruh di sini secara aman -->
                            <field name="shipment_line_ids">
                                <list>
                                    <field name="inventory_id"/>
                                    <field name="line_description"/>
                                    <field name="line_warehouse_code"/>
                                    <field name="product_uom_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message" readonly="1" widget="text"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_transfer_shipment_line" model="ir.actions.act_window">
        <field name="name">Data SO Transfer - Inter WH OUT</field>
        <field name="res_model">acumatica.transfer.shipment.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_transfer_shipment_line_search"/>
    </record>
</odoo>
