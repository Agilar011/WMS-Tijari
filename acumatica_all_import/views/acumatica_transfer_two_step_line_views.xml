<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_import_selected_transfer_two_step"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_transfer_two_step_line"/>
        <field name="binding_model_id" ref="model_acumatica_transfer_two_step_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_transfer_two_step_line_list" model="ir.ui.view">
        <field name="name">acumatica.transfer.two.step.line.list</field>
        <field name="model">acumatica.transfer.two.step.line</field>
        <field name="arch" type="xml">
            <list string="Data Transfer 1 STEP" create="0" delete="0">
                <field name="selected" widget="boolean_toggle"/>

                <field name="reference_nbr"/>
                <field name="transfer_type"/>
                <field name="trans_type"/>
                <field name="document_only"/>
                <!-- <field name="scheduled_date"/> -->
                <field name="from_warehouse_code"/>
                <field name="from_warehouse_name"/>
                <field name="to_warehouse_code"/>
                <field name="to_warehouse_name"/>
                <field name="total_qty"/>
                <!-- <field name="inventory_id"/> -->
                <!-- <field name="quantity"/> -->
                <!-- <field name="uom_code"/> -->
                <!-- <field name="from_location_code"/> -->
                <!-- <field name="to_location_code"/> -->
                <!-- <field name="status"/> -->
                <!-- <field name="transfer_type"/> -->

                <field name="import_state" widget="badge"
                    decoration-success="import_state == 'created'" decoration-info="import_state == 'updated'" decoration-warning="import_state == 'rejected'"
                    decoration-muted="import_state == 'staged'"
                    decoration-danger="import_state == 'error'"/>

                <button name="action_import_this"
                        string="Import"
                        type="object"
                        icon="fa-upload"
                        invisible="import_state != 'staged'"/>


                <button name="action_open_picking"
                        string="Open Document"
                        type="object"
                        icon="fa-external-link"
                        invisible="not odoo_picking_id and not odoo_internal_transfer_order_id"/>
                <field name="odoo_internal_transfer_order_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_transfer_two_step_line_form" model="ir.ui.view">
        <field name="name">acumatica.transfer.two.step.line.form</field>
        <field name="model">acumatica.transfer.two.step.line</field>
        <field name="arch" type="xml">
            <form string="Data Transfer 1 STEP">
                <header>
                    <button name="action_import_this"
                            string="Import Baris Ini"
                            type="object"
                            class="btn-primary"
                            invisible="import_state != 'staged'"/>

                    <button name="action_open_picking"
                            string="Open Document"
                            type="object"
                            invisible="not odoo_picking_id and not odoo_internal_transfer_order_id"/>

                    <button name="action_reset_pending"
                            string="Reset Error"
                            type="object"
                            class="btn-secondary"
                            invisible="import_state != 'error'"/>

                    <field name="import_state"
                        widget="statusbar"
                        statusbar_visible="staged,created,updated,rejected,error"/>
                </header>

                <sheet>
                    <group>
                        <group string="Header Transfer">
                            <field name="reference_nbr"/>
                            <field name="scheduled_date"/>
                            <field name="description"/>
                            <field name="external_ref"/>
                            <field name="from_warehouse_code"/>
                            <field name="from_warehouse_name"/>
                            <field name="to_warehouse_code"/>
                            <field name="to_warehouse_name"/>
                            <field name="status"/>
                            <field name="return_type"/>
                            <field name="transfer_type"/>
                            <field name="trans_type"/>
                            <field name="total_qty"/>
                            <field name="is_hold"/>
                            <field name="post_period"/>
                            <field name="acumatica_write_date"/>
                            <field name="note_header_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="details" string="Details/Lines">
                            <!-- Field relasi One2many ditaruh di sini secara aman -->
                            <field name="line_ids">
                                <list>
                                    <field name="adt_LineNumber"/>
                                    <field name="adt_InventoryID"/>
                                    <field name="adt_Description"/>
                                    <field name="adt_FromLocationID"/>
                                    <field name="adt_ToLocationID"/>
                                    <field name="adt_Quantity"/>
                                    <field name="adt_UOM"/>
                                    <field name="adt_SOOrderNbr"/>
                                    <field name="adt_SOOrderType"/>
                                    <field name="adt_SOShipmentNbr"/>
                                    <field name="adt_LineNoteID"/>
                                    <field name="adt_note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Import Odoo">
                        <field name="import_message" readonly="1"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="odoo_internal_transfer_order_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_transfer_two_step_line" model="ir.actions.act_window">
        <field name="name">Data Transfer 1 STEP</field>
        <field name="res_model">acumatica.transfer.two.step.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
