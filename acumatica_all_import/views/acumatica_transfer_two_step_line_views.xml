<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_import_selected_transfer_two_step"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_transfer_two_step_line"/>
        <field name="binding_model_id" ref="model_acumatica_transfer_two_step_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_transfer_two_step_line_list" model="ir.ui.view">
        <field name="name">acumatica.transfer.two.step.line.list</field>
        <field name="model">acumatica.transfer.two.step.line</field>
        <field name="arch" type="xml">
            <list string="Data Transfer - Intra Warehouse : OUT" create="0" delete="0">
                <field name="selected" widget="boolean_toggle"/>

                <field name="reference_nbr"/>
                <field name="scheduled_date"/>
                <field name="from_warehouse_code"/>
                <field name="to_warehouse_code"/>
                <field name="inventory_id"/>
                <field name="quantity"/>
                <field name="uom_code"/>
                <field name="from_location_code"/>
                <field name="to_location_code"/>
                <field name="status"/>
                <field name="transfer_type"/>

                <field name="import_state" widget="badge"
                    decoration-success="import_state in ('imported','updated')"
                    decoration-warning="import_state == 'pending'"
                    decoration-danger="import_state == 'error'"/>

                <button name="action_import_this"
                        string="Import"
                        type="object"
                        icon="fa-upload"
                        invisible="import_state != 'pending'"/>

                <button name="action_open_picking"
                        string="Open Transfer"
                        type="object"
                        icon="fa-external-link"
                        invisible="not odoo_picking_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_transfer_two_step_line_form" model="ir.ui.view">
        <field name="name">acumatica.transfer.two.step.line.form</field>
        <field name="model">acumatica.transfer.two.step.line</field>
        <field name="arch" type="xml">
            <form string="Data Transfer - Intra Warehouse : OUT">
                <header>
                    <button name="action_import_this"
                            string="Import Baris Ini"
                            type="object"
                            class="btn-primary"
                            invisible="import_state != 'pending'"/>

                    <button name="action_open_picking"
                            string="Buka Transfer"
                            type="object"
                            invisible="not odoo_picking_id"/>

                    <field name="import_state"
                        widget="statusbar"
                        statusbar_visible="pending,imported,updated,error"/>
                </header>

                <sheet>
                    <group>
                        <group string="Header Transfer">
                            <field name="reference_nbr"/>
                            <field name="scheduled_date"/>
                            <field name="description"/>
                            <field name="from_warehouse_code"/>
                            <field name="to_warehouse_code"/>
                            <field name="status"/>
                            <field name="transfer_type"/>
                            <field name="trans_type"/>
                            <field name="total_qty"/>
                            <field name="is_hold"/>
                            <field name="post_period"/>
                            <field name="acumatica_write_date"/>
                            <field name="note"/>
                        </group>

                        <group string="Detail Line">
                            <field name="line_nbr"/>
                            <field name="inventory_id"/>
                            <field name="line_description"/>
                            <field name="from_location_code"/>
                            <field name="to_location_code"/>
                            <field name="quantity"/>
                            <field name="uom_code"/>
                            <field name="line_note"/>
                        </group>
                    </group>

                    <group string="Import Odoo">
                        <field name="import_message" readonly="1"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_transfer_two_step_line" model="ir.actions.act_window">
        <field name="name">Data Transfer - Intra Warehouse : OUT</field>
        <field name="res_model">acumatica.transfer.two.step.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
