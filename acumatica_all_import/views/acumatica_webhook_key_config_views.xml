<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acumatica_webhook_key_config_form" model="ir.ui.view">
        <field name="name">acumatica.webhook.key.config.form</field>
        <field name="model">acumatica.webhook.key.config</field>
        <field name="arch" type="xml">
            <form string="Webhook API Key">
                <header>
                    <button name="action_generate_api_key" type="object" string="Generate API Key" class="btn-primary"/>
                    <button name="action_view_key_history" type="object" string="View History" class="btn-secondary"/>
                    <button name="action_clear_api_key" type="object" string="Clear API Key" class="btn-secondary" confirm="Clear the configured webhook API key? Existing integrations will stop working."/>
                </header>
                <sheet>
                    <group string="Last Generated Key">
                        <field name="api_key_status"/>
                        <field name="generated_at"/>
                        <field name="latest_api_key"/>
                    </group>
                    <group string="New Key">
                        <field name="generated_api_key" readonly="1"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        Webhook validation uses the newest generated API key. Keys generated before this change may only have a preview because the full value was not stored.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_acumatica_webhook_api_key_list" model="ir.ui.view">
        <field name="name">acumatica.webhook.api.key.list</field>
        <field name="model">acumatica.webhook.api.key</field>
        <field name="arch" type="xml">
            <list string="Webhook API Key">
                <field name="generated_at"/>
                <field name="api_key"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_webhook_api_key_form" model="ir.ui.view">
        <field name="name">acumatica.webhook.api.key.form</field>
        <field name="model">acumatica.webhook.api.key</field>
        <field name="arch" type="xml">
            <form string="Webhook API Key">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="generated_at" readonly="1"/>
                        <field name="api_key" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Leave API Key empty and save to generate a new value automatically.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_webhook_key_config" model="ir.actions.act_window">
        <field name="name">Webhook API Key</field>
        <field name="res_model">acumatica.webhook.key.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="action_acumatica_webhook_api_key_history" model="ir.actions.act_window">
        <field name="name">Webhook API Key</field>
        <field name="res_model">acumatica.webhook.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
