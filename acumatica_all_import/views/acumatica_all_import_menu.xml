    <record id="view_api_data_hub_dashboard_card_kanban" model="ir.ui.view">
        <field name="name">api.data.hub.dashboard.card.kanban</field>
        <field name="model">api.data.hub.dashboard.card</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" class="o_kanban_dashboard o_api_dashboard_vertical">
                <field name="card_type"/>
                <field name="dashboard_scope"/>
                <field name="total"/>
                <field name="staged"/>
                <field name="created"/>
                <field name="updated"/>
                <field name="rejected"/>
                <field name="errors"/>
                <field name="today"/>
                <field name="yesterday"/>
                <field name="last_7_days"/>
                <field name="success"/>
                <field name="failed"/>
                <field name="staged_bar"/>
                <field name="created_bar"/>
                <field name="updated_bar"/>
                <field name="errors_bar"/>
                <field name="today_bar"/>
                <field name="yesterday_bar"/>
                <field name="last_7_days_bar"/>
                <field name="waiting"/>
                <field name="ready"/>
                <field name="in_progress"/>
                <field name="done_count"/>
                <field name="cancelled"/>
                <field name="cancelled_bar"/>
                <field name="overdue"/>
                <field name="scheduled_today"/>
                <field name="upcoming"/>
                <field name="demand_qty"/>
                <field name="processed_qty"/>
                <field name="remaining_qty"/>
                <field name="completion_percent"/>
                <field name="expected_qty"/>
                <field name="sent_qty"/>
                <field name="received_qty"/>
                <field name="counted_qty"/>
                <field name="discrepancy_qty"/>
                <field name="partial_count"/>
                <field name="adjustment_count"/>
                <field name="adjustment_variance"/>
                <field name="scrap_draft"/>
                <field name="scrap_ready"/>
                <field name="scrap_done"/>
                <field name="scrap_qty"/>
                <field name="scrap_reason_count"/>
                <field name="section_title"/>
                <field name="section_start"/>
                <templates>
                    <t t-name="card">
                        <t t-if="record.section_start.raw_value">
                            <div class="o_api_dashboard_section_label"><field name="section_title"/></div>
                        </t>
                        <div class="o_kanban_card p-3" style="border-left: 3px solid #875a9c; min-height: 320px;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h3 class="mb-1" style="color: #087f8c;"><field name="name"/></h3>
                                    <small class="text-muted" t-if="record.card_type.raw_value == 'transactions'">All API transaction staging</small>
                                    <small class="text-muted" t-if="record.card_type.raw_value == 'master'">All API master data staging</small>
                                    <small class="text-muted" t-if="record.card_type.raw_value == 'webhook'">Webhook activity by date</small>
                                    <small class="text-muted" t-if="record.card_type.raw_value == 'scheduler'">Scheduler activity by date</small>
                                </div>
                                <button name="action_refresh" type="object" class="btn btn-primary" title="Refresh">
                                    <span>Refresh</span>
                                </button>
                            </div>
                            <div class="display-4 fw-bold mb-3"><field name="total"/></div>
                            <t t-if="record.dashboard_scope.raw_value == 'inventory'">
                                <small class="text-muted">Monitoring stock operations</small>
                                <t t-if="record.card_type.raw_value == 'operation_status'">
                                    <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mb-2 mt-2" style="height: 145px; gap: 8px;">
                                        <div class="flex-fill text-center"><div class="bg-secondary" t-att-style="'height:' + record.staged_bar.value + 'px;'"/><small>Waiting</small><br/><strong><field name="waiting"/></strong></div>
                                        <div class="flex-fill text-center"><div class="bg-primary" t-att-style="'height:' + record.created_bar.value + 'px;'"/><small>Ready</small><br/><strong><field name="ready"/></strong></div>
                                        <div class="flex-fill text-center"><div class="bg-warning" t-att-style="'height:' + record.updated_bar.value + 'px;'"/><small>In Progress</small><br/><strong><field name="in_progress"/></strong></div>
                                        <div class="flex-fill text-center"><div class="bg-success" t-att-style="'height:' + record.errors_bar.value + 'px;'"/><small>Done</small><br/><strong><field name="done_count"/></strong></div>
                                        <div class="flex-fill text-center"><div class="bg-danger" t-att-style="'height:' + record.cancelled_bar.value + 'px;'"/><small>Cancelled</small><br/><strong><field name="cancelled"/></strong></div>
                                    </div>
                                </t>
                                <t t-if="record.card_type.raw_value == 'delayed_operation'">
                                    <div class="alert alert-warning mt-3 mb-0" role="status">Overdue and unfinished: <strong><field name="overdue"/></strong></div>
                                    <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mt-3" style="height: 145px;"><div class="flex-fill text-center"><div class="bg-danger" t-att-style="'height:' + record.errors_bar.value + 'px;'"/><small>Overdue</small><br/><strong><field name="overdue"/></strong></div></div>
                                </t>
                                <t t-if="record.card_type.raw_value == 'operation_schedule'">
                                    <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mb-2 mt-2" style="height: 145px; gap: 12px;">
                                        <div class="flex-fill text-center"><div class="bg-danger" t-att-style="'height:' + record.yesterday_bar.value + 'px;'"/><small>Overdue</small><br/><strong><field name="overdue"/></strong></div>
                                        <div class="flex-fill text-center"><div class="bg-primary" t-att-style="'height:' + record.today_bar.value + 'px;'"/><small>Today</small><br/><strong><field name="scheduled_today"/></strong></div>
                                        <div class="flex-fill text-center"><div class="bg-success" t-att-style="'height:' + record.last_7_days_bar.value + 'px;'"/><small>Upcoming</small><br/><strong><field name="upcoming"/></strong></div>
                                    </div>
                                </t>
                                <t t-if="record.card_type.raw_value == 'operation_progress'">
                                    <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mb-2 mt-3" style="height: 145px; gap: 8px;"><div class="flex-fill text-center"><div class="bg-secondary" t-att-style="'height:' + record.staged_bar.value + 'px;'"/><small>Demand</small><br/><strong><field name="demand_qty"/></strong></div><div class="flex-fill text-center"><div class="bg-success" t-att-style="'height:' + record.created_bar.value + 'px;'"/><small>Processed</small><br/><strong><field name="processed_qty"/></strong></div><div class="flex-fill text-center"><div class="bg-warning" t-att-style="'height:' + record.updated_bar.value + 'px;'"/><small>Remaining</small><br/><strong><field name="remaining_qty"/></strong></div><div class="flex-fill text-center"><div class="bg-info" t-att-style="'height:' + record.errors_bar.value + 'px;'"/><small>Completion %</small><br/><strong><field name="completion_percent"/>%</strong></div></div>
                                    <div class="row mt-3"><div class="col"><small>Demand Qty</small><br/><strong><field name="demand_qty"/></strong></div><div class="col"><small>Processed Qty</small><br/><strong><field name="processed_qty"/></strong></div><div class="col"><small>Remaining Qty</small><br/><strong><field name="remaining_qty"/></strong></div><div class="col"><small>Completion</small><br/><strong><field name="completion_percent"/>%</strong></div></div>
                                </t>
                                <t t-if="record.card_type.raw_value == 'partial_discrepancy'">
                                    <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mb-2 mt-3" style="height: 145px; gap: 8px;"><div class="flex-fill text-center"><div class="bg-secondary" t-att-style="'height:' + record.staged_bar.value + 'px;'"/><small>Expected</small><br/><strong><field name="expected_qty"/></strong></div><div class="flex-fill text-center"><div class="bg-primary" t-att-style="'height:' + record.created_bar.value + 'px;'"/><small>Sent</small><br/><strong><field name="sent_qty"/></strong></div><div class="flex-fill text-center"><div class="bg-success" t-att-style="'height:' + record.updated_bar.value + 'px;'"/><small>Received</small><br/><strong><field name="received_qty"/></strong></div><div class="flex-fill text-center"><div class="bg-danger" t-att-style="'height:' + record.errors_bar.value + 'px;'"/><small>Discrepancy</small><br/><strong><field name="discrepancy_qty"/></strong></div></div>
                                    <div class="row mt-3"><div class="col"><small>Expected</small><br/><strong><field name="expected_qty"/></strong></div><div class="col"><small>Sent</small><br/><strong><field name="sent_qty"/></strong></div><div class="col"><small>Received</small><br/><strong><field name="received_qty"/></strong></div><div class="col"><small>Counted</small><br/><strong><field name="counted_qty"/></strong></div></div><div class="border-top pt-2 mt-2 text-muted">Partial <field name="partial_count"/> · Discrepancy <field name="discrepancy_qty"/></div>
                                </t>
                                <t t-if="record.card_type.raw_value == 'inventory_adjustment'">
                                    <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mb-2 mt-3" style="height: 145px; gap: 12px;"><div class="flex-fill text-center"><div class="bg-primary" t-att-style="'height:' + record.staged_bar.value + 'px;'"/><small>Adjustments</small><br/><strong><field name="adjustment_count"/></strong></div><div class="flex-fill text-center"><div class="bg-danger" t-att-style="'height:' + record.errors_bar.value + 'px;'"/><small>Variance</small><br/><strong><field name="adjustment_variance"/></strong></div></div>
                                    <div class="row mt-3"><div class="col"><small>Adjustments</small><br/><strong><field name="adjustment_count"/></strong></div><div class="col"><small>Total Variance</small><br/><strong><field name="adjustment_variance"/></strong></div></div>
                                </t>
                                <t t-if="record.card_type.raw_value == 'scrap_monitoring'">
                                    <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mb-2 mt-3" style="height: 145px; gap: 8px;"><div class="flex-fill text-center"><div class="bg-secondary" t-att-style="'height:' + record.staged_bar.value + 'px;'"/><small>Draft</small><br/><strong><field name="scrap_draft"/></strong></div><div class="flex-fill text-center"><div class="bg-warning" t-att-style="'height:' + record.created_bar.value + 'px;'"/><small>Ready</small><br/><strong><field name="scrap_ready"/></strong></div><div class="flex-fill text-center"><div class="bg-success" t-att-style="'height:' + record.errors_bar.value + 'px;'"/><small>Done</small><br/><strong><field name="scrap_done"/></strong></div><div class="flex-fill text-center"><div class="bg-danger" t-att-style="'height:' + record.updated_bar.value + 'px;'"/><small>Qty</small><br/><strong><field name="scrap_qty"/></strong></div></div>
                                    <div class="row mt-3"><div class="col"><small>Draft</small><br/><strong><field name="scrap_draft"/></strong></div><div class="col"><small>Ready</small><br/><strong><field name="scrap_ready"/></strong></div><div class="col"><small>Done</small><br/><strong><field name="scrap_done"/></strong></div></div><div class="border-top pt-2 mt-2 text-muted">Qty <field name="scrap_qty"/> · Alasan tercatat <field name="scrap_reason_count"/></div>
                                </t>
                            </t>
                            <t t-if="record.card_type.raw_value == 'transactions' or record.card_type.raw_value == 'master'">
                                <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mb-2" style="height: 145px; gap: 8px;">
                                    <div class="flex-fill text-center"><div class="bg-secondary" t-att-style="'height:' + record.staged_bar.value + 'px;'"></div><small>Staged</small><br/><strong><field name="staged"/></strong></div>
                                    <div class="flex-fill text-center"><div class="bg-success" t-att-style="'height:' + record.created_bar.value + 'px;'"></div><small>Created</small><br/><strong><field name="created"/></strong></div>
                                    <div class="flex-fill text-center"><div class="bg-info" t-att-style="'height:' + record.updated_bar.value + 'px;'"></div><small>Updated</small><br/><strong><field name="updated"/></strong></div>
                                    <div class="flex-fill text-center"><div class="bg-danger" t-att-style="'height:' + record.errors_bar.value + 'px;'"></div><small>Error</small><br/><strong><field name="errors"/></strong></div>
                                </div>
                            </t>
                            <t t-if="record.card_type.raw_value == 'webhook' or record.card_type.raw_value == 'scheduler'">
                                <div class="o_api_dashboard_chart d-flex align-items-end border-bottom mb-2" style="height: 145px; gap: 12px;">
                                    <div class="flex-fill text-center"><div class="bg-primary" t-att-style="'height:' + record.today_bar.value + 'px;'"></div><small>Today</small><br/><strong><field name="today"/></strong></div>
                                    <div class="flex-fill text-center"><div class="bg-primary opacity-75" t-att-style="'height:' + record.yesterday_bar.value + 'px;'"></div><small>Yesterday</small><br/><strong><field name="yesterday"/></strong></div>
                                    <div class="flex-fill text-center"><div class="bg-primary opacity-50" t-att-style="'height:' + record.last_7_days_bar.value + 'px;'"></div><small>Last 7 days</small><br/><strong><field name="last_7_days"/></strong></div>
                                </div>
                                <div class="border-top pt-2 text-muted">Success <field name="success"/> · Failed <field name="failed"/></div>
                            </t>
                            <!-- The large lower area intentionally mirrors the native Accounting kanban dashboard. -->
                            <div class="mt-2">
                                <button name="action_refresh" type="object" class="btn btn-link p-0" title="Refresh">
                                    <i class="fa fa-refresh"/>
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <menuitem id="menu_acumatica_all_import_staging_root" name="Data Transaksi" parent="menu_acumatica_all_import_root" sequence="30"/>

