<odoo>

    <!-- LIST VIEW -->
    <record id="view_acumatica_shipment_gi_staging_list" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.list</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <list>
                <field name="shipment_nbr"/>
                <field name="ship_date"/>
                <field name="customer"/>
                <field name="customer_name"/>
                <field name="warehouse_id"/>
                <field name="status"/>
                <field name="import_state"/>
                <field name="odoo_picking_id"/>
                <button name="action_import_this"
                        string="Import ke Odoo"
                        type="object"
                        class="btn-primary"
                        invisible="import_state != 'pending'"/>              
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_acumatica_shipment_gi_staging_form" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.form</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <form string="Acumatica Shipment">

                <sheet>

                    <group>
                        <group>
                            <field name="shipment_nbr"/>
                            <field name="ship_date"/>
                            <field name="customer"/>
                            <field name="customer_name"/>
                            <field name="warehouse_id"/>
                            <field name="location"/>
                            <field name="status"/>
                            <field name="shipment_type"/>
                        </group>

                        <group>
                            <field name="ship_via"/>
                            <field name="fob_point"/>
                            <field name="shipped_quantity"/>
                            <field name="shipped_weight"/>
                            <field name="shipped_volume"/>
                            <field name="odoo_picking_id"/>
                            <field name="import_state"/>
                            <field name="import_message"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Address">

                            <group>
                                <field name="address_line1"/>
                                <field name="address_line2"/>
                                <field name="address_line3"/>
                                <field name="city"/>
                                <field name="state"/>
                                <field name="country"/>
                                <field name="postal_code"/>
                            </group>

                        </page>

                        <page string="Shipment Detail">

                            <field name="shipment_ids">

                                <list>
                                    <field name="shipmentnbr"/>
                                    <field name="customerid"/>
                                    <field name="warehouseid"/>
                                    <field name="locationid"/>
                                    <field name="shipmentdate"/>
                                    <field name="status"/>
                                    <field name="shippedqty"/>
                                    <field name="odoo_picking_id"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_acumatica_shipment_gi_staging_search" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.search</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <search>

                <field name="shipment_nbr"/>
                <field name="customer"/>
                <field name="warehouse_id"/>
                <field name="status"/>
                <field name="import_state"/>

                <filter
                    name="pending"
                    string="Pending"
                    domain="[('import_state','=','pending')]"/>

                <filter
                    name="imported"
                    string="Imported"
                    domain="[('import_state','=','imported')]"/>

                <group expand="0" string="Group By">

                    <filter
                        string="Warehouse"
                        name="group_warehouse"
                        context="{'group_by':'warehouse_id'}"/>

                    <filter
                        string="Status"
                        name="group_status"
                        context="{'group_by':'status'}"/>

                    <filter
                        string="Import State"
                        name="group_import_state"
                        context="{'group_by':'import_state'}"/>

                </group>

            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_acumatica_shipment_gi_staging" model="ir.actions.act_window">
        <field name="name">Shipment Receipt Staging</field>
        <field name="res_model">acumatica.shipment.gi.staging</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="action_import_selected_shipment"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_shipment_line"/>
        <field name="binding_model_id" ref="model_acumatica_shipment_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_shipment_line_search" model="ir.ui.view">
        <field name="name">acumatica.shipment.line.search</field>
        <field name="model">acumatica.shipment.line</field>
        <field name="arch" type="xml">
            <search string="Cari Data SO Return">
                <!-- <field name="inventory_id"/> -->
                <field name="import_state"/>

                <filter string="Pending" name="pending" domain="[('import_state','=','pending')]"/>
                <filter string="Done" name="done" domain="[('import_state','in',('imported','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>

                <group expand="0" string="Group By">
                    <!-- <filter string="Shipment" name="group_receipt" context="{'group_by': 'receipt_nbr'}"/> -->
                    <!-- <filter string="Customer" name="group_partner" context="{'group_by': 'partner_code'}"/> -->
                    <filter string="Status" name="group_state" context="{'group_by': 'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_shipment_line_list" model="ir.ui.view">
        <field name="name">acumatica.shipment.line.list</field>
        <field name="model">acumatica.shipment.line</field>
        <field name="arch" type="xml">
            <list string="Data SO Return" multi_edit="1">
                <field name="shipment_nbr"/>
                <field name="warehouse_code" string="Warehouse"/>
                <field name="partner_code"/>
                <field name="actual_qty" string="Qty"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state in ('imported','updated')"
                       decoration-warning="import_state == 'pending'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Shipment" type="object" icon="fa-external-link" invisible="not odoo_picking_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_shipment_line_form" model="ir.ui.view">
        <field name="name">acumatica.shipment.line.form</field>
        <field name="model">acumatica.shipment.line</field>
        <field name="arch" type="xml">
            <form string="Data SO Return">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'pending'"/>
                    <button name="action_open_picking" type="object" string="Open Receipt" class="btn-secondary" invisible="not odoo_picking_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Pending" class="btn-secondary" invisible="import_state != 'error'"/>
                </header>
                <sheet>
                    <group string="Header">
                        <group>
                            <field name="shipment_nbr" readonly="1"/>
                            <field name="shipment_type" readonly="1"/>
                            <field name="operation" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="partner_code" readonly="1"/>
                            <field name="warehouse_code" readonly="1"/>
                            <!-- <field name="warehouse_dest_code" readonly="1"/> -->
                            <!-- <field name="header_location_code" readonly="1"/> -->
                        </group>
                        <group>
                            <field name="scheduled_date" readonly="1"/>
                            <field name="actual_qty" readonly="1"/>
                            <!-- <field name="shipped_qty" readonly="1"/> -->
                            <field name="acumatica_write_date" readonly="1"/>
                            <field name="description" readonly="1"/>
                            <field name="shipping_zone" readonly="1"/>
                            <field name="ship_via" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Details" string="Details">
                            <field name="product_line_ids">
                                <list>
                                    <field name="inventory_id"/>
                                    <field name="description"/>
                                    <field name="warehouse_dest_code"/>
                                    <field name="shipped_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message" readonly="1" widget="text"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_shipment_line" model="ir.actions.act_window">
        <field name="name">Data SO Return</field>
        <field name="res_model">acumatica.shipment.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_shipment_line_search"/>
    </record>

</odoo>
