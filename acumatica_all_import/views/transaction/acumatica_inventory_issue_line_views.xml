
<odoo>
    <record id="action_import_selected_inventory_issue"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_inventory_issue_line"/>
        <field name="binding_model_id" ref="model_acumatica_inventory_issue_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_inventory_issue_line_search" model="ir.ui.view">
        <field name="name">acumatica.inventory.issue.line.search</field>
        <field name="model">acumatica.inventory.issue.line</field>
        <field name="arch" type="xml">
            <search string="Cari Data Issue : Inventory Issue">
                <field name="reference_nbr"/>
                <field name="shipment_nbr" optional="show"/>
                <field name="transfer_nbr" optional="show"/>
                <field name="trans_type"/>
                <field name="document_only"/>
                <field name="warehouse_code"/>
                <field name="total_qty"/>
                <field name="import_state"/>
                <filter string="Staged" name="staged" domain="[('import_state','=','staged')]"/>
                <filter string="Done" name="done" domain="[('import_state','in',('created','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>
            </search>
        </field>
    </record>

    <record id="view_acumatica_inventory_issue_line_list" model="ir.ui.view">
        <field name="name">acumatica.inventory.issue.line.list</field>
        <field name="model">acumatica.inventory.issue.line</field>
        <field name="arch" type="xml">
            <list string="Data Issue : Inventory Issue" multi_edit="1">
                <field name="selected" widget="boolean_toggle"/>
                <field name="reference_nbr"/>
                <field name="trans_type"/>
                <field name="doc_type"/>
                <field name="document_only"/>
                <field name="building_code"/>
                <field name="warehouse_code"/>
                <field name="total_qty"/>
                <field name="line_nbr"/>
                <field name="inventory_id"/>
                <field name="acumatica_write_date" string="Last Modified"/>
                <!-- <field name="inventory_id"/> -->
                <!-- <field name="transaction_description"/> -->
                <!-- <field name="product_uom_qty"/> -->
                <!-- <field name="uom_code"/> -->
                <!-- <field name="location_dest_code"/> -->
                <field name="import_state" widget="badge"
                       decoration-success="import_state == 'created'" decoration-info="import_state == 'updated'" decoration-warning="import_state == 'rejected'"
                       decoration-muted="import_state == 'staged'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <field name="odoo_internal_transfer_order_id" column_invisible="1"/>
                <field name="odoo_scrap_id" column_invisible="1"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Document" type="object" icon="fa-external-link" invisible="not odoo_picking_id and not odoo_internal_transfer_order_id and not odoo_scrap_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_inventory_issue_line_form" model="ir.ui.view">
        <field name="name">acumatica.inventory.issue.line.form</field>
        <field name="model">acumatica.inventory.issue.line</field>
        <field name="arch" type="xml">
            <form string="Data Issue : Inventory Issue">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'staged'"/>
                    <button name="action_open_picking" type="object" string="Open Document" class="btn-secondary" invisible="not odoo_picking_id and not odoo_internal_transfer_order_id and not odoo_scrap_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Staged" class="btn-secondary" invisible="import_state != 'error'"/>
                    <field name="import_state" readonly="1" widget="statusbar" statusbar_visible="staged,created,updated,rejected,error"/>
                </header>
                <sheet>
                    <group string="Header">
                        <group>
                            <field name="external_id"/>
                            <field name="row_number"/>
                            <field name="reference_nbr"/>
                            <field name="picking_type_id"/>
                            <field name="scheduled_date"/>
                            <field name="status"/>
                            <field name="customer_id"/>
                            <field name="customer_name"/>
                            <field name="customer_location_id"/>
                            <field name="customer_location_name"/>
                            <field name="shipment_nbr"/>
                            <field name="transfer_nbr"/>
                            <field name="trans_type"/>
                            <field name="document_only"/>
                            <field name="doc_type"/>
                            <field name="actual_qty"/>
                            <field name="total_qty"/>
                            <field name="warehouse_code"/>
                            <field name="building_code"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="external_ref"/>
                            <field name="change_item_ref_nbr"/>
                            <field name="header_location_code"/>
                            <field name="post_period"/>
                            <field name="acumatica_write_date"/>
                            <field name="branch_warehouse"/>
                            <field name="note_header_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Details" string="Details">
                            <field name="product_line_ids">
                                <list>
                                    <field name="line_nbr"/>
                                    <field name="inventory_id"/>
                                    <field name="line_description"/>
                                    <field name="location_code"/>
                                    <field name="line_location_name"/>
                                    <field name="warehouse_code"/>
                                    <field name="line_warehouse_name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="uom_code"/>
                                    <field name="line_note_id"/>
                                    <field name="line_note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message" widget="text"/>
                        <field name="odoo_picking_id" string="Document Reference" invisible="not odoo_picking_id"/>
                        <field name="odoo_scrap_id" string="Document Reference" invisible="not odoo_scrap_id"/>
                        <field name="odoo_internal_transfer_order_id"/>
                        <field name="exists_in_odoo"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_inventory_issue_line" model="ir.actions.act_window">
        <field name="name">Data Issue : Inventory Issue</field>
        <field name="res_model">acumatica.inventory.issue.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_inventory_issue_line_search"/>
    </record>
</odoo>
