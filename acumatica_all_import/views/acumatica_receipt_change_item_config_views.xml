<odoo>
    <record id="view_acumatica_receipt_change_item_config_tree" model="ir.ui.view">
        <field name="name">acumatica.receipt.change.item.config.tree</field>
        <field name="model">acumatica.receipt.change.item.config</field>
        <field name="arch" type="xml">
            <list string="Konfigurasi Receipt Type Change Item">
                <field name="name"/>
                <field name="base_url"/>
                <field name="api_version"/>
                <field name="endpoint_name"/>
                <field name="state"/>
                <field name="last_sync"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_receipt_change_item_config_form" model="ir.ui.view">
        <field name="name">acumatica.receipt.change.item.config.form</field>
        <field name="model">acumatica.receipt.change.item.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Receipt Type Change Item">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Koneksi">
                            <field name="name"/>
                            <field name="base_url"/>
                            <field name="api_version"/>
                            <field name="company_code"/>
                        </group>
                        <group string="Autentikasi">
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="active"/>
                            <field name="last_sync" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Default Request">
                            <field name="endpoint_name"/>
                            <field name="odata_expand"/>
                            <field name="odata_select"/>
                            <field name="odata_filter"/>
                        </group>
                        <group string="Preview">
                            <div class="o_form_label">Default request</div>
                            <div>
                                <span class="text-muted">PurchaseReceipt?$filter=Type eq 'Change Item'&amp;$expand=Details</span>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_receipt_change_item_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi Receipt Type Change Item</field>
        <field name="res_model">acumatica.receipt.change.item.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
