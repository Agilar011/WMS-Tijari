<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_import_selected_uom"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_uom_line"/>
        <field name="binding_model_id" ref="model_acumatica_uom_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <!-- ─── Search View ─── -->
    <record id="view_acumatica_uom_line_search" model="ir.ui.view">
        <field name="name">acumatica.uom.line.search</field>
        <field name="model">acumatica.uom.line</field>
        <field name="arch" type="xml">
            <search string="Cari UoM">
                <field name="unit_id" string="UnitID (Code)"/>
                <field name="description" string="Description (Nama UoM)"/>
                <filter string="Staged" name="staged"
                        domain="[('import_state','=','staged')]"/>
                <filter string="Created" name="created"
                        domain="[('import_state','=','created')]"/>
                <filter string="Updated" name="updated"
                        domain="[('import_state','=','updated')]"/>
                <filter string="Rejected" name="skipped"
                        domain="[('import_state','=','skipped')]"/>
                <filter string="Error" name="error"
                        domain="[('import_state','=','error')]"/>
                <separator/>
                <filter string="Dipilih" name="selected"
                        domain="[('selected','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status Import" name="group_state"
                            context="{'group_by': 'import_state'}"/>
                    <filter string="Code (UnitID)" name="group_unit"
                            context="{'group_by': 'unit_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── List View: Data Staging ─── -->
    <record id="view_acumatica_uom_line_list" model="ir.ui.view">
        <field name="name">acumatica.uom.line.list</field>
        <field name="model">acumatica.uom.line</field>
        <field name="arch" type="xml">
            <list string="Data UoM dari Acumatica" multi_edit="1">
                <field name="selected" optional="show"/>
                <field name="row_number" string="No" optional="show"/>
                <field name="unit_id" string="UnitID (Code)"/>
                <field name="description" string="Description"/>
                <field name="external_id" string="UUID Acumatica" optional="hide"/>
                <field name="import_state" string="Status" widget="badge"
                       decoration-success="import_state == 'created'"
                       decoration-info="import_state in ['updated', 'staged']"
                       decoration-warning="import_state == 'skipped'"
                       decoration-danger="import_state == 'error'"
                       />
                <field name="odoo_categ_id" string="Document Reference" optional="show"/>
                <field name="odoo_uom_id" string="Document Reference" optional="show"/>
                <field name="import_message" string="Generation Message" optional="show"/>
                <field name="last_modified_datetime" string="Last Modified" optional="show"/>
                <field name="sync_date" string="Tgl Sync" optional="show"/>
                <button name="action_import_this"
                        string="Import"
                        type="object"
                        icon="fa-download"
                        invisible="import_state != 'staged'"/>
            </list>
        </field>
    </record>

    <!-- ─── Form View: Detail Baris ─── -->
    <record id="view_acumatica_uom_line_form" model="ir.ui.view">
        <field name="name">acumatica.uom.line.form</field>
        <field name="model">acumatica.uom.line</field>
        <field name="arch" type="xml">
            <form string="Detail Data UoM">
                <header>
                    <button name="action_import_this"
                            string="Import ke Odoo"
                            type="object"
                            class="btn-primary"
                            invisible="import_state != 'staged'"/>
                    <button name="action_reset_pending"
                            string="Reset ke Pending"
                            type="object"
                            invisible="import_state != 'error'"/>
                    <field name="import_state" widget="statusbar"
                           statusbar_visible="staged,created,updated,rejected,error"/>
                </header>
                <style>
                    div.o-mail-ChatterContainer.o-mail-Form-chatter div.o-mail-Message-richBody.overflow-x-auto {
                        overflow: visible !important;
                    }
                </style>
                <sheet>
                    <group string="Data dari Acumatica">
                        <field name="unit_id" string="UnitID (Code)"/>
                        <field name="description" string="UoM Name"/>
                        <field name="external_id"/>
                        <field name="row_number"/>
                        <field name="last_modified_datetime" string="Last Modified"/>
                    </group>
                    <group string="Hasil di Odoo">
                        <field name="odoo_categ_id" string="Kategori UoM"/>
                        <field name="odoo_uom_id" string="Nama UoM"/>
                        <field name="import_message"/>
                        <field name="sync_date"/>
                        <field name="config_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <chatter/>
                </div>
            </form>
        </field>
    </record>

    <!-- ─── Action: List Staging ─── -->
    <record id="action_acumatica_uom_line" model="ir.actions.act_window">
        <field name="name">Data UoM Acumatica</field>
        <field name="res_model">acumatica.uom.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_uom_line_search"/>
        <field name="context">{'search_default_staged': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data. Gunakan menu "Import UoM" untuk menarik data dari Acumatica.
            </p>
        </field>
    </record>

</odoo>
