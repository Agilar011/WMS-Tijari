<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Search View ─── -->
    <record id="view_acumatica_uom_line_search" model="ir.ui.view">
        <field name="name">acumatica.uom.line.search</field>
        <field name="model">acumatica.uom.line</field>
        <field name="arch" type="xml">
            <search string="Cari UoM">
                <field name="unit_id" string="UnitID (Kategori)"/>
                <field name="description" string="Description (Nama UoM)"/>
                <filter string="Belum Diimport" name="pending"
                        domain="[('import_state','=','pending')]"/>
                <filter string="Sudah Diimport" name="imported"
                        domain="[('import_state','=','imported')]"/>
                <filter string="Dilewati" name="skipped"
                        domain="[('import_state','=','skipped')]"/>
                <filter string="Error" name="error"
                        domain="[('import_state','=','error')]"/>
                <separator/>
                <filter string="Dipilih" name="selected"
                        domain="[('selected','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status Import" name="group_state"
                            context="{'group_by': 'import_state'}"/>
                    <filter string="Kategori (UnitID)" name="group_unit"
                            context="{'group_by': 'unit_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── List View: Data Staging ─── -->
    <record id="view_acumatica_uom_line_list" model="ir.ui.view">
        <field name="name">acumatica.uom.line.list</field>
        <field name="model">acumatica.uom.line</field>
        <field name="arch" type="xml">
            <list string="Data UoM dari Acumatica" multi_edit="1">
                <field name="selected" optional="show"/>
                <field name="row_number" string="No" optional="show"/>
                <field name="unit_id" string="UnitID → Kategori UoM"/>
                <field name="description" string="Description → Nama UoM"/>
                <field name="external_id" string="UUID Acumatica" optional="hide"/>
                <field name="import_state" string="Status" widget="badge"
                       decoration-success="import_state == 'imported'"
                       decoration-warning="import_state == 'skipped'"
                       decoration-danger="import_state == 'error'"
                       decoration-info="import_state == 'pending'"/>
                <field name="odoo_categ_id" string="Kategori di Odoo" optional="show"/>
                <field name="odoo_uom_id" string="UoM di Odoo" optional="show"/>
                <field name="import_message" string="Keterangan" optional="show"/>
                <field name="sync_date" string="Tgl Sync" optional="show"/>
                <button name="action_import_this"
                        string="Import"
                        type="object"
                        icon="fa-download"
                        invisible="import_state != 'pending'"/>
            </list>
        </field>
    </record>

    <!-- ─── Form View: Detail Baris ─── -->
    <record id="view_acumatica_uom_line_form" model="ir.ui.view">
        <field name="name">acumatica.uom.line.form</field>
        <field name="model">acumatica.uom.line</field>
        <field name="arch" type="xml">
            <form string="Detail Data UoM">
                <header>
                    <button name="action_import_this"
                            string="Import ke Odoo"
                            type="object"
                            class="btn-primary"
                            invisible="import_state != 'pending'"/>
                    <button name="action_reset_pending"
                            string="Reset ke Pending"
                            type="object"
                            invisible="import_state == 'pending'"/>
                    <field name="import_state" widget="statusbar"
                           statusbar_visible="pending,imported,skipped,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="📦 Data dari Acumatica">
                            <field name="unit_id" string="UnitID → Kategori UoM"/>
                            <field name="description" string="Description → Nama UoM"/>
                            <field name="external_id"/>
                            <field name="row_number"/>
                        </group>
                        <group string="🔗 Hasil di Odoo">
                            <field name="odoo_categ_id" string="Kategori UoM"/>
                            <field name="odoo_uom_id" string="Nama UoM"/>
                            <field name="import_message"/>
                            <field name="sync_date"/>
                            <field name="config_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── Action: List Staging ─── -->
    <record id="action_acumatica_uom_line" model="ir.actions.act_window">
        <field name="name">Data UoM Acumatica</field>
        <field name="res_model">acumatica.uom.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_uom_line_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data. Gunakan menu "Import UoM" untuk menarik data dari Acumatica.
            </p>
        </field>
    </record>

</odoo>
