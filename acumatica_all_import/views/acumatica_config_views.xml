<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Form View: Konfigurasi API ─── -->
    <record id="view_acumatica_config_form" model="ir.ui.view">
        <field name="name">acumatica.config.form</field>
        <field name="model">acumatica.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Acumatica API">
                <header>
                    <button name="action_test_connection" string="🔌 Test Connection" type="object" class="btn-primary"/>
                    <button name="action_sync_transaction_types" string="Sync Transaction Types" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nama Konfigurasi..."/></h1>
                    </div>
                    <group>
                        <group string="🌐 Koneksi API">
                            <field name="base_url" placeholder="http://your-server/acumportal/entity"/>
                            <field name="api_version"/>
                            <field name="endpoint_name"/>
                            <field name="config_type" />
                            <field name="is_default"/>
                            <field name="generate_virtual_location"
                                   invisible="config_type != 'warehouse'"/>
                        </group>
                        <group string="🔑 Kredensial">
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="company_code"/>
                        </group>
                    </group>
                    <group>
                        <group string="📊 Info Sync">
                            <field name="last_sync" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="⚙️ OData Settings">
                            <field name="odata_filter"/>
                            <field name="odata_expand"/>
                            <field name="odata_select"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── List View: Konfigurasi API ─── -->
    <record id="view_acumatica_config_list" model="ir.ui.view">
        <field name="name">acumatica.config.list</field>
        <field name="model">acumatica.config</field>
        <field name="arch" type="xml">
            <list string="Konfigurasi Acumatica">
                <field name="name"/>
                <field name="config_type" />
                <field name="is_default"/>
                <field name="base_url"/>
                <field name="username"/>
                <field name="company_code"/>
                <field name="last_sync"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'draft'"/>
                <button name="action_test_connection" string="Test" type="object" icon="fa-plug"/>
                <button name="action_sync_transaction_types" string="Sync Types" type="object" icon="fa-refresh"/>
            </list>
        </field>
    </record>

    <!-- ─── Action: Konfigurasi ─── -->
    <record id="action_acumatica_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi Acumatica</field>
        <field name="res_model">acumatica.config</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tambahkan konfigurasi koneksi Acumatica pertama Anda!
            </p>
        </field>
    </record>

</odoo>
