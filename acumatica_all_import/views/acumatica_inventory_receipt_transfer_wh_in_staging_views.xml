<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_acumatica_inventory_receipt_transfer_wh_in_staging_search" model="ir.ui.view">
        <field name="name">acumatica.inventory.receipt.transfer.wh.in.staging.search</field>
        <field name="model">acumatica.inventory.receipt.transfer.wh.in.staging</field>
        <field name="arch" type="xml">
            <search string="Cari Data Inventory Receipt : WH In">
                <field name="adt_ReferenceNbr" string="Reference Number"/>
                <field name="import_state"/>
                <filter string="Pending" name="pending" domain="[('import_state','=','pending')]"/>
                <filter string="Done" name="done" domain="[('import_state','in',('imported','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>
            </search>
        </field>
    </record>


    <!-- 1. SERVER ACTION: Untuk aksi massal di list view (Generate Data) -->
    <record id="action_import_selected_inventory_receipt_transfer_wh_in_staging"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_inventory_receipt_transfer_wh_in_staging"/>
        <field name="binding_model_id" ref="model_acumatica_inventory_receipt_transfer_wh_in_staging"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <!-- 2. LIST (TREE) VIEW: Menampilkan data header dalam bentuk tabel list -->
    <record id="view_acumatica_inventory_receipt_transfer_wh_in_staging_list" model="ir.ui.view">
        <field name="name">acumatica.inventory.receipt.transfer.wh.in.staging.list</field>
        <field name="model">acumatica.inventory.receipt.transfer.wh.in.staging</field>
        <field name="arch" type="xml">
            <list string="Data Inventory Receipt : Transfer WH IN" create="0" delete="0">
                <field name="selected" widget="boolean_toggle"/>

                <!-- Field Header dari Acumatica (Ganti adt_ReferenceNbr jika ada nama field lain) -->
                <field name="adt_ReferenceNbr"/>
                <field name="adt_TransType"/>
                <field name="adt_DocumentOnly"/>
                <!-- <field name="adt_Customer"/> -->
                <field name="adt_Branch"/> 
                <field name="adt_TotalQty"/> 

                <!-- Status Import Data ke Odoo -->
                <field name="import_state" widget="badge"
                    decoration-success="import_state in ('imported','updated')"
                    decoration-warning="import_state == 'pending'"
                    decoration-danger="import_state == 'error'"/>

                <!-- Tombol aksi cepat per baris header -->
                <button name="action_import_this"
                        string="Import"
                        type="object"
                        icon="fa-upload"
                        invisible="import_state != 'pending'"/>

                <button name="action_open_picking"
                        string="Open Transfer"
                        type="object"
                        icon="fa-external-link"
                        invisible="not odoo_picking_id"/>
            </list>
        </field>
    </record>

    <!-- 3. FORM VIEW: Menampilkan detail dokumen beserta tabel baris anaknya (line_ids) -->
    <record id="view_acumatica_inventory_receipt_transfer_wh_in_staging_form" model="ir.ui.view">
        <field name="name">acumatica.inventory.receipt.transfer.wh.in.staging.form</field>
        <field name="model">acumatica.inventory.receipt.transfer.wh.in.staging</field>
        <field name="arch" type="xml">
            <form string="Data Inventory Receipt : Transfer WH IN">
                <header>
                    <button name="action_import_this"
                            string="Import Dokumen Ini"
                            type="object"
                            class="btn-primary"
                            invisible="import_state != 'pending'"/>

                    <button name="action_open_picking"
                            string="Buka Transfer"
                            type="object"
                            invisible="not odoo_picking_id"/>

                    <field name="import_state"
                        widget="statusbar"
                        statusbar_visible="pending,imported,updated,error"/>
                </header>

                <sheet>
                    <group>
                        <!-- Group Kiri: Informasi Dokumen Utama -->
                        <group string="Header Dokumen">
                            <!-- PERBAIKAN: Pemisahan atribut name dan readonly dilakukan dengan benar -->
                            <group>
                                <field name="adt_id" readonly="1"/>
                                <field name="adt_rowNumber" readonly="1"/>
                                <field name="adt_note" readonly="1"/>
                                <field name="adt_Branch" readonly="1"/>
                                <field name="adt_ChangeItemRefNbr" readonly="1"/>
                                <field name="adt_ControlQty" readonly="1"/>
                                <field name="adt_Customer" readonly="1"/>
                                <field name="adt_Date" readonly="1"/>
                                <field name="adt_Description" readonly="1"/>
                                <field name="adt_DocumentOnly" readonly="1"/>
                                <field name="adt_ExternalRef" readonly="1"/>
                            </group>

                            <group>
                                <field name="adt_LastModifiedDateTime" readonly="1"/>
                                <field name="adt_Location" readonly="1"/>
                                <field name="adt_NoteID" readonly="1"/>
                                <field name="adt_PostPeriod" readonly="1"/>
                                <field name="adt_ReferenceNbr" readonly="1"/>
                                <field name="adt_ShipmentNbr" readonly="1"/>
                                <field name="adt_Status" readonly="1"/>
                                <field name="adt_TotalQty" readonly="1"/>
                                <field name="adt_TransferNbr" readonly="1"/>
                                <field name="adt_TransType" readonly="1"/>
                                <field name="adt_Warehouse" readonly="1"/>
                            </group>
                        </group>
                    </group>

                    <!-- TABEL DETAIL BAWAHAN (One2many - line_ids) -->
                    <notebook>
                        <page string="Detail Lines" name="detail_lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="adt_id"/>
                                    <field name="adt_rowNumber"/>
                                    <field name="adt_note"/>
                                    <field name="adt_Branch"/>
                                    <field name="adt_Description"/>
                                    <field name="adt_InventoryID"/>
                                    <field name="adt_LineNumber"/>
                                    <field name="adt_Location"/>
                                    <field name="adt_NoteID"/>
                                    <field name="adt_Quantity"/>
                                    <field name="adt_UOM"/>
                                    <field name="adt_Warehouse"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <!-- Group Status Hasil Sinkronisasi ke Odoo Core -->
                    <group string="Import Odoo" class="mt-4">
                        <field name="import_message" readonly="1"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. WINDOW ACTION: Menghubungkan Menu Odoo agar memanggil View ini -->
    <record id="action_acumatica_inventory_receipt_transfer_wh_in_staging" model="ir.actions.act_window">
        <field name="name">Data Inventory Receipt : Transfer WH IN</field>
        <field name="res_model">acumatica.inventory.receipt.transfer.wh.in.staging</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_inventory_receipt_transfer_wh_in_staging_search"/>
    </record>

</odoo>
