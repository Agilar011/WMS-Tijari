<odoo>
    <record id="view_acumatica_transfer_shipment_config_list" model="ir.ui.view">
        <field name="name">acumatica.transfer.shipment.config.list</field>
        <field name="model">acumatica.transfer.shipment.config</field>
        <field name="arch" type="xml">
            <list string="Acumatica Transfer Shipment Config">
                <field name="name"/>
                <field name="base_url"/>
                <field name="api_version"/>
                <field name="company_code"/>
                <field name="endpoint_name"/>
                <field name="state"/>
                <field name="active"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_transfer_shipment_config_form" model="ir.ui.view">
        <field name="name">acumatica.transfer.shipment.config.form</field>
        <field name="model">acumatica.transfer.shipment.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Acumatica Transfer Shipment">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Koneksi">
                            <field name="name"/>
                            <field name="base_url"/>
                            <field name="api_version"/>
                            <field name="company_code"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="active"/>
                        </group>
                        <group string="Request Default">
                            <field name="endpoint_name"/>
                            <field name="odata_expand"/>
                            <field name="odata_select"/>
                            <field name="odata_filter"/>
                            <field name="last_sync" readonly="1"/>
                            <div class="o_form_label">Default request:</div>
                            <div>
                                <span class="text-muted">Shipment?$filter=Type eq 'Transfer' and Operation eq 'Issue'&amp;$expand=Details</span>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_transfer_shipment_config" model="ir.actions.act_window">
        <field name="name">API Config</field>
        <field name="res_model">acumatica.transfer.shipment.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
