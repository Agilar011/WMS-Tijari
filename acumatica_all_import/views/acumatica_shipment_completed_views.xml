    <!-- =========================================================
         STAGING SHIPMENT COMPLETED - FORM
         ========================================================= -->

    <record id="view_acumatica_shipment_completed_staging_form" model="ir.ui.view">
        <field name="name">acumatica.shipment.completed.staging.form</field>
        <field name="model">acumatica.shipment.completed.staging</field>
        <field name="arch" type="xml">

            <form string="Shipment Completed">

                <header>
                    <button name="action_reset_pending" string="Reset ke Staged" type="object" class="btn-secondary" invisible="import_state != 'error'"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="staged,created,updated,rejected,error"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="shipment_nbr"/>
                        </h1>
                    </div>

                    <!-- =================================================
                         STATUS
                         ================================================= -->

                    <group>

                        <group string="Shipment">
                            <field name="shipment_nbr"/>
                            <field name="issue_nbr"/>
                            <field name="inventory_nbr" />
                            <field name="order_type"/>
                            <field name="shipment_type"/>
                            <field name="status"/>
                            <field name="ship_date"/>
                        </group>

                        <group string="Shipment Information">
                            <field name="shipment_qty"/>
                            <field name="shipment_volume"/>
                            <field name="shipment_weight"/>
                            <field name="shipment_via"/>
                            <field name="fob_point"/>
                            <field name="fob_point_description"/>
                            <field name="site_id_description"/>
                        </group>

                    </group>


                    <!-- =================================================
                         CUSTOMER
                         ================================================= -->

                    <group string="Customer">

                        <group>
                            <field name="customer_id"/>
                            <field name="customer_name"/>
                        </group>

                        <group>
                            <field name="address_id"/>
                            <field name="address_line"/>
                            <field name="building_id"/>
                            <field name="location_id"/>
                            <field name="phone"/>
                        </group>

                    </group>


                    <group string="Address">

                        <group>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="state_name"/>
                        </group>

                        <group>
                            <field name="country"/>
                            <field name="country_name"/>
                            <field name="postal_code"/>
                        </group>

                    </group>


                    <!-- =================================================
                         WAREHOUSE / CONFIG
                         ================================================= -->

                    <group>

                        <group string="Warehouse">
                            <field name="warehouse_id"/>
                            <field name="to_warehouse_id"/>
                        </group>

                        <group string="Synchronization">
                            <field name="config_id"/>
                            <field name="sync_date"/>
                            <field name="last_modified_datetime" string="Last Modified" readonly="1"/>
                            <field name="note_header_id"/>
                        </group>

                    </group>


                    <!-- =================================================
                         IMPORT STATUS
                         ================================================= -->

                    <group string="Processing">

                        <group>
                            <field name="selected"/>
                            <field name="import_state"/>
                        </group>

                        <group>
                            <field name="import_message"
                                   widget="text"/>
                        </group>

                    </group>


                    <!-- =================================================
                         DETAILS
                         ================================================= -->

                    <notebook>

                        <page string="Shipment Details">

                            <field name="line_ids"
                                   nolabel="1">

                                <list editable="bottom">

                                    <field name="line_nbr"/>
                                    <field name="line_inventory_id"/>
                                    <field name="line_description"/>

                                    <field name="line_quantity"/>
                                    <field name="line_uom"/>

                                    <field name="line_free_item"/>

                                    <field name="location_id"/>
                                    <field name="location_name"/>

                                    <field name="line_note"/>

                                </list>

                            </field>

                        </page>


                        <page string="Notes">

                            <group>
                                <field name="note_header" widget="text"/>
                                <field name="note"
                                       nolabel="1"
                                       widget="text"/>
                            </group>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


