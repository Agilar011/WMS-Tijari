<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_import_selected_shipment_completed" model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_shipment_completed_staging"/>
        <field name="binding_model_id" ref="model_acumatica_shipment_completed_staging"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">records.action_import_selected()</field>
    </record>

    <!-- =========================================================
         STAGING SHIPMENT COMPLETED - LIST
         ========================================================= -->

    <record id="acumatica_shipment_completed_staging_view_list" model="ir.ui.view">
        <field name="name">acumatica.shipment.completed.staging.view.list</field>
        <field name="model">acumatica.shipment.completed.staging</field>
        <field name="arch" type="xml">
            <list>

                <field name="selected" widget="boolean_toggle"/>

                <field name="shipment_nbr"/>
                <field name="issue_nbr" optional="show"/>
                <field name="ship_date"/>

                <field name="inventory_nbr" />
                <field name="order_type"/>
                <field name="shipment_type"/>
                <field name="status"/>

                <field name="customer_id"/>
                <field name="customer_name"/>

                <field name="warehouse_id"/>
                <field name="to_warehouse_id"/>

                <field name="shipment_qty"/>
                <field name="shipment_weight"/>

                <field name="import_state"
                       decoration-success="import_state == 'created'"
                       decoration-info="import_state == 'updated'"
                       decoration-muted="import_state == 'staged'"
                       decoration-danger="import_state == 'error'"/>

                <field name="sync_date"/>
                <field name="config_id"/>
                <field name="last_modified_datetime" string="Last Modified"/>

            </list>
        </field>
    </record>

