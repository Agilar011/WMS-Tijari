<odoo>

    <record id="action_acumatica_shipment_completed_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi Acumatica Shipment Completed</field>
        <field name="res_model">acumatica.config</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('config_type', '=', 'shipment_completed')]</field>
        <field name="context">{
            'default_config_type': 'shipment_completed',
            'default_endpoint_name': 'ShipmentCompletedGI',
            'default_odata_expand': 'ShipmentCompletedGIDetails',
            'default_is_default': True,
        }</field>
    </record>
</odoo>
