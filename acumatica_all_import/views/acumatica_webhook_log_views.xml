<odoo>
    <record id="view_acumatica_webhook_log_search" model="ir.ui.view">
        <field name="name">acumatica.webhook.log.search</field>
        <field name="model">acumatica.webhook.log</field>
        <field name="arch" type="xml">
            <search string="Webhook Logs">
                <field name="webhook_name"/>
                <field name="company_id_text"/>
                <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
                <filter string="Processed" name="processed" domain="[('state','=','processed')]"/>
                <filter string="Error" name="error" domain="[('state','=','error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by':'webhook_type'}"/>
                    <filter string="Webhook" name="group_webhook" context="{'group_by':'webhook_name'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_webhook_log_list" model="ir.ui.view">
        <field name="name">acumatica.webhook.log.list</field>
        <field name="model">acumatica.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Webhook Logs" create="0">
                <field name="create_date"/>
                <field name="webhook_type"/>
                <field name="webhook_name"/>
                <field name="created_count" string="Staging Records"/>
                <field name="imported_count" string="Generated to WMS"/>
                <field name="error_count" string="WMS Errors"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'processed'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'error'"/>
                <button name="action_process_to_staging" string="Process" type="object" icon="fa-play" invisible="state == 'processed'"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_webhook_log_form" model="ir.ui.view">
        <field name="name">acumatica.webhook.log.form</field>
        <field name="model">acumatica.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Webhook Log" create="0">
                <header>
                    <button name="action_process_to_staging" string="Process to Staging/Master" type="object" class="btn-primary" invisible="state == 'processed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processed,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Webhook">
                            <field name="webhook_type"/>
                            <field name="webhook_name"/>
                            <field name="company_id_text"/>
                            <field name="acumatica_event_id"/>
                            <field name="acumatica_timestamp"/>
                            <field name="processed_date"/>
                        </group>
                        <group string="Counters">
                            <field name="created_count" string="Staging Records"/>
                            <field name="imported_count" string="Generated to WMS"/>
                            <field name="error_count" string="WMS Errors"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="text"/>
                        </page>
                        <page string="Log">
                            <field name="result_message" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_webhook_log" model="ir.actions.act_window">
        <field name="name">Webhook Logs</field>
        <field name="res_model">acumatica.webhook.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acumatica_webhook_log_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
