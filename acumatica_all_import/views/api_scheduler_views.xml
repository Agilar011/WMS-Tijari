<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_scheduler_job_list" model="ir.ui.view">
        <field name="name">api.scheduler.job.list</field>
        <field name="model">api.scheduler.job</field>
        <field name="arch" type="xml">
            <list class="o_list_table_auto_layout">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
                <field name="job_type"/>
                <field name="cron_active" groups="base.group_system"/>
                <field name="is_running"/>
            </list>
        </field>
    </record>

    <record id="view_api_scheduler_job_form" model="ir.ui.view">
        <field name="name">api.scheduler.job.form</field>
        <field name="model">api.scheduler.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" string="Run Now" type="object" class="btn-primary"/>
                    <button name="action_open_ir_cron" string="Open Odoo Cron" type="object" groups="base.group_system"/>
                </header>
                <sheet>
                    <group string="General Information">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="job_type"/>
                            <field name="selected_data_category"
                                   invisible="job_type not in ['fetch_selected', 'import_selected']"/>
                            <field name="selected_data_type_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('data_category', '=', selected_data_category), ('code', '!=', 'inventory_stock')]"
                                   invisible="job_type not in ['fetch_selected', 'import_selected']"/>
                            <field name="is_running" readonly="1"/>
                            <field name="cron_active" groups="base.group_system"/>
                            <field name="do_not_overlap" string="Prevent Overlapping Runs" help="Prevent overlapping executions of this scheduler job."/>
                            <field name="ir_cron_id" readonly="1" groups="base.group_system"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule">
                            <group>
                                <group>
                                    <field name="cron_interval_number" groups="base.group_system"/>
                                    <field name="cron_interval_type" groups="base.group_system"/>
                                    <field name="cron_user_id" groups="base.group_system"/>
                                </group>
                                <group>
                                    <field name="cron_nextcall" groups="base.group_system"/>
                                </group>
                            </group>
                        </page>
                        <page string="Log Activity">
                            <field name="log_ids" readonly="1">
                                <list create="false" edit="false" delete="false" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'running' or status == 'queued'" class="o_list_table_auto_layout">
                                    <field name="execution_time"/>
                                    <field name="duration"/>
                                    <field name="data_retrieved"/>
                                    <field name="staging_created"/>
                                    <field name="records_created"/>
                                    <field name="records_errors"/>
                                    <field name="records_skipped"/>
                                    <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'queued'"/>
                                    <button name="action_view_details" string="Open Detail" type="object" icon="fa-external-link" title="View Details"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_api_scheduler_log_detail_list" model="ir.ui.view">
        <field name="name">api.scheduler.log.detail.list</field>
        <field name="model">api.scheduler.log.detail</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" class="o_list_table_auto_layout">
                <field name="data_type"/>
                <field name="acumatica_data"/>
                <field name="data_retrieved"/>
                <field name="staging_created"/>
                <field name="records_created"/>
                <field name="records_errors"/>
                <field name="records_skipped"/>
            </list>
        </field>
    </record>

    <record id="view_api_scheduler_log_list" model="ir.ui.view">
        <field name="name">api.scheduler.log.list</field>
        <field name="model">api.scheduler.log</field>
        <field name="arch" type="xml">
                <list create="false" edit="false" delete="false" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'running' or status == 'queued'">
                <field name="scheduler_job_id"/>
                <field name="execution_time"/>
                <field name="duration"/>
                <field name="data_retrieved"/>
                <field name="staging_created"/>
                <field name="records_created"/>
                <field name="records_errors"/>
                <field name="records_skipped"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'queued'"/>
                <button name="action_view_details" type="object" icon="fa-list" title="View Details"/>
            </list>
        </field>
    </record>

    <record id="action_api_scheduler_job" model="ir.actions.act_window">
        <field name="name">Schedulers</field>
        <field name="res_model">api.scheduler.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
