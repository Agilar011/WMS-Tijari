<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_scheduler_job_list" model="ir.ui.view">
        <field name="name">api.scheduler.job.list</field>
        <field name="model">api.scheduler.job</field>
        <field name="arch" type="xml">
            <list class="o_list_table_auto_layout">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
                <field name="acumatica_import"/>
                <field name="acumatica_data_type"/>
                <field name="execution_interval"/>
                <field name="interval_value"/>
                <field name="interval_unit"/>
                <field name="next_execution"/>
                <field name="is_running"/>
            </list>
        </field>
    </record>

    <record id="view_api_scheduler_job_form" model="ir.ui.view">
        <field name="name">api.scheduler.job.form</field>
        <field name="model">api.scheduler.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" string="Run Now" type="object" class="btn-primary"/>
                    <button name="action_open_ir_cron" string="Open Odoo Cron" type="object"/>
                </header>
                <sheet>
                    <group string="General Information">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="acumatica_import"/>
                            <field name="acumatica_data_type" invisible="not acumatica_import" required="acumatica_import"/>
                            <field name="is_running" readonly="1"/>
                            <field name="ir_cron_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule">
                            <group>
                                <group>
                                    <field name="execution_interval"/>
                                    <field name="interval_value"/>
                                    <field name="interval_unit"/>
                                </group>
                                <group>
                                    <field name="next_execution"/>
                                    <field name="timezone"/>
                                    <field name="do_not_overlap"/>
                                </group>
                            </group>
                        </page>
                        <page string="Log Activity">
                            <field name="log_ids" readonly="1">
                                <list create="false" edit="false" delete="false" decoration-success="status == 'success'" decoration-danger="status == 'failed'" class="o_list_table_auto_layout">
                                    <field name="execution_time"/>
                                    <field name="duration"/>
                                    <field name="data_retrieved"/>
                                    <field name="staging_created"/>
                                    <field name="records_created"/>
                                    <field name="records_errors"/>
                                    <field name="records_skipped"/>
                                    <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
                                    <button name="action_view_details" string="Open Detail" type="object" icon="fa-external-link" title="View Details"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_api_scheduler_log_detail_list" model="ir.ui.view">
        <field name="name">api.scheduler.log.detail.list</field>
        <field name="model">api.scheduler.log.detail</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" class="o_list_table_auto_layout">
                <field name="data_type"/>
                <field name="acumatica_data"/>
                <field name="data_retrieved"/>
                <field name="staging_created"/>
                <field name="records_created"/>
                <field name="records_errors"/>
                <field name="records_skipped"/>
            </list>
        </field>
    </record>

    <record id="view_api_scheduler_log_list" model="ir.ui.view">
        <field name="name">api.scheduler.log.list</field>
        <field name="model">api.scheduler.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-success="status == 'success'" decoration-danger="status == 'failed'">
                <field name="scheduler_job_id"/>
                <field name="execution_time"/>
                <field name="duration"/>
                <field name="data_retrieved"/>
                <field name="staging_created"/>
                <field name="records_created"/>
                <field name="records_errors"/>
                <field name="records_skipped"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
                <button name="action_view_details" type="object" icon="fa-list" title="View Details"/>
            </list>
        </field>
    </record>

    <record id="action_api_scheduler_job" model="ir.actions.act_window">
        <field name="name">API Scheduler</field>
        <field name="res_model">api.scheduler.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
