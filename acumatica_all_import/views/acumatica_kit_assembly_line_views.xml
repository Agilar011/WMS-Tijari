<odoo>
    <record id="action_import_selected_kit_assembly"
            model="ir.actions.server">
        <field name="name">Select All &amp; Generate</field>
        <field name="model_id" ref="model_acumatica_kit_assembly_line"/>
        <field name="binding_model_id" ref="model_acumatica_kit_assembly_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_kit_assembly_line_list" model="ir.ui.view">
        <field name="name">acumatica.kit.assembly.line.list</field>
        <field name="model">acumatica.kit.assembly.line</field>
        <field name="arch" type="xml">
            <list string="Data Kit Assembly dari Acumatica" create="0" delete="0">
                <field name="selected" widget="boolean_toggle"/>
                <field name="reference_nbr"/>
                <field name="line_nbr"/>
                <field name="inventory_id" optional="show"/>
                <field name="description"/>
                <field name="quantity" optional="show"/>
                <field name="uom" optional="show"/>
                <field name="warehouse" optional="show"/>
                <field name="line_inventory_id" optional="show"/>
                <field name="line_component_qty" optional="show"/>
                <field name="line_uom" optional="show"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state in ('imported','updated')"
                       decoration-warning="import_state == 'pending'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_product" string="Open Product" type="object" icon="fa-external-link" invisible="not odoo_product_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_kit_assembly_line_form" model="ir.ui.view">
        <field name="name">acumatica.kit.assembly.line.form</field>
        <field name="model">acumatica.kit.assembly.line</field>
        <field name="arch" type="xml">
            <form string="Kit Assembly Line Acumatica">
                <header>
                    <button name="action_import_this" string="Import Baris Ini" type="object" class="btn-primary" invisible="import_state != 'pending'"/>
                    <button name="action_open_product" string="Buka Product" type="object" invisible="not odoo_product_id"/>
                    <button name="action_reset_pending" string="Reset ke Pending" type="object" invisible="import_state != 'error'"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="pending,imported,updated,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Header Kit Assembly">
                            <field name="reference_nbr"/>
                            <field name="inventory_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="uom"/>
                            <field name="warehouse"/>
                            <field name="location"/>
                            <field name="status"/>
                            <field name="type"/>
                            <field name="reason_code"/>
                            <field name="post_period"/>
                            <field name="requested_on"/>
                            <field name="revision"/>
                            <field name="last_modified_datetime"/>
                            <field name="external_id"/>
                        </group>
                        <group string="Detail Component">
                            <field name="line_nbr"/>
                            <field name="line_inventory_id"/>
                            <field name="line_component_qty"/>
                            <field name="line_quantity"/>
                            <field name="line_uom"/>
                            <field name="line_location_id"/>
                            <field name="line_reason_code"/>
                            <field name="stock_inventory_id"/>
                            <field name="line_external_id"/>
                            <field name="line_note"/>
                        </group>
                    </group>
                    <group>
                        <field name="import_message" readonly="1"/>
                        <field name="odoo_product_id" readonly="1"/>
                        <field name="odoo_bom_id" readonly="1"/>
                        <field name="config_id" readonly="1"/>
                        <field name="sync_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_kit_assembly_line" model="ir.actions.act_window">
        <field name="name">Data Kit Assembly</field>
        <field name="res_model">acumatica.kit.assembly.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
