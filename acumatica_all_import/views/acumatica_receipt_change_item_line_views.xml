<odoo>

    <record id="action_import_selected_receipt_change_item"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_receipt_change_item_line"/>
        <field name="binding_model_id" ref="model_acumatica_receipt_change_item_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_receipt_change_item_line_tree" model="ir.ui.view">
        <field name="name">acumatica.receipt.change.item.line.tree</field>
        <field name="model">acumatica.receipt.change.item.line</field>
        <field name="arch" type="xml">
            <list string="Data Receipt : Change Item">
                <field name="origin"/>
                <field name="customer_code"/>
                <field name="warehouse_code"/>
                <field name="total_qty"/>
                <field name="status"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state in ('imported','updated')"
                       decoration-warning="import_state == 'pending'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Receipt" type="object" icon="fa-external-link" invisible="not odoo_picking_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_receipt_change_item_line_form" model="ir.ui.view">
        <field name="name">acumatica.receipt.change.item.line.form</field>
        <field name="model">acumatica.receipt.change.item.line</field>
        <field name="arch" type="xml">
            <form string="Data Receipt : Change Item">
                <header>
                    <button name="action_import_this" string="Import Baris Ini" type="object" class="btn-primary" invisible="import_state != 'pending'"/>
                    <button name="action_open_picking" string="Buka Picking" type="object" class="btn-secondary" invisible="not odoo_picking_id"/>
                    <button name="action_reset_pending" string="Reset Pending" type="object" class="btn-secondary" invisible="import_state != 'error'"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="pending,imported,updated,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Header">
                            <field name="config_id"/>
                            <field name="picking_type_id"/>
                            <field name="origin"/>
                            <field name="scheduled_date"/>
                            <field name="description"/>
                            <field name="note"/>
                            <field name="actual_qty"/>
                            <field name="status"/>
                            <field name="warehouse_code"/>
                            <field name="transfer_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Details" string="Details">
                            <field name="product_line_ids">
                                <list>
                                    <field name="inventory_id"/>
                                    <field name="description"/>
                                    <field name="warehouse_dest_code"/>
                                    <field name="product_uom_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message" readonly="1" widget="text"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_receipt_change_item_line" model="ir.actions.act_window">
        <field name="name">Data Receipt : Change Item</field>
        <field name="res_model">acumatica.receipt.change.item.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
