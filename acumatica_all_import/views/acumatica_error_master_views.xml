<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="acumatica_error_master_view_tree" model="ir.ui.view">
        <field name="name">acumatica.error.master.view.tree</field>
        <field name="model">acumatica.error.master</field>
        <field name="arch" type="xml">
            <list string="" create="0" edit="0" delete="0">
                <field name="create_date" />
                <field name="name" />
                <field name="data_type" />
                <field 
                    name="import_state" 
                    widget="badge" 
                    decoration-success="import_state == 'solved'" 
                    decoration-info="import_state == 'updated'" 
                    decoration-warning="import_state == 'skipped'" 
                    decoration-danger="import_state == 'error'" 
                    decoration-muted="import_state == 'staged'"
                />
                <field name="error_msg" />
                <button string="Open" name="action_open_record" type="object" class="oe_highlight"/>
            </list>
        </field>
    </record>

    <record id="acumatica_error_master_data_action" model="ir.actions.act_window">
        <field name="name">Acumatica Import Error Logs</field>
        <field name="res_model">acumatica.error.master</field>
        <field name="view_mode">list</field>
        <field name="domain">[
        ]</field>
    </record>

    <menuitem 
        id="menu_acumatica_error_master_root" 
        name="Error Logs" 
        parent="menu_acumatica_all_import_root" 
        sequence="50"
    />

    <menuitem 
        id="menu_acumatica_error_master_data" 
        name="Error Data Master" 
        parent="menu_acumatica_error_master_root" 
        action="acumatica_error_master_data_action"
        sequence="51"
    />
</odoo>
