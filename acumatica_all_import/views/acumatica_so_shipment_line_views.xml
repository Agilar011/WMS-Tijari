<odoo>
    <record id="action_import_selected_so_shipment"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_shipment_gi_staging"/>
        <field name="binding_model_id" ref="model_acumatica_so_shipment_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_search" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.search</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <search>
                <!-- <field name="inventory_id"/> -->
                <field name="import_state"/>

                <filter string="Pending" name="pending" domain="[('import_state','=','pending')]"/>
                <filter string="Done" name="done" domain="[('import_state','in',('imported','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>

                <group expand="0" string="Group By">
                    <!-- <filter string="Shipment" name="group_receipt" context="{'group_by': 'receipt_nbr'}"/> -->
                    <!-- <filter string="Customer" name="group_partner" context="{'group_by': 'partner_code'}"/> -->
                    <filter string="Status" name="group_state" context="{'group_by': 'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_list" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.list</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <list string="Data SO Shipment" multi_edit="1">
                <field name="selected" widget="boolean_toggle"/>
                <field name="row_number"/>
                <!-- <field name="inventory_id"/> -->
                <!-- <field name="uom_code"/> -->
                <field name="to_warehouse_id"/>
                <!-- <field name="location_dest_code"/> -->
                <field name="import_state"/>
                <field name="import_message"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_form" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.form</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <form string="Data SO Shipment">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'pending'"/>
                    <button name="action_open_picking" type="object" string="Open Receipt" class="btn-secondary" invisible="not odoo_picking_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Pending" class="btn-secondary" invisible="import_state != 'error'"/>
                </header>
                <sheet>
                    <group string="Header">
                        <group>
                            <field name="id" readonly="1"/>
                            <field name="row_number" readonly="1"/>
                            <field name="odoo_picking_id" readonly="1"/>
                            <field name="config_id" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                            <field name="write_uid" readonly="1"/>
                            <field name="acumatica_id" readonly="1"/>
                            <field name="shipment_nbr" readonly="1"/>
                            <field name="customer" readonly="1"/>
                            <field name="customer_name" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="location" readonly="1"/>
                            <field name="location_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="shipment_type" readonly="1"/>
                            <field name="address_id" readonly="1"/>
                            <field name="address_line1" readonly="1"/>
                            <field name="address_line2" readonly="1"/>
                            <field name="address_line3" readonly="1"/>
                            <field name="city" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="state_name" readonly="1"/>
                            <field name="country" readonly="1"/>
                            <field name="country_name" readonly="1"/>
                            <field name="postal_code" readonly="1"/>
                            <field name="ship_via" readonly="1"/>
                            <field name="ship_via_description" readonly="1"/>
                            <field name="ship_via_address" readonly="1"/>
                            <field name="ship_via_city" readonly="1"/>
                            <field name="ship_via_phone" readonly="1"/>
                            <field name="ship_via_status" readonly="1"/>
                            <field name="fob_point" readonly="1"/>
                            <field name="fob_point_description" readonly="1"/>
                        </group>
                        <group>
                            <field name="note_ship_via" readonly="1"/>
                            <field name="order_type" readonly="1"/>
                            <field name="site_id_description" readonly="1"/>
                            <field name="to_warehouse_id" readonly="1"/>
                            <field name="import_state" readonly="1"/>
                            <field name="import_message" readonly="1"/>
                            <field name="note" readonly="1"/>
                            <field name="confirmed" readonly="1"/>
                            <field name="hold" readonly="1"/>
                            <field name="document_only" readonly="1"/>
                            <field name="override_address" readonly="1"/>
                            <field name="active" readonly="1"/>
                            <field name="selected" readonly="1"/>
                            <field name="ship_date" readonly="1"/>
                            <field name="sync_date" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="write_date" readonly="1"/>
                            <field name="shipped_quantity" readonly="1"/>
                            <field name="shipped_weight" readonly="1"/>
                            <field name="shipped_volume" readonly="1"/>
                            <field name="odoo_shipment_status" readonly="1"/>
                            <field name="picking_type_id" readonly="1"/>
                        </group>

                    </group>
                    <!-- <group string="Line"> -->
                        <!-- <group> -->
                            <!-- <field name="line_nbr" readonly="1"/> -->
                            <!-- <field name="acumatica_line_number" readonly="1"/> -->
                            <!-- <field name="inventory_id" readonly="1"/> -->
                            <!-- <field name="uom_code" readonly="1"/> -->
                            <!-- <field name="detail_warehouse_code" readonly="1"/> -->
                        <!-- </group> -->
                        <!-- <group> -->
                            <!-- <field name="location_dest_code" readonly="1"/> -->
                            <!-- <field name="order_number" readonly="1"/> -->
                            <!-- <field name="order_line_number" readonly="1"/> -->
                            <!-- <field name="order_type" readonly="1"/> -->
                            <!-- <field name="open_qty" readonly="1"/> -->
                            <!-- <field name="original_qty" readonly="1"/> -->
                            <!-- <field name="import_state" readonly="1"/> -->
                            <!-- <field name="import_message" readonly="1"/> -->
                        <!-- </group> -->
                    <!-- </group> -->
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_so_shipment_line" model="ir.actions.act_window">
        <field name="name">Data SO Shipment</field>
        <field name="res_model">acumatica.shipment.gi.staging</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_type', '!=', 'CO')]</field>
        <field name="search_view_id"/>
    </record>

    <record id="action_acumatica_so_shipment_consignment_line" model="ir.actions.act_window">
        <field name="name">Data SO Shipment Consignment</field>
        <field name="res_model">acumatica.shipment.gi.staging</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_type', '=', 'CO')]</field>
        <field name="search_view_id"/>
    </record>
</odoo>
