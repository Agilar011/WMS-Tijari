<odoo>
    <record id="action_import_selected_so_shipment"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_shipment_gi_staging"/>
        <field name="binding_model_id" ref="model_acumatica_shipment_gi_staging"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_search" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.search</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <search>
                <!-- <field name="inventory_id"/> -->
                <field name="import_state"/>

                <filter string="Staged" name="staged" domain="[('import_state','=','staged')]"/>
                <filter string="Done" name="done" domain="[('import_state','in',('created','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>

                <group expand="0" string="Group By">
                    <!-- <filter string="Shipment" name="group_receipt" context="{'group_by': 'receipt_nbr'}"/> -->
                    <!-- <filter string="Customer" name="group_partner" context="{'group_by': 'partner_code'}"/> -->
                    <filter string="Status" name="group_state" context="{'group_by': 'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_list" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.list</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <list string="Data SO Shipment" multi_edit="1">
                <field name="selected" widget="boolean_toggle"/>
                <field name="adt_ShipmentNbr"/>
                <field name="adt_IssueNbr"/>
                <field name="adt_OrderType"/>
                <field name="adt_ShipmentType"/>
                <field name="adt_DocumentOnly"/>
                <field name="adt_CustomerID"/>
                <field name="adt_WarehouseID"/>
                <field name="total_qty"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state == 'created'" decoration-info="import_state == 'updated'" decoration-warning="import_state == 'rejected'"
                       decoration-muted="import_state == 'staged'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <field name="lastmodifieddatetime" string="Last Modified"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Document" type="object" icon="fa-external-link" invisible="not odoo_picking_id"/>            </list>
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_form" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.form</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <form string="Data SO Shipment">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'staged'"/>
                    <button name="action_open_picking" type="object" string="Open Document" class="btn-secondary" invisible="not odoo_picking_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Staged" class="btn-secondary" invisible="import_state != 'error'"/>
                </header>
                <sheet>
                    <field name="import_state" invisible="1"/>
                    <field name="odoo_picking_id" invisible="1"/>

                    <div class="oe_title">
                        <h1><field name="adt_ShipmentNbr"/></h1>
                    </div>

                    <group>
                        <group string="Shipment">
                            <field name="adt_ShipmentNbr"/>
                            <field name="adt_IssueNbr"/>
                            <field name="adt_Description"/>
                            <field name="adt_OrderType"/>
                            <field name="adt_ShipmentType"/>
                            <field name="adt_Status"/>
                            <field name="adt_ShipDate"/>
                        </group>
                        <group string="Shipment Information">
                            <field name="adt_ShipmentQty"/>
                            <field name="adt_ShipmentVolume"/>
                            <field name="adt_ShipmentWeight"/>
                            <field name="adt_ShipVia"/>
                            <field name="adt_FOBPoint"/>
                            <field name="adt_FOBPointDescription"/>
                            <field name="adt_SiteIDDescription"/>
                        </group>
                    </group>

                    <group string="Customer">
                        <group>
                            <field name="adt_CustomerID"/>
                            <field name="adt_CustomerName"/>
                            <field name="adt_Phone"/>
                        </group>
                        <group>
                            <field name="adt_AddressID"/>
                            <field name="adt_AddressLine"/>
                            <field name="adt_BuildingID"/>
                            <field name="adt_LocationID"/>
                            <field name="adt_LocationName"/>
                        </group>
                    </group>

                    <group string="Address">
                        <group>
                            <field name="adt_City"/>
                            <field name="adt_State"/>
                            <field name="adt_StateName"/>
                        </group>
                        <group>
                            <field name="adt_Country"/>
                            <field name="adt_CountryName"/>
                            <field name="adt_PostalCode"/>
                        </group>
                    </group>

                    <group>
                        <group string="Warehouse">
                            <field name="adt_WarehouseID"/>
                            <field name="adt_ToWarehouseID"/>
                            <field name="picking_type_id" readonly="1"/>
                        </group>
                        <group string="Synchronization">
                            <field name="config_id" readonly="1"/>
                            <field name="sync_date" readonly="1"/>
                            <field name="lastmodifieddatetime" string="Last Modified" readonly="1"/>
                            <field name="adt_rowNumber"/>
                        </group>
                    </group>

                    <group string="Processing">
                        <group>
                            <field name="selected"/>
                            <field name="adt_DocumentOnly"/>
                            <field name="exists_in_odoo" readonly="1"/>
                        </group>
                        <group>
                            <field name="import_message" readonly="1" widget="text"/>
                        </group>
                    </group>

                    <notebook name="Details">
                        <page string="Shipment Details" name="all_shipment_lines">
                            <field name="all_line_ids">
                                <list>
                                    <field name="adt_LineNbr"/>
                                    <field name="adt_LineInventoryID"/>
                                    <field name="adt_LineDescription"/>
                                    <field name="adt_LineQuantity" string="Line Quantity"/>
                                    <field name="adt_ShipmentQty" string="Shipment Quantity"/>
                                    <field name="adt_LineUOM"/>
                                    <field name="adt_LineLocation"/>
                                    <field name="adt_LineNote"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <group>
                                <field name="adt_NoteHeader" widget="text"/>
                                <field name="adt_NoteHeaderID"/>
                                <field name="adt_note" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_acumatica_so_shipment_line" model="ir.actions.act_window">
        <field name="name">Data SO Shipment</field>
        <field name="res_model">acumatica.shipment.gi.staging</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('adt_OrderType', '!=', 'CO')]</field>
        <field name="search_view_id"/>
    </record>

    <record id="action_acumatica_so_shipment_consignment_line" model="ir.actions.act_window">
        <field name="name">Data SO Shipment Consignment</field>
        <field name="res_model">acumatica.shipment.gi.staging</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('adt_OrderType', '=', 'CO')]</field>
        <field name="search_view_id"/>
    </record>
</odoo>
