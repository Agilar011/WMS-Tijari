<odoo>
    <record id="action_import_selected_so_shipment"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_shipment_gi_staging"/>
        <field name="binding_model_id" ref="model_acumatica_shipment_gi_staging"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_search" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.search</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <search>
                <!-- <field name="inventory_id"/> -->
                <field name="import_state"/>

                <filter string="Pending" name="pending" domain="[('import_state','=','pending')]"/>
                <filter string="Done" name="done" domain="[('import_state','in',('imported','updated'))]"/>
                <filter string="Error" name="error" domain="[('import_state','=','error')]"/>

                <group expand="0" string="Group By">
                    <!-- <filter string="Shipment" name="group_receipt" context="{'group_by': 'receipt_nbr'}"/> -->
                    <!-- <filter string="Customer" name="group_partner" context="{'group_by': 'partner_code'}"/> -->
                    <filter string="Status" name="group_state" context="{'group_by': 'import_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_list" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.list</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <list string="Data SO Shipment" multi_edit="1">
                <field name="selected" widget="boolean_toggle"/>
                <field name="adt_ShipmentNbr"/>
                <field name="adt_DocumentOnly"/>
                <field name="adt_CustomerID"/>
                <field name="adt_WarehouseID"/>
                <field name="total_qty"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state in ('imported','updated')"
                       decoration-warning="import_state == 'pending'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Receipt" type="object" icon="fa-external-link" invisible="not odoo_picking_id"/>            </list>
        </field>
    </record>

    <record id="view_acumatica_so_shipment_line_form" model="ir.ui.view">
        <field name="name">acumatica.shipment.gi.staging.form</field>
        <field name="model">acumatica.shipment.gi.staging</field>
        <field name="arch" type="xml">
            <form string="Data SO Shipment">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state != 'pending'"/>
                    <button name="action_open_picking" type="object" string="Open Receipt" class="btn-secondary" invisible="not odoo_picking_id"/>
                    <button name="action_reset_pending" type="object" string="Reset Pending" class="btn-secondary" invisible="import_state != 'error'"/>
                </header>
                <sheet>
                    <!-- Field indikator tersembunyi agar tidak memicu error pada tombol header -->
                    <field name="import_state" invisible="1"/>
                    <field name="odoo_picking_id" invisible="1"/>

                    <group string="Header">
                        <group>
                            <field name="adt_ShipmentNbr" readonly="1"/>
                            <field name="picking_type_id" readonly="1"/>
                            <field name="adt_CustomerID" readonly="1"/>
                            <field name="adt_CustomerName" readonly="1"/>
                            <field name="adt_ShipDate" readonly="1"/>
                            <field name="adt_WarehouseID" readonly="1"/>
                            <field name="adt_LocationID" readonly="1"/>
                            <field name="adt_LocationName" readonly="1"/>
                            <field name="adt_Status" readonly="1"/>
                            <field name="adt_OrderType" readonly="1"/>
                        </group>
                        <group>
                            <field name="adt_rowNumber" readonly="1"/>
                            <field name="adt_note" readonly="1"/>
                            <field name="adt_AddressID" readonly="1"/>
                            <field name="adt_AddressLine" readonly="1"/>
                            <field name="adt_BuildingID" readonly="1"/>
                            <field name="adt_City" readonly="1"/>
                            <field name="adt_Country" readonly="1"/>
                            <field name="adt_CountryName" readonly="1"/>
                            <field name="adt_DocumentOnly" readonly="1"/>
                            <field name="adt_FOBPoint" readonly="1"/>
                            <field name="adt_FOBPointDescription" readonly="1"/>
                            <!-- <field name="adt_LineDescription" readonly="1"/> -->
                            <!-- <field name="adt_LineFreeItem" readonly="1"/> -->
                            <!-- <field name="adt_LineInventoryID" readonly="1"/> -->
                            <!-- <field name="adt_LineLocation" readonly="1"/> -->
                            <!-- <field name="adt_LineNbr" readonly="1"/> -->
                            <!-- <field name="adt_LineNote" readonly="1"/> -->
                            <!-- <field name="adt_LineNoteID" readonly="1"/> -->
                            <!-- <field name="adt_LineQuantity" readonly="1"/> -->
                            <!-- <field name="adt_LineUOM" readonly="1"/> -->
                            <field name="adt_NoteHeader" readonly="1"/>
                            <field name="adt_NoteHeaderID" readonly="1"/>
                            <field name="adt_Phone" readonly="1"/>
                            <field name="adt_PostalCode" readonly="1"/>
                            <field name="adt_ShipmentQty" readonly="1"/>
                            <field name="adt_ShipmentType" readonly="1"/>
                            <field name="adt_ShipmentVolume" readonly="1"/>
                            <field name="adt_ShipmentWeight" readonly="1"/>
                            <field name="adt_ShipVia" readonly="1"/>
                            <field name="adt_SiteIDDescription" readonly="1"/>
                            <field name="adt_State" readonly="1"/>
                            <field name="adt_StateName" readonly="1"/>
                            <field name="adt_ToWarehouseID" readonly="1"/>
                        </group> 
                    </group>

                    <notebook name="Details">
                        <page string="All Shipment Lines" name="all_shipment_lines">
                            <field name="all_line_ids" readonly="1">
                                <list>
                                    <field name="adt_LineInventoryID" readonly="1"/>
                                    <field name="adt_LineDescription" readonly="1"/>
                                    <field name="adt_WarehouseID" readonly="1"/>
                                    <field name="adt_ShipmentQty" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message" readonly="1" widget="text"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_acumatica_so_shipment_line" model="ir.actions.act_window">
        <field name="name">Data SO Shipment</field>
        <field name="res_model">acumatica.shipment.gi.staging</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('adt_OrderType', '!=', 'CO')]</field>
        <field name="search_view_id"/>
    </record>

    <record id="action_acumatica_so_shipment_consignment_line" model="ir.actions.act_window">
        <field name="name">Data SO Shipment Consignment</field>
        <field name="res_model">acumatica.shipment.gi.staging</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('adt_OrderType', '=', 'CO')]</field>
        <field name="search_view_id"/>
    </record>
</odoo>
