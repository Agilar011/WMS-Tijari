<odoo>
    <record id="view_acumatica_issue_po_return_config_form" model="ir.ui.view">
        <field name="name">acumatica.issue.po.return.config.form</field>
        <field name="model">acumatica.issue.po.return.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Acumatica Inventory Receipt">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Koneksi API">
                            <field name="name"/>
                            <field name="base_url"/>
                            <field name="api_version"/>
                            <field name="endpoint_name"/>
                        </group>
                        <group string="Kredensial">
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="company_code"/>
                        </group>
                    </group>
                    <group>
                        <group string="Info Sync">
                            <field name="last_sync" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="OData Settings">
                            <field name="odata_expand"/>
                            <field name="odata_select"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_acumatica_issue_po_return_config_list" model="ir.ui.view">
        <field name="name">acumatica.issue.po.return.config.list</field>
        <field name="model">acumatica.issue.po.return.config</field>
        <field name="arch" type="xml">
            <list string="Konfigurasi Acumatica Inventory Receipt">
                <field name="name"/>
                <field name="base_url"/>
                <field name="endpoint_name"/>
                <field name="username"/>
                <field name="company_code"/>
                <field name="last_sync"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'draft'"/>
                <button name="action_test_connection" string="Test" type="object" icon="fa-plug"/>
            </list>
        </field>
    </record>

    <record id="action_acumatica_issue_po_return_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi Acumatica PO Return</field>
        <field name="res_model">acumatica.config</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('config_type', '=', 'issue_po_return')]</field>
        <field name="context">{
            'default_config_type': 'issue_po_return',
            'default_endpoint_name': 'PurchaseReceiptGI',
            'default_odata_expand': 'PurchaseReceiptGIDetails',
            'default_is_default': True,
        }</field>
    </record>
</odoo>
