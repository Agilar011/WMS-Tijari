<odoo>
    <record id="view_acumatica_inventory_stock_config_search" model="ir.ui.view">
        <field name="name">acumatica.inventory.stock.config.search</field>
        <field name="model">acumatica.inventory.stock.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="base_url"/>
                <field name="endpoint_name"/>
                <field name="active"/>
            </search>
        </field>
    </record>

    <record id="view_acumatica_inventory_stock_config_form" model="ir.ui.view">
        <field name="name">acumatica.inventory.stock.config.form</field>
        <field name="model">acumatica.inventory.stock.config</field>
        <field name="arch" type="xml">
            <form string="API Configuration Inventory Stock">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Connection">
                            <field name="name"/>
                            <field name="base_url"/>
                            <field name="api_version"/>
                            <field name="endpoint_name"/>
                        </group>
                        <group string="Credentials">
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="company_code"/>
                            <field name="active"/>
                            <field name="last_sync" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Request Params">
                            <field name="odata_expand"/>
                            <field name="odata_top"/>
                            <field name="request_warehouse_value"/>
                            <field name="request_inventory_id_value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_acumatica_inventory_stock_config_list" model="ir.ui.view">
        <field name="name">acumatica.inventory.stock.config.list</field>
        <field name="model">acumatica.inventory.stock.config</field>
        <field name="arch" type="xml">
            <list string="Konfigurasi Acumatica Inventory Stock">
                <field name="name"/>
                <field name="base_url"/>
                <field name="endpoint_name"/>
                <field name="odata_expand"/>
                <field name="odata_top"/>
                <field name="last_sync"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'draft'"/>
                <button name="action_test_connection" string="Test" type="object" icon="fa-plug"/>
            </list>
        </field>
    </record>

    <record id="action_acumatica_inventory_stock_config" model="ir.actions.act_window">
        <field name="name">API Configuration Inventory Stock</field>
        <field name="res_model">acumatica.inventory.stock.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
