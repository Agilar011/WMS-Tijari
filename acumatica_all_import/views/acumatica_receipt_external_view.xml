<odoo>

    <record id="action_import_selected_inventory_recieved"
            model="ir.actions.server">
        <field name="name">Generate Data</field>
        <field name="model_id" ref="model_acumatica_receipt_external_line"/>
        <field name="binding_model_id" ref="model_acumatica_receipt_external_line"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            records.action_import_selected()
        </field>
    </record>

    <record id="view_acumatica_receipt_external_line_list" model="ir.ui.view">
        <field name="name">acumatica.receipt.external.line.list</field>
        <field name="model">acumatica.receipt.external.line</field>
        <field name="arch" type="xml">
            <list string="Data Inventory External">
                <field name="reference_nbr"/>
                <field name="document_only"/>
                <field name="customer_code"/>
                <field name="warehouse_code"/>
                <field name="total_qty"/>
                <field name="status"/>
                <field name="import_state" widget="badge"
                       decoration-success="import_state in ('imported','updated')"
                       decoration-warning="import_state == 'pending'"
                       decoration-danger="import_state == 'error'"/>
                <field name="import_message"/>
                <button name="action_import_this" string="Import" type="object" icon="fa-upload"/>
                <button name="action_open_picking" string="Open Receipt" type="object" icon="fa-external-link" invisible="not odoo_picking_id"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_receipt_external_line_form" model="ir.ui.view">
        <field name="name">acumatica.receipt.external.line.form</field>
        <field name="model">acumatica.receipt.external.line</field>
        <field name="arch" type="xml">
            <form string="Data Inventory External">
                <header>
                    <button name="action_import_this" type="object" string="Import This" class="btn-primary" invisible="import_state not in ['pending', 'error']"/>
                    <button name="action_open_picking" type="object" string="Open Picking"/>
                    <field name="import_state" widget="statusbar" statusbar_visible="pending,imported,updated,error"/>
                </header>
                <sheet>
                    <group string="Header">
                        <group>
                            <field name="reference_nbr"/>
                            <field name="picking_type_id"/>
                            <field name="scheduled_date"/>
                            <field name="description"/>
                            <field name="actual_qty"/>
                            <field name="acumatica_write_date"/>
                            <field name="post_period"/>
                            <field name="status"/>
                            <field name="total_qty"/>
                            <field name="warehouse_code"/>
                        </group>
                        <group>
                            <field name="branch_warehouse"/>
                            <field name="transfer_type"/>
                            <field name="note"/>
                            <field name="customer_code"/>
                            <field name="shipment_nbr"/>
                            <field name="transfer_nbr"/>
                            <field name="location_code"/>
                            <field name="change_item_ref_nbr"/>                        
                        </group>
                    </group>
                    <notebook>
                        <page name="Details" string="Details">
                            <field name="product_line_ids">
                                <list>
                                    <field name="inventory_id"/>
                                    <field name="line_description"/>
                                    <field name="warehouse_dest_code"/>
                                    <field name="product_uom_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="import_message" readonly="1" widget="text"/>
                        <field name="odoo_picking_id" readonly="1"/>
                        <field name="exists_in_odoo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_receipt_external_line" model="ir.actions.act_window">
        <field name="name">Data Inventory External</field>
        <field name="res_model">acumatica.receipt.external.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
