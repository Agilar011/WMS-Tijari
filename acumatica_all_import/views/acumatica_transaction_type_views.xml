<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acumatica_transaction_type_list" model="ir.ui.view">
        <field name="name">acumatica.transaction.type.list</field>
        <field name="model">acumatica.transaction.type</field>
        <field name="arch" type="xml">
            <list string="Acumatica Transaction Types">
                <field name="name"/>
                <field name="code"/>
                <field name="config_id"/>
                <field name="picking_type_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_acumatica_transaction_type_form" model="ir.ui.view">
        <field name="name">acumatica.transaction.type.form</field>
        <field name="model">acumatica.transaction.type</field>
        <field name="arch" type="xml">
            <form string="Acumatica Transaction Type">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="config_type"/>
                            <field name="endpoint_name"/>
                        </group>
                        <group>
                            <field name="source_field"/>
                            <field name="trans_type"/>
                            <field name="last_sync"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acumatica_transaction_type" model="ir.actions.act_window">
        <field name="name">Transaction Types</field>
        <field name="res_model">acumatica.transaction.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
