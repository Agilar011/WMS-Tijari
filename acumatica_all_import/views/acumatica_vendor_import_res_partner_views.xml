<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_acumatica_vendor" model="ir.ui.view">
        <field name="name">res.partner.form.acumatica.vendor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Acumatica">
                    <group>
                        <group string="Identitas">
                            <field name="adt_external_id"/>
                            <field name="adt_class"/>
                            <field name="adt_vendor_state"/>
                        </group>
                        <group string="Logistik">
                            <field name="adt_fob_point"/>
                            <field name="adt_last_modified_datetime"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
