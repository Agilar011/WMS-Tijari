<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_acumatica_warehouse_config_form" model="ir.ui.view">
        <field name="name">acumatica.warehouse.config.form</field>
        <field name="model">acumatica.warehouse.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Acumatica - Warehouse Import">
                <header>
                    <button name="action_test_connection" string="🔌 Test Koneksi"
                            type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nama Konfigurasi..."/></h1>
                    </div>
                    <group>
                        <group string="🌐 Koneksi Server">
                            <field name="base_url" placeholder="http://your-server/acumportal/entity"/>
                            <field name="api_version"/>
                        </group>
                        <group string="🔑 Kredensial">
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="company_code"/>
                        </group>
                    </group>
                    <group>
                        <group string="📊 Info Sync">
                            <field name="last_sync" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_acumatica_warehouse_config_list" model="ir.ui.view">
        <field name="name">acumatica.warehouse.config.list</field>
        <field name="model">acumatica.warehouse.config</field>
        <field name="arch" type="xml">
            <list string="Konfigurasi Acumatica Warehouse">
                <field name="name"/>
                <field name="base_url"/>
                <field name="username"/>
                <field name="company_code"/>
                <field name="last_sync"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'draft'"/>
                <button name="action_test_connection" string="Test"
                        type="object" icon="fa-plug"/>
            </list>
        </field>
    </record>

    <record id="action_acumatica_warehouse_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi Acumatica Warehouse</field>
        <field name="res_model">acumatica.warehouse.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
