<odoo>
    <record id="view_import_shipment_wizard_form" model="ir.ui.view">
        <field name="name">import.shipment.wizard.form</field>
        <field name="model">import.shipment.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Shipment Receipt dari Acumatica">
                <sheet>
                    <div invisible="state != 'draft'">
                        <div class="alert alert-info" role="alert">
                            <strong>Langkah 1:</strong>
                            Pilih konfigurasi API, isi filter kalau perlu, lalu klik
                            <b>Tarik Data dari Acumatica</b>.
                        </div>
                        <group string="Pengaturan">
                            <group>
                                <field name="config_id"/>
                                <field name="fetch_limit"/>
                                <field name="receipt_nbr"/>
                            </group>
                            <group>
                                <field name="last_modified_from"/>
                                <field name="odata_filter"/>
                            </group>
                        </group>
                        <group string="Default URL">
                            <group>
                                <div class="o_form_label">
                                    Default request:
                                </div>
                                <div>
                                    <span class="text-muted">
                                        Shipment?$filter=Type eq 'Shipment' and Operation eq 'Receipt'&amp;$expand=Details
                                    </span>
                                </div>
                            </group>
                        </group>
                    </div>

                    <div invisible="state == 'draft'">
                        <div class="alert alert-success" role="alert" invisible="state != 'fetched'">
                            <strong>Data Berhasil Ditarik.</strong>
                            Klik <b>Import Sekarang</b> untuk import semua,
                            atau <b>Lihat Data</b> untuk seleksi manual.
                        </div>
                        <group>
                            <group string="Ringkasan Data">
                                <field name="total_fetched" readonly="1"/>
                                <field name="total_new" readonly="1"/>
                                <field name="total_existing" readonly="1"/>
                            </group>
                            <group string="Konfigurasi">
                                <field name="config_id" readonly="1"/>
                                <field name="fetch_limit" readonly="1"/>
                                <field name="receipt_nbr" readonly="1"/>
                            </group>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_fetch_data" string="Tarik Data dari Acumatica" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_import_all_pending" string="Import Sekarang (Semua)" type="object" class="btn-primary" invisible="state != 'fetched'"/>
                    <button name="action_view_staging" string="Lihat Data" type="object" class="btn-secondary" invisible="state != 'fetched'"/>
                    <button string="Tutup" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_shipment_wizard" model="ir.actions.act_window">
        <field name="name">Import Shipment Receipt</field>
        <field name="res_model">import.shipment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
