<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_tijari_auth" model="ir.module.category">
        <field name="name">Tijari Authentication</field>
        <field name="sequence">100</field>
    </record>


    <record id="group_guest" model="res.groups">
        <field name="name">Guest</field>

        <field name="category_id"
               ref="tijari_auth_oauth.module_category_tijari_auth"/>

        <!-- Guest tetap merupakan Internal User -->
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>

    </record>

</odoo>