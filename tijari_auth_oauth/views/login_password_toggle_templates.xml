<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_password_toggle" inherit_id="web.login" name="Login Password Toggle">
        <xpath expr="//input[@id='password' and @name='password']" position="replace">
            <div class="input-group">
                <input type="password"
                       placeholder="Password"
                       name="password"
                       id="password"
                       class="form-control"
                       required="required"
                       autocomplete="current-password"
                       t-att-autofocus="'autofocus' if login else None"
                       maxlength="4096"/>
                <button type="button"
                        class="btn btn-outline-secondary o_tijari_toggle_password"
                        aria-label="Show password"
                        aria-pressed="false"
                        data-password-target="password">
                    <i class="fa fa-eye" aria-hidden="true"/>
                </button>
            </div>
        </xpath>
    </template>
</odoo>
