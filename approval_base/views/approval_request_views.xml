<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="approval_request_view_list" model="ir.ui.view">
        <field name="name">approval.request.list</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" create="0" edit="0" delete="0" import="0"
                  default_order="id desc">
                <field name="name"/>
                <field name="reference"/>
                <field name="approval_type_id"/>
                <field name="source_model" optional="hide"/>
                <field name="current_user_id" string="Current Approver"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'waiting'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_source_document" type="object"
                                class="oe_stat_button" icon="fa-external-link"
                                invisible="not source_model or not source_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Open Source Document</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="approval_type_id"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"
                                   decoration-muted="state == 'waiting'"
                                   decoration-success="state == 'approved'"
                                   decoration-danger="state in ('rejected', 'cancelled')"/>
                            <field name="current_user_id" string="Current Approver"/>
                            <field name="source_model" invisible="1"/>
                            <field name="source_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Steps">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="role"/>
                                    <field name="job_id"/>
                                    <field name="user_id"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'waiting'"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state in ('rejected', 'cancelled')"/>
                                    <field name="action_date"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="approval_request_view_list"/>
    </record>
</odoo>
