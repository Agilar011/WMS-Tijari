<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="approval_type_view_tree" model="ir.ui.view">
        <field name="name">approval.type.tree</field>
        <field name="model">approval.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>


    <record id="approval_type_view_form" model="ir.ui.view">
        <field name="name">approval.type.form</field>
        <field name="model">approval.type</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="code" />
                        <field name="approval_model_id"/>
                        <field name="is_amount_based" />
                        

                    </group>

                    <notebook>

                        <page string="Approval Configuration">

                            <field name="line_ids" invisible='is_amount_based'>
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="user_id"/>
                                    <field name="job_id"/>
                                    <field name="name" />
                                </list>
                            </field>
                            <field name="range_ids" invisible='not is_amount_based'>
                                <list>
                                    <field name="name"/>
                                    <field name="min_amount"/>
                                    <field name="max_amount"/>
                                    <field name="approver_count" string="Approvers"/>
                                </list>

                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                        </group>
                                        <group col="2">
                                            <field name="min_amount"/>
                                            <field name="max_amount"/>
                                        </group>
                                        <separator string="Approval Lines"/>
                                        <field name="line_ids">
                                            <list editable="bottom">
                                                <field name="sequence"/>
                                                <field name="user_id"/>
                                                <field name="name" string= 'Role'/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <record id="action_approval_type" model="ir.actions.act_window">
        <field name="name">Approval Types</field>
        <field name="res_model">approval.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>